{%- comment -%}
  Reset password (from the recovery email link). Password + confirmation.
{%- endcomment -%}
{%- liquid
  assign spacing_class = ''
  case section.settings.spacing
    when 'tight'
      assign spacing_class = ' section--tight'
    when 'none'
      assign spacing_class = ' section--none'
  endcase
-%}
<div class="section{{ spacing_class }} color-{{ section.settings.color_scheme }} main-reset-password" id="section-{{ section.id }}">
  <div class="page-width page-width--medium">
    <div class="customer-auth reset-password">
      <header class="customer-auth__head">
        <h1 class="h1">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="muted text-pretty">{{ 'customer.reset_password.subtext' | t }}</p>
      </header>

      {%- form 'reset_customer_password', class: 'customer-form' -%}
        {%- render 'customer-form-errors', form: form, prefix: 'ResetForm' -%}
        <div class="field">
          <label class="field__label" for="ResetForm-password">{{ 'customer.reset_password.password' | t }}</label>
          <input
            class="field__input"
            type="password"
            id="ResetForm-password"
            name="customer[password]"
            autocomplete="new-password"
            required
            {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
          >
        </div>
        <div class="field">
          <label class="field__label" for="ResetForm-password_confirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input
            class="field__input"
            type="password"
            id="ResetForm-password_confirmation"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
            {% if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}
          >
        </div>
        <div class="customer-form__actions">
          <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
