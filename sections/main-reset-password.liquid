<section class="section" {{ section.shopify_attributes }}>
  <div class="container auth">
    <h1 class="h2">Reset password</h1>
    <p class="muted center">Enter a new password for your account.</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">Password</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPasswordConfirm">Confirm password</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary btn--large">Reset password</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
