{%- comment -%}
  Collection banner (Apple Store category header): a big centred title and a
  short muted description, then the merchant's own collection image, then
  the products (APPLE-SPEC §5).
  The collection image is on by default and never cropped (APPLE-SPEC §0.3):
  the box takes the image's own aspect ratio, a height cap keeps tall art
  from pushing the grid far down, and anything the cap trims is letterboxed
  on the white photo ground (media--contain) instead of cut off.
  The title is above the fold and must be readable the instant the page
  paints, so nothing in this section carries data-reveal.
  Centred paragraphs stay within about three lines (APPLE-SPEC §6): about
  120 characters on a phone, 210 at the desktop reading measure. Longer
  descriptions start-align the header (--medium: phones only, --long: always).
{%- endcomment -%}
{%- liquid
  assign show_image = false
  if section.settings.show_image and collection.image != blank
    assign show_image = true
    assign image_alt = collection.image.alt | default: collection.title
  endif

  assign show_description = false
  assign length_class = ''
  if section.settings.show_description and collection.description != blank
    assign show_description = true
    assign description_length = collection.description | strip_html | strip | size
    if description_length > 210
      assign length_class = ' collection-banner--long'
    elsif description_length > 120
      assign length_class = ' collection-banner--medium'
    endif
  endif

  assign spacing_class = ''
  case section.settings.spacing
    when 'tight'
      assign spacing_class = ' section--tight'
    when 'none'
      assign spacing_class = ' section--none'
  endcase
-%}
<div class="section{{ spacing_class }} color-{{ section.settings.color_scheme }} collection-banner{{ length_class }}{% if show_image %} collection-banner--has-image{% endif %}" id="section-{{ section.id }}">
  <div class="page-width">
    <header class="collection-banner__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow collection-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="h1 collection-banner__title">{{ collection.title | escape }}</h1>
      {%- if show_description -%}
        <div class="lead lead--muted collection-banner__description">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if show_image -%}
      <div class="media media--contain collection-banner__media" style="--ratio: {{ collection.image.aspect_ratio }};">
        {%- render 'image', image: collection.image, sizes: '(min-width: 1248px) 1200px, calc(100vw - 40px)', widths: '600, 900, 1200, 1600, 2000, 2400', loading: 'eager', fetchpriority: 'high', class: 'collection-banner__img', alt: image_alt -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional short label above the title, e.g. “Mount of Olives”."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "info": "Shows the collection's own image under the title, uncropped, when the collection has one.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "tight"
    }
  ]
}
{% endschema %}
