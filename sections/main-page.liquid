{%- comment -%}
  Page template body. An optional centred .h1 (the page title) sits in a
  medium-width header; page.content follows in .rte--article (19px / 1.58
  at ≥750px, like Apple Newsroom) at the reading measure (--text-max) or
  the medium width (--content-max). When a custom template places a Page
  hero above this section, turn "Show page title" off so the page keeps a
  single h1. No dividers, nothing moves; the reader is here for the text.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  assign width_class = ' page-width--narrow'
  if section.settings.width == 'medium'
    assign width_class = ' page-width--medium'
  endif
-%}
<div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} main-page main-page--{{ section.settings.width }}" id="section-{{ section.id }}">
  {%- if section.settings.show_title -%}
    <header class="page-width page-width--medium main-page__header">
      <h1 class="h1 main-page__title enter">{{ page.title | escape }}</h1>
    </header>
  {%- endif -%}

  <div class="page-width{{ width_class }}">
    {%- if page.content != blank -%}
      <div class="rte rte--article main-page__content">
        {{ page.content }}
      </div>
    {%- elsif request.design_mode -%}
      <div class="empty-state main-page__empty">
        {%- render 'icon', name: 'info', size: 36 -%}
        <p class="muted text-pretty">{{ 'sections.main_page.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "info": "Turn off when a Page hero section sits above this one, so the page keeps one main heading.",
      "default": true
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow (reading measure)" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "narrow"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
