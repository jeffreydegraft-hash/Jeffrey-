{%- comment -%}
  Account overview, Apple style: a centred greeting ("Hi, Aleksandra.")
  and one-line lead, then flat tiles. The Orders tile spans the grid: a
  real table (sentence-case 12px headers) whose rows are whole-row links
  (order number, date, one status pill, total); below 750px each row folds
  into a two-line card. Addresses and Account details sit side by side
  from 750px.

  The status pill shows the one status a customer acts on: cancelled, then
  a payment state that needs attention (pending, refunded, voided...), and
  otherwise the fulfillment status. The order page shows both in full.
{%- endcomment -%}
{%- liquid
  assign spacing_class = ''
  case section.settings.spacing
    when 'tight'
      assign spacing_class = ' section--tight'
    when 'none'
      assign spacing_class = ' section--none'
  endcase
  assign first_name = customer.first_name | escape
-%}
<div class="section{{ spacing_class }} color-{{ section.settings.color_scheme }} main-account account" id="section-{{ section.id }}">
  <div class="page-width page-width--medium">
    <header class="customer-hero">
      <h1 class="h1 customer-hero__title">
        {%- if first_name != blank -%}
          {{ 'customer.account.greeting' | t: name: first_name }}
        {%- else -%}
          {{ 'customer.account.greeting_fallback' | t }}
        {%- endif -%}
      </h1>
      <p class="lead lead--muted customer-hero__lead">{{ 'customer.account.lead' | t }}</p>
    </header>

    <div class="account__grid">
      <section class="tile account__tile account__orders" aria-labelledby="AccountOrders">
        <div class="account__tile-head">
          <h2 class="h4" id="AccountOrders" tabindex="-1">{{ 'customer.orders.heading' | t }}</h2>
          {%- if customer.orders_count > 0 -%}
            <p class="account__tile-meta">{{ 'customer.orders.count' | t: count: customer.orders_count }}</p>
          {%- endif -%}
        </div>

        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="orders-table" role="table">
              <caption class="visually-hidden">{{ 'customer.orders.title' | t }}</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader" class="orders-table__order">{{ 'customer.orders.order_number' | t }}</th>
                  <th scope="col" role="columnheader" class="orders-table__date">{{ 'customer.orders.date' | t }}</th>
                  <th scope="col" role="columnheader" class="orders-table__status">{{ 'customer.orders.status' | t }}</th>
                  <th scope="col" role="columnheader" class="orders-table__total">{{ 'customer.orders.total' | t }}</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {%- for order in customer.orders -%}
                  {%- liquid
                    assign status_label = order.fulfillment_status_label
                    assign status_tone = 'neutral'
                    if order.fulfillment_status == 'fulfilled'
                      assign status_tone = 'positive'
                    endif
                    case order.financial_status
                      when 'pending', 'authorized', 'partially_paid', 'partially_refunded'
                        assign status_label = order.financial_status_label
                        assign status_tone = 'neutral'
                      when 'refunded', 'voided', 'expired'
                        assign status_label = order.financial_status_label
                        assign status_tone = 'muted'
                    endcase
                    if order.cancelled
                      assign status_label = 'customer.orders.cancelled' | t
                      assign status_tone = 'muted'
                    endif
                  -%}
                  <tr role="row" class="orders-table__row">
                    <th scope="row" role="rowheader" class="orders-table__order">
                      <a href="{{ order.customer_url }}" class="orders-table__link" aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}">{{ order.name }}</a>
                    </th>
                    <td role="cell" class="orders-table__date">
                      <time datetime="{{ order.created_at | date: '%Y-%m-%d' }}">{{ order.created_at | date: '%B %-d, %Y' }}</time>
                    </td>
                    <td role="cell" class="orders-table__status">
                      <span class="customer-status customer-status--{{ status_tone }}">{{ status_label }}</span>
                    </td>
                    <td role="cell" class="orders-table__total tnum">
                      <span class="orders-table__amount">{{ order.total_price | money }}</span>
                      {%- render 'icon', name: 'chevron-right', size: 14, class: 'orders-table__chevron' -%}
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {%- render 'pagination', paginate: paginate, anchor: '#AccountOrders' -%}
          {%- else -%}
            <div class="customer-empty">
              {%- render 'icon', name: 'bag', size: 32 -%}
              <h3 class="h5">{{ 'customer.orders.none' | t }}</h3>
              <p class="customer-empty__text">{{ 'customer.orders.none_body' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'customer.orders.shop_cta' | t }}</a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </section>

      <section class="tile account__tile account__addresses" aria-labelledby="AccountAddresses">
        <div class="account__tile-head">
          <h2 class="h4" id="AccountAddresses">{{ 'customer.addresses.title' | t }}</h2>
          {%- if customer.addresses_count > 0 -%}
            <p class="account__tile-meta">{{ 'customer.addresses.count' | t: count: customer.addresses_count }}</p>
          {%- endif -%}
        </div>
        <div class="account__tile-body">
          {%- if customer.default_address != blank -%}
            <h3 class="customer-label">{{ 'customer.account.default_address' | t }}</h3>
            <address class="customer-address">{{ customer.default_address | format_address }}</address>
          {%- else -%}
            <p class="customer-muted">{{ 'customer.account.no_address' | t }}</p>
          {%- endif -%}
        </div>
        {%- if customer.default_address != blank -%}
          <a href="{{ routes.account_addresses_url }}" class="link link--chevron account__tile-link">
            {{- 'customer.account.view_addresses' | t -}}
            {%- render 'icon', name: 'chevron-right', size: 11 -%}
          </a>
        {%- else -%}
          <a href="{{ routes.account_addresses_url }}#AddAddress" class="link link--chevron account__tile-link">
            {{- 'customer.addresses.add_new' | t -}}
            {%- render 'icon', name: 'chevron-right', size: 11 -%}
          </a>
        {%- endif -%}
      </section>

      <section class="tile account__tile account__details" aria-labelledby="AccountDetails">
        <div class="account__tile-head">
          <h2 class="h4" id="AccountDetails">{{ 'customer.account.details' | t }}</h2>
        </div>
        <div class="account__tile-body">
          {%- if customer.name != blank -%}
            <p class="account__name">{{ customer.name | escape }}</p>
          {%- endif -%}
          <p class="account__email">{{ customer.email | escape }}</p>
        </div>
        <a href="{{ routes.account_logout_url }}" class="link link--chevron account__tile-link">
          {{- 'customer.account.sign_out' | t -}}
          {%- render 'icon', name: 'chevron-right', size: 11 -%}
        </a>
      </section>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
