{%- comment -%}
  Hero: the first screen of the homepage.

  Three layouts:
  - centered (default, apple.com product hero): centred eyebrow, h0 headline,
    one-line lead, CTA pair (filled pill + "Learn more ›" link), then a large
    centred product image below.
  - split: text left, a rounded 4:5 media tile right. A product shot (the
    default image style, or the product fallback) sits whole inside it on
    white; a photo or video fills the tile.
  - full-bleed: media as the background with text placed over it.

  Media, in order: the hero image (or video), else the chosen product's own
  photo. Product shots are shown whole (contain) on the white ground they were
  shot on, never blended, filtered or cropped (APPLE-SPEC §0). With no media
  at all the hero is text-only on the storefront; split and full-bleed fall
  back to centered. The theme editor shows Shopify's neutral placeholder so
  the merchant can see where media goes. Nothing is drawn in its place.

  Motion (all CSS, no JS, named purposes):
  - Text staggers in with .enter + --i (@starting-style, base.css): marketing
    entrance; the heading is readable the instant the page paints.
  - The product image rises 24px while it fades in, one beat after the text:
    "the product arrives". Full-bleed media fades only.
  - prefers-reduced-motion: fades only; the video is hidden and its poster
    (or the image) shows instead.
  Nothing here carries data-reveal.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'centered'
  assign height = section.settings.height | default: 'auto'
  assign text_position = section.settings.text_position | default: 'left'
  assign image_style = section.settings.image_style | default: 'product'
  assign video = section.settings.video
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign hero_product = section.settings.product
  assign image_alt = ''

  if image == blank and video != blank
    assign image = video.preview_image
  endif

  comment
    No hero image: use the merchant's own product photo, shown whole on white.
  endcomment
  if image == blank and video == blank and hero_product != blank and hero_product.featured_media != blank
    assign image = hero_product.featured_media.preview_image
    assign image_style = 'product'
    assign image_alt = hero_product.featured_media.alt | default: hero_product.title
  endif

  assign has_media = false
  if image != blank or video != blank
    assign has_media = true
  endif

  assign show_placeholder = false
  if has_media == false and request.design_mode
    assign show_placeholder = true
  endif

  comment
    Split and full-bleed need media. Without it the section reads best as the
    centered hero: text-only on the storefront, a placeholder in the editor.
  endcomment
  if has_media == false
    if layout == 'full-bleed' or show_placeholder == false
      assign layout = 'centered'
    endif
  endif

  assign overlay = section.settings.overlay_opacity | divided_by: 100.0

  case layout
    when 'full-bleed'
      assign image_sizes = '100vw'
      assign image_widths = '750, 1000, 1500, 2000'
    when 'split'
      assign image_sizes = '(min-width: 990px) 46vw, 100vw'
      assign image_widths = '400, 600, 800, 1200, 1600'
    else
      assign image_sizes = '(min-width: 1100px) 980px, 100vw'
      assign image_widths = '480, 750, 980, 1300, 1600, 1960'
  endcase

  assign show_button_1 = false
  if section.settings.button_label_1 != blank and section.settings.button_link_1 != blank
    assign show_button_1 = true
  endif
  assign show_button_2 = false
  if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank
    assign show_button_2 = true
  endif

  assign cta_class = 'cta-row'
  if layout == 'split'
    assign cta_class = 'cta-row cta-row--start'
  elsif layout == 'full-bleed' and text_position != 'center'
    assign cta_class = 'cta-row cta-row--start'
  endif
-%}

{%- capture hero_image -%}
  {%- if image != blank -%}
    {%- if image_mobile != blank -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ image_mobile | image_url: width: 480 }} 480w, {{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1000 }} 1000w, {{ image_mobile | image_url: width: 1500 }} 1500w"
          sizes="100vw"
        >
        {%- render 'image', image: image, alt: image_alt, sizes: image_sizes, widths: image_widths, loading: 'eager', fetchpriority: 'high', class: 'hero__img' -%}
      </picture>
    {%- else -%}
      {%- render 'image', image: image, alt: image_alt, sizes: image_sizes, widths: image_widths, loading: 'eager', fetchpriority: 'high', class: 'hero__img', preload: true -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture hero_video -%}
  {%- if video != blank -%}
    <div class="hero__video" aria-hidden="true">
      {{ video | video_tag: image_size: '1500x', autoplay: true, loop: true, muted: true, controls: false }}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture hero_content -%}
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow eyebrow--lg hero__eyebrow enter" style="--i: 0;">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h1 class="h0 hero__heading enter" style="--i: 1;">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    {%- liquid
      comment
        Apple keeps hero leads to a line or two. A longer one steps down to the
        21px intro size so it still sets in three lines or fewer. A word
        joiner after each hyphen keeps words like "olive-derived" whole.
      endcomment
      assign sub_class = 'lead hero__subheading enter'
      if section.settings.subheading.size > 100
        assign sub_class = sub_class | append: ' hero__subheading--long'
      endif
    -%}
    <p class="{{ sub_class }}" style="--i: 2;">{{ section.settings.subheading | escape | replace: '-', '-&#8288;' }}</p>
  {%- endif -%}
  {%- if show_button_1 or show_button_2 -%}
    <div class="{{ cta_class }} hero__actions enter" style="--i: 3;">
      {%- if show_button_1 -%}
        <a href="{{ section.settings.button_link_1 }}" class="btn btn--primary btn--lg hero__button">{{ section.settings.button_label_1 | escape }}</a>
      {%- endif -%}
      {%- if show_button_2 -%}
        <a href="{{ section.settings.button_link_2 }}" class="link link--chevron link--lg hero__link">
          {{- section.settings.button_label_2 | escape -}}
          {%- render 'icon', name: 'chevron-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- case layout -%}
  {%- when 'full-bleed' -%}
    <div
      class="section section--none color-{{ section.settings.color_scheme }} hero hero--full hero--{{ height }} hero--text-{{ text_position }}"
      id="section-{{ section.id }}"
      style="--hero-overlay: {{ overlay }};"
    >
      <div class="hero__bg">
        {{ hero_image }}
        {{ hero_video }}
      </div>
      <div class="hero__overlay color-scheme-3">
        <div class="hero__scrim" aria-hidden="true"></div>
        <div class="page-width hero__inner">
          <div class="hero__content">
            {{ hero_content }}
          </div>
        </div>
      </div>
    </div>

  {%- when 'split' -%}
    <div
      class="section section--none color-{{ section.settings.color_scheme }} hero hero--split hero--{{ height }}"
      id="section-{{ section.id }}"
    >
      <div class="page-width hero__inner">
        <div class="hero__content">
          {{ hero_content }}
        </div>
        <div class="hero__media media{% if has_media and video == blank and image_style == 'product' %} hero__media--product{% endif %}" style="--ratio: 4 / 5;">
          {%- if has_media -%}
            {{ hero_image }}
            {{ hero_video }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg hero__placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>

  {%- else -%}
    <div
      class="section section--none color-{{ section.settings.color_scheme }} hero hero--centered hero--{{ height }}{% unless has_media or show_placeholder %} hero--text-only{% endunless %}"
      id="section-{{ section.id }}"
    >
      <div class="page-width hero__inner">
        <div class="hero__content">
          {{ hero_content }}
        </div>
        {%- if video != blank -%}
          <div class="hero__stage hero__stage--video media" style="--ratio: 16 / 9;">
            {{ hero_image }}
            {{ hero_video }}
          </div>
        {%- elsif image != blank -%}
          <div class="hero__stage hero__stage--{{ image_style }}">
            {{ hero_image }}
          </div>
        {%- elsif show_placeholder -%}
          <div class="hero__stage hero__stage--placeholder media" style="--ratio: 16 / 9;">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg hero__placeholder' }}
          </div>
        {%- endif -%}
      </div>
    </div>
{%- endcase -%}

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Mount of Olives"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italicise a word to set it in the accent colour.",
      "default": "Anointing oils for <em>prayer</em> and skin."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "One short sentence reads best.",
      "default": "Nine biblical blends on one olive base."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button label",
      "default": "Shop the oils"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Link label",
      "info": "Shown as a text link with a chevron, next to the button.",
      "default": "Learn about the science"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Centered: a product shot on white, shown whole below the text. Split: product shots are shown whole; photos fill a portrait (4:5) tile. Full-bleed: landscape."
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "info": "Centered and split layouts. Product shot: shown whole on white. Photo: centered shows it whole with rounded corners; split fills the 4:5 tile.",
      "options": [
        { "value": "product", "label": "Product shot on white" },
        { "value": "photo", "label": "Photo (rounded corners)" }
      ],
      "default": "product"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown below 750px instead of the image above."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Used when no image or video is chosen: the hero shows this product's own photo. With neither, the hero is text only."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. Plays muted and looped; its poster shows for visitors who prefer reduced motion."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centered (text above media)" },
        { "value": "split", "label": "Split (text and media side by side)" },
        { "value": "full-bleed", "label": "Full-bleed (text over media)" }
      ],
      "default": "centered"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "auto", "label": "Standard" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "info": "Full-bleed layout only.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "Full-bleed layout only. Darkens the media so the text stays legible.",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
