{%- liquid
  assign layout = section.settings.layout
  assign image = section.settings.image
  assign image_alt = image.alt | default: shop.name
-%}
<section class="hero hero--{{ layout }}" style="--hero-min-h: {{ section.settings.min_height }}vh;" {{ section.shopify_attributes }}>
  {%- if layout == 'overlay' and image != blank -%}
    <div class="hero__bg">{{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800,1200,1600,2400', alt: image_alt }}</div>
  {%- endif -%}
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__ctas">
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--primary btn--large" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn {% if layout == 'overlay' %}btn--ghost{% else %}btn--secondary{% endif %} btn--large" href="{{ section.settings.cta2_link | default: '#purpose' }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.show_proof -%}
        <div class="hero__proof">
          <div class="avatars" aria-hidden="true"><span>JM</span><span>RA</span><span>TK</span><span>+</span></div>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span>{{ section.settings.proof_text }}</span>
        </div>
      {%- endif -%}
    </div>
    {%- if layout == 'split' -%}
      <div class="hero__media">
        {%- if image != blank -%}
          {{ image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600,900,1200,1400', alt: image_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
        {%- if section.settings.card_title != blank -%}
          <div class="hero__media-card"><strong>{{ section.settings.card_title }}</strong>{{ section.settings.card_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "split", "label": "Split (text + image)" }, { "value": "overlay", "label": "Full-bleed image" } ], "default": "split" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait image works best for the split layout (4:5)." },
    { "type": "range", "id": "min_height", "min": 40, "max": 100, "step": 5, "unit": "vh", "label": "Minimum height", "default": 72 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Biblical anointing oils" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Thou anointest my head with oil; <em>my cup runneth over.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Scripture-inspired anointing oils, hand-blended in small batches for prayer, worship, healing and consecration. Rooted in Psalm 23. Made for your daily walk.</p>" },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Shop anointing oils" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Find your oil" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" },
    { "type": "checkbox", "id": "show_proof", "label": "Show social proof line", "default": true },
    { "type": "text", "id": "proof_text", "label": "Social proof text", "default": "Loved by thousands of believers" },
    { "type": "text", "id": "card_title", "label": "Floating card title", "default": "Psalm 23:5" },
    { "type": "text", "id": "card_text", "label": "Floating card text", "default": "Every bottle is prayed over before it ships." }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
