{%- comment -%}
  Hero: the first screen of the homepage.

  Three layouts:
  - centered (default, apple.com product hero): centred eyebrow, h0 headline,
    one-line lead, CTA pair (filled pill + "Learn more ›" link), then a large
    centred product image below. Without an image an olive-oil bottle is
    drawn in theme tokens, never an ornament.
  - split: text left, a rounded 4:5 media tile right.
  - full-bleed: media as the background with text placed over it; with no
    media to show it falls back to the centered layout.

  Motion (all CSS, no JS, named purposes):
  - Text staggers in with .enter + --i (@starting-style, base.css): marketing
    entrance; the heading is readable the instant the page paints.
  - The product image rises 24px while it fades in, one beat after the text:
    "the product arrives". Full-bleed media fades only.
  - prefers-reduced-motion: fades only; the video is hidden and its poster
    (or the image) shows instead.
  Nothing here carries data-reveal.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'centered'
  assign height = section.settings.height | default: 'auto'
  assign text_position = section.settings.text_position | default: 'left'
  assign image_style = section.settings.image_style | default: 'product'
  assign video = section.settings.video
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile

  if image == blank and video != blank
    assign image = video.preview_image
  endif

  assign has_media = false
  if image != blank or video != blank
    assign has_media = true
  endif

  comment
    Full-bleed needs media to sit behind the text. Without it the section
    reads best as the centered product hero, with the bottle drawn below.
  endcomment
  if layout == 'full-bleed' and has_media == false
    assign layout = 'centered'
  endif

  assign overlay = section.settings.overlay_opacity | divided_by: 100.0

  case layout
    when 'full-bleed'
      assign image_sizes = '100vw'
      assign image_widths = '750, 1000, 1500, 2000'
    when 'split'
      assign image_sizes = '(min-width: 990px) 46vw, 100vw'
      assign image_widths = '400, 600, 800, 1200, 1600'
    else
      assign image_sizes = '(min-width: 1100px) 980px, 100vw'
      assign image_widths = '480, 750, 980, 1300, 1600, 1960'
  endcase

  assign show_button_1 = false
  if section.settings.button_label_1 != blank and section.settings.button_link_1 != blank
    assign show_button_1 = true
  endif
  assign show_button_2 = false
  if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank
    assign show_button_2 = true
  endif

  assign cta_class = 'cta-row'
  if layout == 'split'
    assign cta_class = 'cta-row cta-row--start'
  elsif layout == 'full-bleed' and text_position != 'center'
    assign cta_class = 'cta-row cta-row--start'
  endif
-%}

{%- comment -%}
  Bottle illustration: a calm, product-like olive-oil bottle drawn only with
  theme tokens (classes in section-home-a.css), so it follows every scheme.
{%- endcomment -%}
{%- capture hero_bottle -%}
  <svg class="bottle hero__bottle" viewBox="0 0 240 560" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="BottleGlass-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
        <stop class="bottle__stop bottle__stop--glass-edge" offset="0"/>
        <stop class="bottle__stop bottle__stop--glass-mid" offset="0.32"/>
        <stop class="bottle__stop bottle__stop--glass-mid" offset="0.68"/>
        <stop class="bottle__stop bottle__stop--glass-edge" offset="1"/>
      </linearGradient>
      <linearGradient id="BottleOil-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
        <stop class="bottle__stop bottle__stop--oil-edge" offset="0"/>
        <stop class="bottle__stop bottle__stop--oil-mid" offset="0.4"/>
        <stop class="bottle__stop bottle__stop--oil-edge" offset="1"/>
      </linearGradient>
    </defs>
    <ellipse class="bottle__shadow" cx="120" cy="540" rx="96" ry="10"/>
    <path class="bottle__glass" fill="url(#BottleGlass-{{ section.id }})" d="M94 112h52v36c0 18 58 18 58 62v292c0 18-12 30-30 30H66c-18 0-30-12-30-30V210c0-44 58-44 58-62v-36Z"/>
    <path class="bottle__oil" fill="url(#BottleOil-{{ section.id }})" d="M44 244c24 7 50 10 76 10s52-3 76-10v256c0 14-9 23-24 23H68c-15 0-24-9-24-23V244Z"/>
    <rect class="bottle__shine" x="50" y="222" width="9" height="282" rx="4.5"/>
    <rect class="bottle__shine bottle__shine--soft" x="185" y="232" width="4" height="262" rx="2"/>
    <rect class="bottle__label" x="56" y="300" width="128" height="156" rx="6"/>
    <path class="bottle__mark" d="M119 322c-9 5-13 13-11 22 9-2 14-10 11-22Zm2 0c9 5 13 13 11 22-9-2-14-10-11-22Z"/>
    <rect class="bottle__line bottle__line--strong" x="84" y="360" width="72" height="7" rx="3.5"/>
    <rect class="bottle__line" x="96" y="377" width="48" height="5" rx="2.5"/>
    <rect class="bottle__rule" x="76" y="402" width="88" height="1.5"/>
    <rect class="bottle__line" x="102" y="420" width="36" height="5" rx="2.5"/>
    <rect class="bottle__collar" x="90" y="100" width="60" height="16" rx="4"/>
    <rect class="bottle__cap" x="84" y="22" width="72" height="82" rx="10"/>
    <rect class="bottle__cap-shine" x="94" y="30" width="6" height="66" rx="3"/>
  </svg>
{%- endcapture -%}

{%- capture hero_image -%}
  {%- if image != blank -%}
    {%- if image_mobile != blank -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ image_mobile | image_url: width: 480 }} 480w, {{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1000 }} 1000w, {{ image_mobile | image_url: width: 1500 }} 1500w"
          sizes="100vw"
        >
        {%- render 'image', image: image, sizes: image_sizes, widths: image_widths, loading: 'eager', fetchpriority: 'high', class: 'hero__img' -%}
      </picture>
    {%- else -%}
      {%- render 'image', image: image, sizes: image_sizes, widths: image_widths, loading: 'eager', fetchpriority: 'high', class: 'hero__img', preload: true -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture hero_video -%}
  {%- if video != blank -%}
    <div class="hero__video" aria-hidden="true">
      {{ video | video_tag: image_size: '1500x', autoplay: true, loop: true, muted: true, controls: false }}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture hero_content -%}
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow eyebrow--lg hero__eyebrow enter" style="--i: 0;">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h1 class="h0 hero__heading enter" style="--i: 1;">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="lead hero__subheading enter" style="--i: 2;">{{ section.settings.subheading | escape }}</p>
  {%- endif -%}
  {%- if show_button_1 or show_button_2 -%}
    <div class="{{ cta_class }} hero__actions enter" style="--i: 3;">
      {%- if show_button_1 -%}
        <a href="{{ section.settings.button_link_1 }}" class="btn btn--primary btn--lg hero__button">{{ section.settings.button_label_1 | escape }}</a>
      {%- endif -%}
      {%- if show_button_2 -%}
        <a href="{{ section.settings.button_link_2 }}" class="link link--chevron link--lg hero__link">
          {{- section.settings.button_label_2 | escape -}}
          {%- render 'icon', name: 'chevron-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- case layout -%}
  {%- when 'full-bleed' -%}
    <div
      class="section section--none color-{{ section.settings.color_scheme }} hero hero--full hero--{{ height }} hero--text-{{ text_position }}"
      id="section-{{ section.id }}"
      style="--hero-overlay: {{ overlay }};"
    >
      <div class="hero__bg">
        {{ hero_image }}
        {{ hero_video }}
      </div>
      <div class="hero__overlay color-scheme-3">
        <div class="hero__scrim" aria-hidden="true"></div>
        <div class="page-width hero__inner">
          <div class="hero__content">
            {{ hero_content }}
          </div>
        </div>
      </div>
    </div>

  {%- when 'split' -%}
    <div
      class="section section--none color-{{ section.settings.color_scheme }} hero hero--split hero--{{ height }}"
      id="section-{{ section.id }}"
    >
      <div class="page-width hero__inner">
        <div class="hero__content">
          {{ hero_content }}
        </div>
        <div class="hero__media media{% unless has_media %} hero__media--illustration{% endunless %}" style="--ratio: 4 / 5;">
          {%- if has_media -%}
            {{ hero_image }}
            {{ hero_video }}
          {%- else -%}
            {{ hero_bottle }}
          {%- endif -%}
        </div>
      </div>
    </div>

  {%- else -%}
    <div
      class="section section--none color-{{ section.settings.color_scheme }} hero hero--centered hero--{{ height }}"
      id="section-{{ section.id }}"
    >
      <div class="page-width hero__inner">
        <div class="hero__content">
          {{ hero_content }}
        </div>
        {%- if video != blank -%}
          <div class="hero__stage hero__stage--video media" style="--ratio: 16 / 9;">
            {{ hero_image }}
            {{ hero_video }}
          </div>
        {%- elsif image != blank -%}
          <div class="hero__stage hero__stage--{{ image_style }}">
            {{ hero_image }}
          </div>
        {%- else -%}
          <div class="hero__stage hero__stage--illustration">
            {{ hero_bottle }}
          </div>
        {%- endif -%}
      </div>
    </div>
{%- endcase -%}

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Mount of Olives"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italicise a word to set it in the accent colour.",
      "default": "Anointing oils for <em>prayer</em> and skin."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "One short sentence reads best.",
      "default": "Nine biblical blends on one olive base."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button label",
      "default": "Shop the oils"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Link label",
      "info": "Shown as a text link with a chevron, next to the button.",
      "default": "Learn about the science"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Centered: a product shot on a plain background, shown whole below the text. Split: portrait (4:5). Full-bleed: landscape. Without an image a bottle is drawn in its place."
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "info": "Centered layout only.",
      "options": [
        { "value": "product", "label": "Product shot (no frame)" },
        { "value": "photo", "label": "Photo (rounded corners)" }
      ],
      "default": "product"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown below 750px instead of the image above."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. Plays muted and looped; its poster shows for visitors who prefer reduced motion."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centered (text above media)" },
        { "value": "split", "label": "Split (text and media side by side)" },
        { "value": "full-bleed", "label": "Full-bleed (text over media)" }
      ],
      "default": "centered"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "auto", "label": "Standard" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "info": "Full-bleed layout only.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "Full-bleed layout only. Darkens the media so the text stays legible.",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
