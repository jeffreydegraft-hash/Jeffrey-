{%- comment -%}
  Featured product: an apple.com product "mini hero". Stacked (default): a
  centred eyebrow, headline, one or two lines of text, the price line and the
  CTA pair (a "Buy" pill that submits the add-to-cart form + "Learn more ›"
  to the product), then a large centred product image below. "Side by side"
  keeps the same content left-aligned next to the image (image_position).
  The photo is shown untouched (APPLE-SPEC §0.3): object-fit contain on its
  own white ground (--c-photo-ground), a rounded white stage that reads as
  an Apple Store tile on light-gray or dark bands and disappears on white.

  The add-to-cart form keeps the <product-form> contract (assets/cart.js):
  .product-form__error, {% form 'product' %} with name="id" (a native
  <select> when the product has variants, a hidden input otherwise) and a
  submit button whose first plain label span swaps to "Added". With no
  product chosen the editor shows Shopify's neutral placeholder; the live
  store renders nothing rather than a fake product, and a product without
  media renders text-only (stacked, no image stage). Motion inventory: the shared reveal (text, then image) and the
  pill/link press from base.css; nothing else moves.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  assign layout = section.settings.layout | default: 'stacked'

  assign product = section.settings.product
  assign form_id = 'FeaturedProduct-' | append: section.id
  assign select_id = form_id | append: '-variant'
  assign variant = product.selected_or_first_available_variant

  assign heading = section.settings.heading
  if heading == blank and product != blank
    assign heading = product.title | escape
  endif

  assign has_media = false
  assign media_alt = ''
  assign media_ratio = 1
  if product != blank and product.featured_media != blank
    assign has_media = true
    assign media_alt = product.featured_media.alt | default: product.title
    assign media_ratio = product.featured_media.preview_image.aspect_ratio | default: 1
    if media_ratio < 0.66
      assign media_ratio = 0.66
    elsif media_ratio > 1.8
      assign media_ratio = 1.8
    endif
  endif

  # A chosen product without media is text-only on the live store (APPLE-SPEC
  # §0.2): no stage, and stacked so split does not leave an empty column
  if has_media == false and request.design_mode == false
    assign layout = 'stacked'
  endif

  # On a band that is already the photo's white ground the stage needs no padding
  assign stage_class = ''
  assign scheme_bg = section.settings.color_scheme.settings.background
  if scheme_bg != blank and scheme_bg.red == 255 and scheme_bg.green == 255 and scheme_bg.blue == 255
    assign stage_class = ' featured-product--on-white'
  endif

  if layout == 'split'
    assign media_sizes = '(min-width: 990px) 50vw, 100vw'
  else
    assign media_sizes = '(min-width: 750px) 640px, 100vw'
  endif

  assign unavailable = false
  if product == blank or variant == null or variant.available == false
    assign unavailable = true
  endif

  if product != blank and variant == null
    assign add_label = 'products.product.unavailable' | t
  elsif product != blank and variant.available == false
    assign add_label = 'products.product.sold_out' | t
  elsif section.settings.button_label != blank
    assign add_label = section.settings.button_label
  else
    assign add_label = 'sections.featured_product.buy' | t
    if add_label contains 'ranslation missing'
      assign add_label = 'products.product.add_to_cart' | t
    endif
  endif
-%}
{%- if product != blank or request.design_mode -%}
<div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} featured-product featured-product--{{ layout }} featured-product--image-{{ section.settings.image_position }}{{ stage_class }}" id="section-{{ section.id }}">
  <div class="page-width">
    <div class="featured-product__grid">
      <div class="featured-product__content" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--lg featured-product__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="h2 featured-product__heading">
          {%- if heading != blank -%}
            {{ heading }}
          {%- else -%}
            {{ 'sections.featured_product.placeholder_title' | t }}
          {%- endif -%}
        </h2>

        {%- if section.settings.text != blank -%}
          <div class="featured-product__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.show_price -%}
          <div class="featured-product__price">
            {%- if product != blank -%}
              {%- render 'price', product: product, show_badges: true -%}
            {%- else -%}
              <div class="price">
                <div class="price__container">
                  <div class="price__regular">
                    <span class="price__item price__item--regular money">{{ 2398 | money }}</span>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if product != blank -%}
          <product-form class="product-form featured-product__form-wrap" data-section-id="{{ section.id }}">
            <p class="product-form__error form-status form-status--error" role="alert" hidden></p>
            {%- form 'product', product, id: form_id, class: 'featured-product__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              {%- if product.has_only_default_variant -%}
                <input type="hidden" name="id" value="{{ variant.id }}"{% if unavailable %} disabled{% endif %}>
              {%- else -%}
                <div class="field featured-product__field">
                  <label class="field__label visually-hidden" for="{{ select_id }}">{{ product.options | join: ' / ' | escape }}</label>
                  <div class="select">
                    <select id="{{ select_id }}" name="id" class="field__select featured-product__select">
                      {%- for option_variant in product.variants -%}
                        <option
                          value="{{ option_variant.id }}"
                          {% if option_variant.id == variant.id %}selected{% endif %}
                          {% unless option_variant.available %}disabled{% endunless %}
                        >
                          {{ option_variant.title | escape }} &mdash; {{ option_variant.price | money }}
                          {%- unless option_variant.available %} ({{ 'products.product.sold_out' | t }}){% endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                    {%- render 'icon', name: 'chevron-down', size: 18 -%}
                  </div>
                </div>
              {%- endif -%}
              <div class="cta-row featured-product__actions">
                <button
                  type="submit"
                  name="add"
                  class="btn btn--primary btn--lg featured-product__submit"
                  {% if unavailable %}disabled{% endif %}
                  {% if settings.cart_type == 'drawer' %}aria-haspopup="dialog"{% endif %}
                >
                  <span class="btn__content"><span data-add-label>{{ add_label | escape }}</span><span class="visually-hidden"> {{ product.title | escape }}</span></span>
                  {%- render 'loading-spinner' -%}
                </button>
                <a href="{{ product.url }}" class="link link--chevron link--lg featured-product__details">
                  {{- 'general.learn_more' | t -}}
                  <span class="visually-hidden">: {{ product.title | escape }}</span>
                  {%- render 'icon', name: 'chevron-right', size: 16 -%}
                </a>
              </div>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <div class="cta-row featured-product__actions">
            <button type="button" class="btn btn--primary btn--lg featured-product__submit" disabled>
              <span class="btn__content"><span>{{ add_label | escape }}</span></span>
            </button>
            {%- if request.design_mode -%}
              <span class="link link--chevron link--lg featured-product__details" aria-hidden="true">
                {{- 'general.learn_more' | t -}}
                {%- render 'icon', name: 'chevron-right', size: 16 -%}
              </span>
            {%- endif -%}
          </div>
          {%- if request.design_mode -%}
            <p class="caption featured-product__hint">{{ 'sections.featured_product.no_product' | t }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if has_media or request.design_mode -%}
      <div class="featured-product__media" data-reveal>
        {%- if has_media -%}
          <a href="{{ product.url }}" class="featured-product__stage" aria-label="{{ product.title | escape }}" tabindex="-1" style="--fp-ratio: {{ media_ratio }};">
            {%- render 'image', image: product.featured_media, sizes: media_sizes, widths: '400, 600, 800, 1000, 1200, 1600', class: 'featured-product__img', loading: 'lazy', ratio: media_ratio, wrapper_class: 'featured-product__figure', alt: media_alt -%}
          </a>
        {%- else -%}
          <div class="featured-product__stage" style="--fp-ratio: 1;">
            <div class="media featured-product__figure featured-product__figure--placeholder" style="--ratio: 1 / 1;">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Featured product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "100% Squalane Oil"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the product title.",
      "default": "Hydration from head to toe."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our 100% Squalane Oil is sustainable, vegan, derived from olives, and steeped in biblical tradition. One ingredient and nothing else, in a 4 oz bottle.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add-to-cart button label",
      "info": "Leave empty to use “Buy”. Sold-out products always read “Sold out”."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Centered, image below" },
        { "value": "split", "label": "Image beside text" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "info": "Applies to the “Image beside text” layout.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Featured product"
    }
  ]
}
{% endschema %}
