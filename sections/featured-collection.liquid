{%- comment -%}
  Featured collection (apple.com store grid): a centred header (eyebrow, h2,
  muted lead), product tiles in rows (3-up desktop by default, 2-up tablet,
  2-up phone with compact tiles; a short last row centres under the full
  ones), then a centred "Shop all ›" link.

  Empty cases (never fake products to customers, APPLE-SPEC §0.2):
  - no collection chosen (cleared, deleted or unpublished): the storefront
    shows the store's "all" collection; the editor shows Shopify's neutral
    placeholder cards so the merchant sees where to pick one
  - a collection with no products: placeholders in the editor, a designed
    empty state on the storefront
{%- endcomment -%}
{%- liquid
  assign featured = section.settings.collection
  assign limit = section.settings.products_to_show | default: 9
  assign cols = section.settings.columns_desktop | default: 3
  assign cols_tablet = cols | at_most: 2
  assign col_vw = 100 | divided_by: cols
  assign card_sizes = '(min-width: 990px) ' | append: col_vw | append: 'vw, 50vw'

  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  if featured == blank and request.design_mode == false
    assign featured = collections.all
  endif

  assign show_placeholders = false
  assign show_empty = false
  if featured == blank or featured.products_count == 0
    if request.design_mode
      assign show_placeholders = true
    else
      assign show_empty = true
    endif
  endif

  assign view_all_url = routes.all_products_collection_url
  if featured != blank
    assign view_all_url = featured.url
  endif
  assign view_all_label = section.settings.view_all_label
  if view_all_label == blank
    assign view_all_label = 'sections.featured_collection.view_all' | t
  endif

  assign has_header = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank
    assign has_header = true
  endif
-%}
<div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} featured-collection" id="section-{{ section.id }}">
  <div class="page-width">
    {%- if has_header -%}
      <header class="section__header section__header--center featured-collection__header" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 featured-collection__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="lead lead--muted featured-collection__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if show_empty -%}
      <div class="empty-state featured-collection__empty">
        <p class="h4">{{ 'collections.general.empty' | t }}</p>
        <p class="muted text-pretty">{{ 'sections.featured_collection.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.shop_now' | t }}</a>
      </div>
    {%- else -%}
      <ul
        class="grid grid--mobile-2 featured-collection__grid"
        role="list"
        style="--cols-desktop: {{ cols }}; --cols-tablet: {{ cols_tablet }};"
      >
        {%- if show_placeholders -%}
          {%- for i in (1..cols) -%}
            <li class="featured-collection__item">
              {%- comment -%} product: nil, or the template's global product leaks into the snippet {%- endcomment -%}
              {%- render 'card-product', product: nil, index: forloop.index0, sizes: card_sizes -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for product in featured.products limit: limit -%}
            <li class="featured-collection__item">
              {%- render 'card-product', product: product, index: forloop.index0, sizes: card_sizes -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if section.settings.show_view_all -%}
        <div class="featured-collection__footer">
          <a href="{{ view_all_url }}" class="link link--chevron link--lg featured-collection__view-all">
            {{- view_all_label | escape -}}
            {%- render 'icon', name: 'chevron-right', size: 16 -%}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Nine biblical blends."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "One olive base."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "info": "Tiles show 2-up on tablets and phones.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “Shop all” link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "“Shop all” label",
      "default": "Shop all oils"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "settings": {
        "collection": "all"
      }
    }
  ]
}
{% endschema %}
