<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tier_product = block.settings.product
          assign link = block.settings.link
          if link == blank and tier_product != blank
            assign link = tier_product.url
          endif
          if link == blank
            assign link = routes.all_products_collection_url
          endif
          assign price_text = block.settings.price
          if price_text == blank and tier_product != blank
            assign price_text = tier_product.price_min | money
          endif
        -%}
        <div class="tier{% if block.settings.highlight %} tier--highlight{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.flag != blank -%}<span class="badge tier__flag">{{ block.settings.flag }}</span>{%- endif -%}
          <h3 class="tier__name">{{ block.settings.name }}</h3>
          <p class="tier__tag">{{ block.settings.tagline }}</p>
          <div class="tier__price">{{ price_text }}{% if block.settings.price_note != blank %}<small>{{ block.settings.price_note }}</small>{% endif %}</div>
          {%- if block.settings.features != blank -%}
            <ul class="tier__list">
              {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- for feature in features -%}
                {%- assign f = feature | strip -%}
                {%- if f != blank -%}<li>{% render 'icon', icon: 'check' %}<span>{{ f }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <a class="btn {% if block.settings.highlight %}btn--primary{% else %}btn--secondary{% endif %} btn--full" href="{{ link }}">{{ block.settings.button_label }}</a>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="tiers__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Sizes & sets",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sizes & sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the size that fits your walk" },
    { "type": "text", "id": "text", "label": "Text", "default": "Same oil, same prayer, three sizes. Save more as you go up." },
    { "type": "text", "id": "note", "label": "Note under tiers", "default": "Prices shown are starting prices. Final price is shown on each product." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "1 oz" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "For travel and daily prayer" },
        { "type": "text", "id": "price", "label": "Price text", "info": "Leave empty to use the linked product's price." },
        { "type": "text", "id": "price_note", "label": "Price note", "default": "per bottle" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "30 ml glass bottle\nFits in a purse or pocket\nEvery blend available" },
        { "type": "text", "id": "flag", "label": "Flag (e.g. Most popular)" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this tier", "default": false },
        { "type": "product", "id": "product", "label": "Link to product" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop 1 oz" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sizes & sets",
      "blocks": [
        { "type": "tier", "settings": { "name": "1 oz", "tagline": "For travel and daily prayer", "price": "From $16.98", "price_note": "per bottle", "features": "30 ml glass bottle\nFits a purse or pocket\nEvery blend available", "button_label": "Shop 1 oz" } },
        { "type": "tier", "settings": { "name": "2 oz", "tagline": "For the home and the prayer closet", "price": "From $22.98", "price_note": "per bottle", "features": "60 ml glass bottle\nTwice the oil, better value\nEvery blend available", "flag": "Most popular", "highlight": true, "button_label": "Shop 2 oz" } },
        { "type": "tier", "settings": { "name": "4 oz", "tagline": "For churches, ministries and families", "price": "From $34.98", "price_note": "per bottle", "features": "118 ml glass bottle\nBest value per ounce\nIdeal for anointing services", "button_label": "Shop 4 oz" } },
        { "type": "tier", "settings": { "name": "Gift sets", "tagline": "Discover your oil, or give one", "price": "From $84.98", "price_note": "per set", "features": "Curated multi-oil sets\nGift-ready packaging\nScripture card included", "flag": "Best gift", "button_label": "Shop sets" } }
      ]
    }
  ]
}
{% endschema %}
