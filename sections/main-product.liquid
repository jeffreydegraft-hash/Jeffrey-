{%- comment -%}
  Main product section.
  Grid: media (7/12, left) + info column (5/12) from 990px. The shorter
  column sticks while the longer one scrolls when enable_sticky_info is on
  (media for the thumbnails layout, info for the stacked layout).
  Every block root carries block.shopify_attributes.
{%- endcomment -%}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign variant = product.selected_or_first_available_variant
  assign media_layout = section.settings.media_layout | default: 'thumbnails'

  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  capture default_theme_word
    render 'product-defaults', product: product, field: 'theme_word'
  endcapture
  capture default_scripture_quote
    render 'product-defaults', product: product, field: 'scripture_quote'
  endcapture
  capture default_scripture_reference
    render 'product-defaults', product: product, field: 'scripture_reference'
  endcapture
  capture default_meaning
    render 'product-defaults', product: product, field: 'meaning'
  endcapture
  capture default_botanical
    render 'product-defaults', product: product, field: 'botanical'
  endcapture
  capture default_ingredients
    render 'product-defaults', product: product, field: 'ingredients'
  endcapture
  capture default_one_liner
    render 'product-defaults', product: product, field: 'one_liner'
  endcapture
  assign default_theme_word = default_theme_word | strip
  assign default_scripture_quote = default_scripture_quote | strip
  assign default_scripture_reference = default_scripture_reference | strip
  assign default_meaning = default_meaning | strip
  assign default_botanical = default_botanical | strip
  assign default_ingredients = default_ingredients | strip
  assign default_one_liner = default_one_liner | strip

  assign theme_word = product.metafields.custom.theme_word.value | default: default_theme_word | default: product.type
  assign scripture_quote = product.metafields.custom.scripture_quote.value | default: default_scripture_quote
  assign scripture_reference = product.metafields.custom.scripture_reference.value | default: default_scripture_reference
  assign meaning = product.metafields.custom.meaning.value | default: default_meaning
  assign botanical = product.metafields.custom.botanical.value | default: default_botanical
  assign ingredients_line = product.metafields.custom.ingredients.value | default: default_ingredients
-%}

<section
  class="product section{{ padding_class }} color-{{ section.settings.color_scheme }}"
  id="section-{{ section.id }}"
  data-section="{{ section.id }}"
>
  <div class="page-width">
    <div class="product__grid product__grid--{{ media_layout }}{% if section.settings.enable_sticky_info %} product__grid--sticky{% endif %}">
      <div class="product__media">
        {%- render 'product-media-gallery', product: product, layout: media_layout, enable_zoom: section.settings.enable_zoom -%}
      </div>

      <div class="product__info">
        <div class="product__info-inner">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="product__block product__block--app" {{ block.shopify_attributes }}>
                  {%- render block -%}
                </div>

              {%- when 'theme_word' -%}
                {%- if theme_word != blank -%}
                  <div class="product__block product__block--theme-word" {{ block.shopify_attributes }}>
                    <p class="eyebrow product__eyebrow">{{ theme_word | escape }}</p>
                  </div>
                {%- endif -%}

              {%- when 'title' -%}
                <div class="product__block product__block--title" {{ block.shopify_attributes }}>
                  <h1 class="h1 product__title">{{ product.title | escape }}</h1>
                </div>

              {%- when 'price' -%}
                {%- liquid
                  assign show_low_stock = false
                  if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5
                    assign show_low_stock = true
                  endif
                -%}
                <div class="product__block product__block--price" {{ block.shopify_attributes }}>
                  <div class="product__price" id="price-{{ section.id }}" role="status">
                    {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
                  </div>
                  <p class="product__sku caption" id="Sku-{{ section.id }}" {% if variant.sku == blank %}hidden{% endif %}>
                    <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                    <span class="product__sku-value">{{ variant.sku }}</span>
                  </p>
                  <p class="product__inventory caption" id="Inventory-{{ section.id }}" role="status" {% unless show_low_stock %}hidden{% endunless %}>
                    {%- if show_low_stock -%}
                      {{ 'products.product.inventory_low_stock_show_count' | t: quantity: variant.inventory_quantity }}
                    {%- endif -%}
                  </p>
                  {%- if block.settings.show_taxes_note -%}
                    {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                      <p class="product__tax-note caption">
                        {%- if cart.taxes_included -%}
                          {{ 'products.product.taxes_included' | t }}
                        {%- endif -%}
                        {%- if shop.shipping_policy.body != blank -%}
                          {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="product__block product__block--variant-picker" {{ block.shopify_attributes }}>
                    {%- render 'product-variant-picker', product: product, product_form_id: product_form_id -%}
                  </div>
                {%- endunless -%}

              {%- when 'quantity' -%}
                {%- liquid
                  assign qty_id = 'Quantity-' | append: section.id
                  assign qty_min = variant.quantity_rule.min | default: 1
                  assign qty_max = variant.quantity_rule.max
                  assign qty_step = variant.quantity_rule.increment | default: 1
                -%}
                <div class="product__block product__block--quantity" {{ block.shopify_attributes }}>
                  <label class="field__label product__quantity-label" for="{{ qty_id }}">{{ 'products.product.quantity.label' | t }}</label>
                  {%- render 'quantity-input', id: qty_id, form: product_form_id, label: product.title, value: qty_min, min: qty_min, max: qty_max, step: qty_step -%}
                </div>

              {%- when 'buy_buttons' -%}
                <div class="product__block product__block--buy-buttons" {{ block.shopify_attributes }}>
                  {%- render 'buy-buttons', product: product, product_form_id: product_form_id, show_dynamic_checkout: block.settings.show_dynamic_checkout -%}
                </div>

              {%- when 'trust' -%}
                {%- liquid
                  assign has_trust = false
                  if block.settings.text_1 != blank or block.settings.text_2 != blank or block.settings.text_3 != blank
                    assign has_trust = true
                  endif
                -%}
                {%- if has_trust -%}
                  <div class="product__block product__block--trust" {{ block.shopify_attributes }}>
                    <ul class="product__trust" role="list">
                      {%- for i in (1..3) -%}
                        {%- liquid
                          assign text_key = 'text_' | append: i
                          assign icon_key = 'icon_' | append: i
                          assign trust_text = block.settings[text_key]
                          assign trust_icon = block.settings[icon_key] | default: 'leaf'
                        -%}
                        {%- if trust_text != blank -%}
                          <li class="product__trust-item">
                            {%- render 'icon', name: trust_icon, size: 18 -%}
                            <span>{{ trust_text | escape }}</span>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

              {%- when 'scripture' -%}
                {%- if scripture_quote != blank -%}
                  <div class="product__block product__block--scripture" {{ block.shopify_attributes }}>
                    <figure class="scripture product__scripture">
                      <p class="eyebrow eyebrow--ink product__scripture-label">{{ 'products.product.scripture_label' | t }}</p>
                      <blockquote class="scripture__quote">{{ scripture_quote | escape }}</blockquote>
                      {%- if scripture_reference != blank -%}
                        <figcaption class="scripture__ref">{{ scripture_reference | escape }}</figcaption>
                      {%- endif -%}
                    </figure>
                    {%- if block.settings.show_meaning and meaning != blank -%}
                      <div class="product__meaning">
                        <p class="eyebrow eyebrow--ink">{{ 'products.product.meaning_label' | t }}</p>
                        <p class="product__meaning-text">{{ meaning | escape | newline_to_br }}</p>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'botanical' -%}
                {%- if botanical != blank -%}
                  <div class="product__block product__block--botanical" {{ block.shopify_attributes }}>
                    <p class="eyebrow eyebrow--ink">{{ 'products.product.botanical_label' | t }}</p>
                    <p class="product__botanical-text">{{ botanical | escape | newline_to_br }}</p>
                  </div>
                {%- endif -%}

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__block product__block--description" {{ block.shopify_attributes }}>
                    <div class="rte product__description">{{ product.description }}</div>
                  </div>
                {%- elsif default_one_liner != blank -%}
                  <div class="product__block product__block--description" {{ block.shopify_attributes }}>
                    <p class="lead product__description">{{ default_one_liner | escape }}</p>
                  </div>
                {%- endif -%}

              {%- when 'collapsible_tab' -%}
                {%- liquid
                  assign tab_source = block.settings.source | default: 'custom'
                  assign tab_heading = block.settings.heading
                  if tab_heading == blank
                    case tab_source
                      when 'ingredients'
                        assign tab_heading = 'products.product.ingredients' | t
                      when 'how_to_use'
                        assign tab_heading = 'products.product.how_to_use' | t
                      when 'shipping'
                        assign tab_heading = 'products.product.shipping' | t
                    endcase
                  endif
                  assign tab_content = block.settings.content
                  assign tab_ingredients = ''
                  if tab_source == 'ingredients'
                    assign tab_ingredients = ingredients_line
                  endif
                  assign show_tab = false
                  if tab_heading != blank
                    if tab_content != blank
                      assign show_tab = true
                    elsif tab_ingredients != blank
                      assign show_tab = true
                    elsif tab_source == 'shipping'
                      if shop.shipping_policy.body != blank or shop.refund_policy.body != blank
                        assign show_tab = true
                      endif
                    endif
                  endif
                  assign tab_id = 'Tab-' | append: section.id | append: '-' | append: block.id
                -%}
                {%- if show_tab -%}
                  <div class="product__block product__block--tab" {{ block.shopify_attributes }}>
                    <olivet-accordion class="accordion product__accordion">
                      <details id="{{ tab_id }}">
                        <summary class="accordion__summary" aria-controls="{{ tab_id }}-content">
                          <span class="accordion__title">{{ tab_heading | escape }}</span>
                          {%- render 'icon', name: 'plus', size: 18 -%}
                        </summary>
                        <div class="accordion__content" data-accordion-content id="{{ tab_id }}-content">
                          <div class="accordion__inner">
                            <div class="rte product__tab-body">
                              {%- if tab_ingredients != blank -%}
                                <p class="product__ingredients">{{ tab_ingredients | escape | newline_to_br }}</p>
                              {%- endif -%}
                              {{ tab_content }}
                              {%- if tab_source == 'shipping' -%}
                                {%- if shop.shipping_policy.body != blank or shop.refund_policy.body != blank -%}
                                  <p class="product__policy-links">
                                    {%- if shop.shipping_policy.body != blank -%}
                                      <a href="{{ shop.shipping_policy.url }}" class="link link--underline">{{ shop.shipping_policy.title }}</a>
                                    {%- endif -%}
                                    {%- if shop.refund_policy.body != blank -%}
                                      <a href="{{ shop.refund_policy.url }}" class="link link--underline">{{ shop.refund_policy.title }}</a>
                                    {%- endif -%}
                                  </p>
                                {%- endif -%}
                              {%- endif -%}
                            </div>
                          </div>
                        </div>
                      </details>
                    </olivet-accordion>
                  </div>
                {%- endif -%}

              {%- when 'share' -%}
                <div class="product__block product__block--share" {{ block.shopify_attributes }}>
                  <share-button
                    class="product__share"
                    data-url="{{ shop.url | append: product.url }}"
                    data-title="{{ product.title | escape }}"
                    data-copied="{{ 'general.share.copied' | t }}"
                  >
                    <button type="button" class="btn btn--ghost btn--sm product__share-button">
                      {%- render 'icon', name: 'share', size: 18 -%}
                      <span class="btn__content"><span data-share-label>{{ 'general.share.label' | t }}</span></span>
                    </button>
                  </share-button>
                </div>

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="product__block product__block--text" {{ block.shopify_attributes }}>
                    <div class="rte product__text">{{ block.settings.text }}</div>
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [
        {{ product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}
      ],
    {%- endif -%}
    "description": {{ product.description | strip_html | truncate: 300 | json }},
    {%- if variant.sku != blank -%}
      "sku": {{ variant.sku | json }},
    {%- endif -%}
    {%- if product.vendor != blank -%}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
    {%- endif -%}
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ v.title | json }},
          {%- if v.sku != blank -%}
            "sku": {{ v.sku | json }},
          {%- endif -%}
          "price": {{ v.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
          "url": {{ request.origin | append: v.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Media layout",
      "options": [
        { "value": "thumbnails", "label": "Stage with thumbnails" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "thumbnails"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Open images in a lightbox",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Keep the shorter column in view",
      "info": "On large screens the product details stick while stacked media scrolls. With the thumbnail layout the media stage sticks while the details scroll.",
      "default": true
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "theme_word",
      "name": "Theme word",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the product metafield custom.theme_word (for example “Reverence”), falling back to the built-in copy for the launch products, then the product type."
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_taxes_note",
          "label": "Show tax and shipping note",
          "default": true
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "info": "Shop Pay, PayPal or Google Pay, depending on the customer.",
          "default": true
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust points",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icon 1",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "shield", "label": "Shield" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Text 1",
          "default": "Free US shipping on orders $45+"
        },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icon 2",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "shield", "label": "Shield" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2",
          "default": "Natural, paraben-free, vegan"
        },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icon 3",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "shield", "label": "Shield" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "map-pin"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3",
          "default": "Blended and bottled in Richmond, Texas"
        }
      ]
    },
    {
      "type": "scripture",
      "name": "Scripture",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Reads the product metafields custom.scripture_quote, custom.scripture_reference and custom.meaning, with built-in copy for the launch products."
        },
        {
          "type": "checkbox",
          "id": "show_meaning",
          "label": "Show the meaning paragraph",
          "default": true
        }
      ]
    },
    {
      "type": "botanical",
      "name": "The botanical",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Reads the product metafield custom.botanical, with built-in copy for the launch products."
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave empty to use the default heading for the chosen source."
        },
        {
          "type": "select",
          "id": "source",
          "label": "Source",
          "options": [
            { "value": "custom", "label": "Custom content" },
            { "value": "ingredients", "label": "Ingredients (metafield custom.ingredients, then content)" },
            { "value": "how_to_use", "label": "How to use" },
            { "value": "shipping", "label": "Shipping and returns (adds policy links)" }
          ],
          "default": "custom"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>For external use only.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
