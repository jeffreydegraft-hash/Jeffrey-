{%- comment -%}
  Collection list: a heading and a grid of hand-picked collections.
  Each block is a collection picker; an unassigned block renders a
  placeholder card so the editor never shows a hole.
{%- endcomment -%}
{%- liquid
  assign col_vw = 100 | divided_by: section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) ' | append: col_vw | append: 'vw, (min-width: 750px) 50vw, 50vw'

  assign spacing_class = ''
  case section.settings.spacing
    when 'tight'
      assign spacing_class = ' section--tight'
    when 'none'
      assign spacing_class = ' section--none'
  endcase
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
  <div class="section{{ spacing_class }} color-{{ section.settings.color_scheme }} collection-list" id="section-{{ section.id }}">
    <div class="page-width">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.show_view_all -%}
        <header class="section__header section__header--row collection-list__header" data-reveal>
          <div class="stack stack--sm">
            {%- if section.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="h2">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          </div>
          {%- if section.settings.show_view_all -%}
            <a href="{{ routes.collections_url }}" class="link link--arrow collection-list__view-all">
              {{ 'general.view_all' | t }}
              {%- render 'icon', name: 'arrow-right', size: 18 -%}
            </a>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="grid grid--3 grid--mobile-2 collection-list__grid" role="list" style="--cols-desktop: {{ section.settings.columns_desktop }};">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'card-collection', collection: block.settings.collection, index: forloop.index0, sizes: card_sizes -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="empty-state collection-list__empty">
          {%- render 'icon', name: 'info', size: 36 -%}
          <p class="muted text-pretty">{{ 'sections.collection_list.empty' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “View all” link",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
