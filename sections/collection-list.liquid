{%- comment -%}
  Collection list: a centred heading and a grid of hand-picked collection
  tiles.
  Each block is a collection picker. In the theme editor an unassigned block
  renders a placeholder card so the editor never shows a hole; on the live
  store it is skipped (APPLE-SPEC §0.2), the grid is sized to the tiles that
  actually render, and with none the section renders nothing.
{%- endcomment -%}
{%- liquid
  assign col_vw = 100 | divided_by: section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) ' | append: col_vw | append: 'vw, 50vw'

  assign tile_count = 0
  for block in section.blocks
    if block.settings.collection != blank or request.design_mode
      assign tile_count = tile_count | plus: 1
    endif
  endfor

  assign spacing_class = ''
  case section.settings.spacing
    when 'tight'
      assign spacing_class = ' section--tight'
    when 'none'
      assign spacing_class = ' section--none'
  endcase
-%}
{%- if tile_count > 0 or request.design_mode -%}
  <div class="section{{ spacing_class }} color-{{ section.settings.color_scheme }} collection-list" id="section-{{ section.id }}">
    <div class="page-width">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.show_view_all -%}
        <header class="section__header section__header--center collection-list__header" data-reveal>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.show_view_all -%}
            <a href="{{ routes.collections_url }}" class="link link--chevron link--lg collection-list__view-all">
              {{- 'general.view_all' | t -}}
              {%- render 'icon', name: 'chevron-right', size: 12 -%}
            </a>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if tile_count > 0 -%}
        <ul class="grid grid--3 grid--mobile-2 collection-list__grid{% if tile_count < section.settings.columns_desktop %} collection-list__grid--few{% endif %}" role="list" style="--cols-desktop: {{ section.settings.columns_desktop }}; --count: {{ tile_count }};">
          {%- assign tile_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.collection != blank or request.design_mode -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'card-collection', collection: block.settings.collection, index: tile_index, sizes: card_sizes -%}
              </li>
              {%- assign tile_index = tile_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="empty-state collection-list__empty">
          <p class="collection-list__empty-body">{{ 'sections.collection_list.empty' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “View all” link",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
