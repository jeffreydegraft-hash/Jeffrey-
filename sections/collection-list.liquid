<section class="section section--surface" id="purpose" style="--tile-cols: {{ section.blocks.size | at_least: 2 | at_most: 4 }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign title = block.settings.title
          if title == blank
            assign title = col.title
          endif
          assign img = block.settings.image
          if img == blank
            assign img = col.image
          endif
          if img == blank
            assign img = col.products.first.featured_image
          endif
          assign url = block.settings.link
          if url == blank
            assign url = col.url
          endif
          if url == blank
            assign url = routes.all_products_collection_url
          endif
        -%}
        <a class="tile" href="{{ url }}" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400,600,900', alt: title }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag }}
          {%- endif -%}
          <div class="tile__body">
            {%- if block.settings.eyebrow != blank -%}<p class="tile__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h3 class="tile__title">{{ title | default: 'Collection' }}</h3>
            {%- if block.settings.text != blank -%}<p class="tile__text">{{ block.settings.text }}</p>{%- endif -%}
            <span class="tile__cta">{{ section.settings.cta_label }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop by purpose",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your oil" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are you praying for?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Start with the need. Every oil is matched to a purpose and a passage." },
    { "type": "text", "id": "cta_label", "label": "Tile link label", "default": "Explore →" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection title." },
        { "type": "text", "id": "text", "label": "Short description" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by purpose",
      "blocks": [
        { "type": "tile", "settings": { "eyebrow": "For", "title": "Prayer & worship", "text": "Set apart your quiet time." } },
        { "type": "tile", "settings": { "eyebrow": "For", "title": "Protection", "text": "Cover your home and family." } },
        { "type": "tile", "settings": { "eyebrow": "For", "title": "Healing", "text": "Anoint the sick in faith." } },
        { "type": "tile", "settings": { "eyebrow": "For", "title": "Gifting", "text": "Sets for those you love." } }
      ]
    }
  ]
}
{% endschema %}
