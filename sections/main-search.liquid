{%- paginate search.results by 24 -%}
<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="page-head" style="padding-top:2rem;max-width:none">
      <h1 class="h2">{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search{% endif %}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="margin:1rem 0 0;max-width:640px">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search oils, scripture, purpose…" aria-label="Search">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="btn btn--primary">Search</button>
      </form>
    </div>
    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="empty"><p class="lead">Nothing found. Try “frankincense”, “protection”, or “gift”.</p><a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Browse all oils</a></div>
      {%- else -%}
        <p class="muted">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>
        <div class="product-grid product-grid--4">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {% render 'product-card', product: item %}
              {%- when 'article' -%}
                <article class="post-card">
                  <a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</a>
                  <p class="post-card__meta">Journal</p><h3 class="h4"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                </article>
              {%- when 'page' -%}
                <article class="post-card"><p class="post-card__meta">Page</p><h3 class="h4"><a href="{{ item.url }}">{{ item.title }}</a></h3><p>{{ item.content | strip_html | truncatewords: 20 }}</p></article>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
