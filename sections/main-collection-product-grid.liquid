{%- comment -%}
  Collection product grid (Apple Store category page): a quiet 14px toolbar
  (count left, sort pill right, "Filter" pill under 990px), a slim filter
  column at 990px and up, product tiles, and a bottom filter sheet on phones.

  Contract for assets/facets.js (Section Rendering API):
  - snippets/facets renders <form data-section="{{ section.id }}">:
      #FacetFiltersForm (desktop sidebar) and #FacetFiltersFormMobile (sheet)
  - #SortBy: toolbar select (every breakpoint), associated with the primary
    form via form=""; the sheet form carries sort_by as [data-sort-select]
  - #ProductGridContainer: everything that re-renders on a change
    (grid, empty state, pagination)
  - #ProductCount, #ProductCountDrawer, #ActiveFacets, #ActiveFacetsBadge:
    swapped by id after each fetch
  - [data-facet-remove] links (chips, "Clear all") are fetched, not followed
  - <facets-drawer id="FacetsDrawer" data-drawer> extends Olivet.Drawer; its
    panel is a left sheet on tablets and a bottom sheet on phones, dragged
    from [data-sheet-handle]
{%- endcomment -%}
{%- liquid
  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting = section.settings.enable_sorting

  assign has_filters = false
  if enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif

  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor

  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign cols_desktop = section.settings.columns_desktop

  if has_filters
    assign primary_form_id = 'FacetFiltersForm'
    assign col_vw = 75 | divided_by: cols_desktop
  else
    assign primary_form_id = 'FacetFiltersFormMobile'
    assign col_vw = 100 | divided_by: cols_desktop
  endif
  assign card_sizes = '(min-width: 990px) ' | append: col_vw | append: 'vw, 50vw'

  assign spacing_class = ''
  case section.settings.spacing
    when 'tight'
      assign spacing_class = ' section--tight'
    when 'none'
      assign spacing_class = ' section--none'
  endcase
-%}
<div class="section{{ spacing_class }} color-{{ section.settings.color_scheme }} collection-grid{% if has_filters %} collection-grid--has-filters{% endif %}" id="section-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="page-width">
      <div class="collection-grid__layout">
        {%- if has_filters -%}
          <aside class="collection-grid__sidebar small-hide medium-hide" aria-labelledby="FacetsSidebar-Title-{{ section.id }}">
            <div class="collection-grid__sidebar-inner">
              <h2 class="collection-grid__sidebar-title" id="FacetsSidebar-Title-{{ section.id }}">{{ 'products.facets.filter_by_label' | t }}</h2>
              {%- render 'facets', results: collection, enable_filtering: true, enable_sorting: enable_sorting, context: 'sidebar', section_id: section.id -%}
            </div>
          </aside>
        {%- endif -%}

        <div class="collection-grid__main">
          <div class="collection-grid__toolbar">
            <p id="ProductCount" class="collection-grid__count" role="status" aria-live="polite">
              {{- 'products.facets.product_count_simple' | t: count: collection.products_count -}}
            </p>

            {%- if enable_sorting or has_filters -%}
              <div class="collection-grid__controls">
                {%- if enable_sorting -%}
                  <div class="collection-grid__sort">
                    <label for="SortBy" class="collection-grid__sort-label">{{ 'products.facets.sort_by_label' | t }}</label>
                    <div class="collection-grid__select">
                      <select id="SortBy" name="sort_by" form="{{ primary_form_id }}">
                        {%- for option in collection.sort_options -%}
                          <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                        {%- endfor -%}
                      </select>
                      {%- render 'icon', name: 'chevron-down', size: 12 -%}
                    </div>
                  </div>
                {%- endif -%}

                {%- if has_filters -%}
                  <button
                    type="button"
                    class="collection-grid__filter-button large-up-hide"
                    data-drawer-open="#FacetsDrawer"
                    aria-controls="FacetsDrawer"
                    aria-expanded="false"
                  >
                    {%- render 'icon', name: 'filter', size: 16 -%}
                    <span>{{ 'products.facets.filter_button' | t }}</span>
                    <span id="ActiveFacetsBadge" class="collection-grid__badge{% if active_count == 0 %} is-empty{% endif %}" aria-hidden="true">{{ active_count }}</span>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if has_filters -%}
            <div id="ActiveFacets" class="active-facets{% if active_count == 0 %} is-empty{% endif %}">
              {%- if active_count > 0 -%}
                <ul class="active-facets__list" role="list" aria-label="{{ 'products.facets.active_filters' | t }}">
                  {%- for filter in collection.filters -%}
                    {%- for value in filter.active_values -%}
                      <li>
                        <a href="{{ value.url_to_remove }}" class="chip active-facets__chip" data-facet-remove>
                          <span class="active-facets__chip-label">{{ filter.label | escape }}: {{ value.label | escape }}</span>
                          {%- render 'icon', name: 'close', size: 12 -%}
                          <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                        <li>
                          <a href="{{ filter.url_to_remove }}" class="chip active-facets__chip" data-facet-remove>
                            <span class="active-facets__chip-label tnum">{{ filter.min_value.value | default: 0 | money }} &ndash; {{ filter.max_value.value | default: filter.range_max | money }}</span>
                            {%- render 'icon', name: 'close', size: 12 -%}
                            <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <li>
                    <a href="{{ collection.url }}" class="link active-facets__clear" data-facet-remove>{{ 'products.facets.clear_all' | t }}</a>
                  </li>
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div id="ProductGridContainer" class="collection-grid__container" aria-busy="false">
            {%- if collection.products_count > 0 -%}
              <ul class="grid grid--mobile-2 product-grid" role="list" style="--cols-desktop: {{ cols_desktop }}; --cols-tablet: 2;">
                {%- for product in collection.products -%}
                  <li class="product-grid__item">
                    {%- render 'card-product', product: product, index: forloop.index0, sizes: card_sizes -%}
                  </li>
                {%- endfor -%}
              </ul>
              {%- render 'pagination', paginate: paginate, anchor: '#ProductGridContainer' -%}
            {%- else -%}
              <div class="empty-state collection-grid__empty">
                <h2 class="h3">{{ 'collections.general.empty' | t }}</h2>
                {%- comment -%} Only suggest removing a filter when one is on {%- endcomment -%}
                {%- if active_count > 0 -%}
                  <p class="collection-grid__empty-body">{{ 'collections.general.empty_body' | t }}</p>
                {%- else -%}
                  <p class="collection-grid__empty-body">{{ 'collections.general.empty_collection_body' | t }}</p>
                {%- endif -%}
                <div class="cta-row">
                  {%- if active_count > 0 -%}
                    <a href="{{ collection.url }}" class="btn btn--primary" data-facet-remove>{{ 'products.facets.clear_all' | t }}</a>
                  {%- else -%}
                    <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'collections.general.all' | t }}</a>
                  {%- endif -%}
                  <a href="{{ routes.search_url }}" class="link link--chevron">
                    {{- 'search.search' | t -}}
                    {%- render 'icon', name: 'chevron-right', size: 12 -%}
                  </a>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- if has_filters -%}
      <facets-drawer id="FacetsDrawer" data-drawer class="facets-drawer" aria-hidden="true" inert>
        <div class="drawer__backdrop" data-drawer-backdrop></div>
        <div class="drawer__panel drawer__panel--left facets-drawer__panel" data-drawer-panel role="dialog" aria-modal="true" aria-labelledby="FacetsDrawer-Title">
          <div class="sheet__handle" data-sheet-handle aria-hidden="true"></div>
          <div class="drawer__header facets-drawer__header" data-sheet-handle>
            <h2 class="drawer__title" id="FacetsDrawer-Title" tabindex="-1" data-drawer-focus>{{ 'products.facets.filter_button' | t }}</h2>
            <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
              {%- render 'icon', name: 'close', size: 16 -%}
            </button>
          </div>
          <div class="drawer__body facets-drawer__body">
            {%- render 'facets', results: collection, enable_filtering: true, enable_sorting: enable_sorting, context: 'drawer', section_id: section.id -%}
          </div>
          <div class="drawer__footer facets-drawer__footer">
            <a href="{{ collection.url }}" class="link facets-drawer__clear" data-facet-remove>{{ 'products.facets.clear_all' | t }}</a>
            <button type="button" class="btn btn--primary btn--lg facets-drawer__apply" data-drawer-close>
              <span id="ProductCountDrawer">{{ 'products.facets.show_results' | t: count: collection.products_count }}</span>
            </button>
          </div>
        </div>
      </facets-drawer>
    {%- elsif enable_sorting -%}
      {%- comment -%} Sort only: the toolbar select still needs a form to build its query {%- endcomment -%}
      <div class="collection-grid__sort-form" hidden>
        {%- render 'facets', results: collection, enable_filtering: false, enable_sorting: true, context: 'drawer', section_id: section.id -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Collection product grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "info": "Tablets and phones always show two.",
      "default": 3
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "Choose which filters appear in the Search & Discovery app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "tight"
    }
  ]
}
{% endschema %}
