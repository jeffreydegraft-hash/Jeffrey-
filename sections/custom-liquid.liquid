{%- comment -%}
  Custom Liquid: renders whatever the merchant pastes into the setting,
  inside the page width and the chosen color scheme. In the editor an empty
  setting shows a hint; on the live store it renders nothing, so no empty
  band of section spacing is left behind.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase
-%}
{%- if section.settings.custom_liquid != blank or request.design_mode -%}
<div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} custom-liquid" id="section-{{ section.id }}">
  <div class="page-width custom-liquid__inner">
    {%- if section.settings.custom_liquid != blank -%}
      {{ section.settings.custom_liquid }}
    {%- elsif request.design_mode -%}
      <div class="empty-state custom-liquid__empty">
        {%- render 'icon', name: 'info', size: 40 -%}
        <p class="muted text-pretty">{{ 'sections.custom_liquid.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Liquid",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Add app snippets or other Liquid code to create advanced customizations."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}
