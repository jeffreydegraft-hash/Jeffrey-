{%- comment -%}
  Rich text: a column of blocks (eyebrow, heading, text, buttons) at a chosen
  measure, centred by default (apple.com statement blocks). Headings follow
  the type scale (.h1/.h2/.h3), text comes in lead / body / small, and the
  button blocks always render last, together in one .cta-row: a pill
  (primary or outline) and/or a "Learn more ›" text link with a chevron.
  "Remove bottom spacing" lets the column flow straight into the next
  section of the same colour. Centred copy long enough to run past three
  lines on a phone (APPLE-SPEC §6) turns the column left-aligned below
  750px; desktop keeps the chosen alignment. The eyebrow takes the hero
  size over a Large (h1) heading. Outside the editor a section without
  blocks renders nothing. Motion inventory: the shared reveal on each
  block (batch stagger from theme.js) and the pill/link press.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase
  if section.settings.flush_bottom
    assign padding_class = padding_class | append: ' section--bottom-none'
  endif

  assign width_class = ''
  case section.settings.width
    when 'narrow'
      assign width_class = ' page-width--narrow'
    when 'medium'
      assign width_class = ' page-width--medium'
  endcase

  assign cta_class = 'cta-row'
  if section.settings.alignment == 'left'
    assign cta_class = 'cta-row cta-row--start'
  endif

  assign buttons = section.blocks | where: 'type', 'button'

  # Phone line estimate: about 32 / 40 / 48 characters per line for lead / body / small
  assign long_class = ''
  assign eyebrow_class = 'eyebrow'
  for block in section.blocks
    if block.type == 'text'
      assign text_length = block.settings.text | strip_html | size
      case block.settings.size
        when 'lead'
          assign line_limit = 100
        when 'small'
          assign line_limit = 150
        else
          assign line_limit = 130
      endcase
      if text_length > line_limit
        assign long_class = ' rich-text--long'
      endif
    elsif block.type == 'heading' and block.settings.size == 'h1'
      assign eyebrow_class = 'eyebrow eyebrow--lg'
    endif
  endfor
  if section.settings.alignment != 'center'
    assign long_class = ''
  endif
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} rich-text rich-text--{{ section.settings.alignment }}{{ long_class }}" id="section-{{ section.id }}">
  <div class="page-width{{ width_class }}">
    {%- if section.blocks.size > 0 -%}
      <div class="rich-text__inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- if block.settings.text != blank -%}
                <p class="{{ eyebrow_class }} rich-text__eyebrow" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="{{ block.settings.size }} rich-text__heading" data-reveal {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
              {%- endif -%}
            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="rte rich-text__text rich-text__text--{{ block.settings.size }}" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if buttons.size > 0 -%}
          <div class="{{ cta_class }} rich-text__buttons" data-reveal>
            {%- for block in buttons -%}
              {%- if block.settings.label != blank -%}
                {%- if block.settings.style == 'link' -%}
                  <a
                    class="link link--chevron link--lg rich-text__link"
                    {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.label | escape -}}
                    {%- render 'icon', name: 'chevron-right', size: 16 -%}
                  </a>
                {%- else -%}
                  <a
                    class="btn btn--{{ block.settings.style }} btn--lg rich-text__button"
                    {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                    {{ block.shopify_attributes }}
                  >{{ block.settings.label | escape }}</a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="empty-state rich-text__empty">
        {%- render 'icon', name: 'info', size: 40 -%}
        <p class="muted text-pretty">{{ 'sections.general.add_blocks' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Rich text",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "flush_bottom",
      "label": "Remove bottom spacing",
      "info": "Lets the text flow straight into the next section when both use the same color scheme.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Our story"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Rooted in Scripture. Made in Texas."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "h1",
              "label": "Large"
            },
            {
              "value": "h2",
              "label": "Medium"
            },
            {
              "value": "h3",
              "label": "Small"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Anointing oil runs through Scripture, from the tabernacle in Exodus to the house at Bethany. We make oils faithful to that tradition, from the botanicals the Bible names.</p><p>Each blend is carefully blended, tested, and bottled in Richmond, Texas, on a base of olive-derived squalane. Natural, paraben-free, and vegan, made for prayer and made for skin.</p>"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "lead",
              "label": "Large"
            },
            {
              "value": "body",
              "label": "Regular"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ],
          "default": "body"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Read our story"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Primary button"
            },
            {
              "value": "secondary",
              "label": "Outline button"
            },
            {
              "value": "link",
              "label": "Text link with chevron"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
