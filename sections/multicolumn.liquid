{%- comment -%}
  Multicolumn: a centred header and 2–4 feature tiles (apple.com "why buy"
  tiles). As tiles (default) each column is a flat --c-surface panel with
  radius --r-tile and 40px padding; an optional image bleeds across the top
  of the tile, otherwise a 40px icon in the accent detail colour leads.
  Then an .h4 title, muted text and an optional "Learn more ›" link pinned
  to the bottom. Text is left- or centre-aligned per setting. With tiles off
  the columns sit flat on the section background with rounded images.
  Images show whole on the white photo ground by default ("Fit"), so a
  product shot is never cropped through its label (APPLE-SPEC §0.3);
  "Fill" crops to the frame for full-bleed photography. Columns wrap in a
  centred row, so a short last row sits in the middle. Outside the editor
  an empty section renders nothing. Motion inventory: the shared reveal
  (batch stagger from theme.js) and, on real pointers, a 3% image zoom
  when the column carries a link.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  case section.settings.image_ratio
    when 'square' or 'circle'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '3 / 2'
    else
      assign ratio = '4 / 5'
  endcase

  assign col_vw = 100 | divided_by: section.settings.columns
  assign image_sizes = '(min-width: 990px) ' | append: col_vw | append: 'vw, (min-width: 750px) 50vw, 100vw'

  assign align = section.settings.text_alignment | default: 'left'

  assign has_header = false
  if section.settings.heading != blank or section.settings.intro != blank
    assign has_header = true
  endif

  assign fit = section.settings.image_fit | default: 'contain'
-%}
{%- if has_header or section.blocks.size > 0 or request.design_mode -%}
<div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} multicolumn{% if section.settings.background_cards %} multicolumn--cards{% else %} multicolumn--flat{% endif %} multicolumn--ratio-{{ section.settings.image_ratio }} multicolumn--fit-{{ fit }} multicolumn--align-{{ align }}" id="section-{{ section.id }}">
  <div class="page-width">
    {%- if has_header -%}
      <header class="section__header section__header--center multicolumn__header" data-reveal>
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 multicolumn__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="lead lead--muted multicolumn__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="multicolumn__grid" role="list" style="--multicolumn-cols: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          <li class="multicolumn__item{% if section.settings.background_cards %} tile{% endif %}{% if block.settings.image != blank %} multicolumn__item--image{% endif %}" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="multicolumn__media">
                {%- render 'image', image: block.settings.image, sizes: image_sizes, widths: '300, 400, 500, 600, 800, 1000', class: 'multicolumn__img', loading: 'lazy', ratio: ratio, wrapper_class: 'multicolumn__figure' -%}
              </div>
            {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
              <span class="multicolumn__icon" aria-hidden="true">
                {%- render 'icon', name: block.settings.icon, size: 40 -%}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="h4 multicolumn__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte multicolumn__text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="link link--chevron multicolumn__link">
                {{- block.settings.link_label | escape -}}
                {%- render 'icon', name: 'chevron-right', size: 16 -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <div class="empty-state multicolumn__empty">
        {%- render 'icon', name: 'info', size: 40 -%}
        <p class="muted text-pretty">{{ 'sections.general.add_blocks' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Multicolumn",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Made with care, from the ground up."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape (3:2)" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "info": "Fit shows the whole image on a white ground, so product photos are never cropped. Fill crops the image to the frame.",
      "options": [
        { "value": "contain", "label": "Fit" },
        { "value": "cover", "label": "Fill" }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "background_cards",
      "label": "Show columns as tiles",
      "info": "Flat surface panels with rounded corners. Off, columns sit on the section background.",
      "default": true
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Column text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. When set, it replaces the icon."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" },
            { "value": "flask", "label": "Flask" },
            { "value": "olive", "label": "Olive" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "mail", "label": "Mail" },
            { "value": "phone", "label": "Phone" },
            { "value": "globe", "label": "Globe" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "clock", "label": "Clock" },
            { "value": "check", "label": "Check" },
            { "value": "info", "label": "Info" },
            { "value": "lock", "label": "Lock" },
            { "value": "quote", "label": "Quote" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Olive-derived squalane base"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every blend rests on 100% olive-derived squalane, a lipid similar to the squalene in human skin.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "drop",
            "title": "Olive-derived squalane base",
            "text": "<p>Every blend rests on 100% olive-derived squalane, a lipid similar to the squalene in human skin.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "flask",
            "title": "Polyphenol Alpha complex",
            "text": "<p>Our proprietary antioxidant-rich complex is derived entirely from natural botanical sources and formulated to support the skin's natural barrier.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "check",
            "title": "Natural, paraben-free, vegan",
            "text": "<p>Every ingredient is derived from biblical botanicals, and every bottle is natural, paraben-free, and vegan.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
