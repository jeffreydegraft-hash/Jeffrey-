{%- comment -%}
  Related products. Rendered empty on the first pass; <product-recommendations>
  (assets/product.js) fetches this section through the Product Recommendations
  API (data-url) and swaps in the rendered grid, or removes itself when there
  is nothing to show.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase
  assign limit = section.settings.products_to_show | default: 4
-%}
<product-recommendations
  class="related-products"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
  data-section-id="{{ section.id }}"
  data-empty-text="{{ 'sections.related_products.empty' | t }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section
      class="related-products__section section{{ padding_class }} color-{{ section.settings.color_scheme }}"
      id="section-{{ section.id }}"
      aria-labelledby="RelatedHeading-{{ section.id }}"
    >
      <div class="page-width">
        {%- if section.settings.heading != blank -%}
          <div class="section__header section__header--row related-products__header">
            <h2 class="h2 related-products__heading" id="RelatedHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          </div>
        {%- endif -%}
        <div class="product-recommendations__inner">
          <ul class="grid grid--4 grid--mobile-2 related-products__grid" role="list">
            {%- for recommendation in recommendations.products -%}
              <li class="related-products__item">
                {%- render 'card-product', product: recommendation, index: forloop.index0, sizes: '(min-width: 990px) 25vw, 50vw' -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </section>
  {%- endif -%}
</product-recommendations>

<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations come from Shopify's product recommendation algorithm, based on sales and collections."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
