{%- comment -%}
  Page hero (apple.com page header): a centred eyebrow, a big .h1 (falls
  back to the page title) and a one-line muted lead, on white with
  generous space above. The olive-branch ornament is retired: the
  show_ornament setting (id kept for templates) now shows a small leaf
  glyph in the accent detail colour, like the product glyph above an
  Apple page title. First thing on the page, so it enters with .enter
  (@starting-style in base.css, no JS) and never carries data-reveal.
  A long intro (over 100 characters) is set a step smaller on desktop and
  left-aligns the hero on phones, so a paragraph is never centred over
  more than three lines. "Remove bottom
  spacing" lets the next section continue the page without a double gap.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  if section.settings.heading != blank
    assign heading = section.settings.heading
  else
    assign heading = page.title | escape
  endif

  assign hero_class = 'page-hero page-hero--' | append: section.settings.alignment
  if section.settings.flush_bottom
    assign hero_class = hero_class | append: ' page-hero--flush'
  endif
  assign intro_length = section.settings.intro | size
  if intro_length > 100
    assign hero_class = hero_class | append: ' page-hero--long'
  endif
-%}
<div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} {{ hero_class }}" id="section-{{ section.id }}">
  <div class="page-width page-width--medium">
    <header class="page-hero__inner">
      {%- if section.settings.show_ornament -%}
        <span class="page-hero__glyph enter" style="--i: 0;" aria-hidden="true">
          {%- render 'icon', name: 'leaf', size: 28 -%}
        </span>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--lg page-hero__eyebrow enter" style="--i: 1;">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h1 class="h1 page-hero__heading enter" style="--i: 2;">{{ heading }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="lead lead--muted page-hero__intro enter" style="--i: 3;">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>
  </div>
</div>

{% schema %}
{
  "name": "Page hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About Mount of Olives"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_ornament",
      "label": "Show leaf glyph",
      "info": "A small leaf icon in the accent colour above the eyebrow.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "flush_bottom",
      "label": "Remove bottom spacing",
      "info": "Lets the section below continue the page without a double gap.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Page hero"
    }
  ]
}
{% endschema %}
