{%- comment -%}
  Address book. One card per address (default badge, edit / delete), an
  "add" panel under the header and an inline edit panel inside each card.
  Panels toggle through customer.js (.is-open + aria-expanded); a panel
  whose form came back with errors stays open (the [data-form-errors]
  rule in CSS covers the moment before JS runs). Without JS every panel
  is visible. Country → province selects are wired by
  Shopify.CountryProvinceSelector from shopify_common.js; delete posts
  through Shopify.postLink after a confirm.
{%- endcomment -%}
{%- liquid
  assign spacing_class = ''
  case section.settings.spacing
    when 'tight'
      assign spacing_class = ' section--tight'
    when 'none'
      assign spacing_class = ' section--none'
  endcase
-%}
<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
<script src="{{ 'customer.js' | asset_url }}" defer="defer"></script>

<div class="section{{ spacing_class }} color-{{ section.settings.color_scheme }} main-addresses addresses" id="section-{{ section.id }}">
  <div class="page-width page-width--medium">
    <div class="addresses__inner" data-customer-addresses>
      <a href="{{ routes.account_url }}" class="link link--arrow customer-page__back">
        {%- render 'icon', name: 'arrow-left', size: 18 -%}
        {{ 'customer.account.return' | t }}
      </a>

      <header class="customer-page__head">
        <div class="customer-page__heading">
          <h1 class="h1">{{ 'customer.addresses.title' | t }}</h1>
          <p class="muted">{{ 'customer.addresses.count' | t: count: customer.addresses_count }}</p>
        </div>
        <div class="customer-page__actions">
          <button type="button" class="btn btn--primary btn--sm" data-address-toggle="#AddAddress" aria-controls="AddAddress" aria-expanded="false">
            {%- render 'icon', name: 'plus', size: 18 -%}
            {{ 'customer.addresses.add_new' | t }}
          </button>
        </div>
      </header>

      <div id="AddAddress" class="address-form addresses__add" data-address-form tabindex="-1">
        <h2 class="h4 address-form__title" id="AddAddressHeading">{{ 'customer.addresses.add_new' | t }}</h2>
        {%- form 'customer_address', customer.new_address, class: 'customer-form', aria-labelledby: 'AddAddressHeading' -%}
          {%- render 'customer-form-errors', form: form, prefix: 'AddressFormNew' -%}
          {%- render 'customer-address-fields', form: form, suffix: 'New' -%}
          <div class="customer-form__actions customer-form__actions--row">
            <button type="submit" class="btn btn--primary">{{ 'customer.addresses.add' | t }}</button>
            <button type="button" class="btn btn--ghost" data-address-cancel>{{ 'customer.addresses.cancel' | t }}</button>
          </div>
        {%- endform -%}
      </div>

      {%- paginate customer.addresses by 12 -%}
        {%- if customer.addresses.size > 0 -%}
          <ul class="addresses__list grid grid--2" role="list">
            {%- for address in customer.addresses -%}
              {%- liquid
                assign is_default = false
                if address == customer.default_address
                  assign is_default = true
                endif
                assign suffix = '_' | append: address.id
                assign panel_id = 'EditAddress' | append: suffix
                assign heading_id = 'EditAddressHeading' | append: suffix
                assign prefix = 'AddressForm' | append: suffix
              -%}
              <li class="address-card{% if is_default %} address-card--default{% endif %}" data-address>
                <div class="address-card__body">
                  {%- if is_default -%}
                    <span class="badge badge--outline address-card__badge">{{ 'customer.addresses.default' | t }}</span>
                  {%- endif -%}
                  <address class="address-card__address">{{ address | format_address }}</address>
                </div>
                <div class="address-card__actions">
                  <button
                    type="button"
                    class="btn btn--secondary btn--sm"
                    data-address-toggle="#{{ panel_id }}"
                    aria-controls="{{ panel_id }}"
                    aria-expanded="false"
                    aria-label="{{ 'customer.addresses.edit_address_label' | t: index: forloop.index | escape }}"
                  >
                    {{- 'customer.addresses.edit' | t -}}
                  </button>
                  <button
                    type="button"
                    class="btn btn--ghost btn--sm"
                    data-address-delete="{{ address.url }}"
                    data-confirm-message="{{ 'customer.addresses.delete_confirm' | t | escape }}"
                    aria-label="{{ 'customer.addresses.delete_address_label' | t: index: forloop.index | escape }}"
                  >
                    {{- 'customer.addresses.delete' | t -}}
                  </button>
                </div>
                <div id="{{ panel_id }}" class="address-form address-card__form" data-address-form tabindex="-1">
                  <h2 class="h4 address-form__title" id="{{ heading_id }}">{{ 'customer.addresses.edit_address' | t }}</h2>
                  {%- form 'customer_address', address, class: 'customer-form', aria-labelledby: heading_id -%}
                    {%- render 'customer-form-errors', form: form, prefix: prefix -%}
                    {%- render 'customer-address-fields', form: form, suffix: suffix -%}
                    <div class="customer-form__actions customer-form__actions--row">
                      <button type="submit" class="btn btn--primary">{{ 'customer.addresses.update' | t }}</button>
                      <button type="button" class="btn btn--ghost" data-address-cancel>{{ 'customer.addresses.cancel' | t }}</button>
                    </div>
                  {%- endform -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <div class="empty-state addresses__empty">
            {%- render 'icon', name: 'map-pin', size: 36 -%}
            <h2 class="h4">{{ 'customer.addresses.none' | t }}</h2>
            <p class="muted text-pretty">{{ 'customer.addresses.none_body' | t }}</p>
            <button type="button" class="btn btn--primary" data-address-toggle="#AddAddress" aria-controls="AddAddress" aria-expanded="false">{{ 'customer.addresses.add_new' | t }}</button>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Addresses",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
