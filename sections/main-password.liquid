{%- comment -%}
  Password page (layout/password.liquid): a full-height (100svh) centered
  column. Logo or serif wordmark, ornament, eyebrow, heading, body, the
  storefront password form (16px input, 48px row), an optional newsletter
  form for people without a password, social icons (hidden when no links
  are set), the store-owner link and the "powered by Shopify" line. Text
  enters with .enter (@starting-style, no JS).
{%- endcomment -%}
{%- liquid
  assign logo_alt = settings.logo.alt | default: shop.name | escape
  assign logo_width_2x = settings.logo_width | times: 2
-%}
{%- capture shopify_link -%}
  <a href="https://www.shopify.com" class="link link--underline" target="_blank" rel="noopener nofollow">Shopify</a>
{%- endcapture -%}
<div class="color-{{ section.settings.color_scheme }} main-password" id="section-{{ section.id }}">
  <div class="main-password__inner">
    <div class="main-password__brand enter" style="--i: 0;">
      {%- if settings.logo != blank -%}
        <div class="main-password__logo" style="--logo-width: {{ settings.logo_width }}px;">
          {{ settings.logo | image_url: width: logo_width_2x | image_tag: width: settings.logo_width, alt: logo_alt, loading: 'eager' }}
        </div>
      {%- else -%}
        <p class="main-password__wordmark">{{ shop.name }}</p>
      {%- endif -%}
    </div>

    <div class="main-password__card">
      <div class="ornament main-password__ornament enter" style="--i: 1;" aria-hidden="true">
        {%- render 'icon', name: 'leaf', size: 20 -%}
      </div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow main-password__eyebrow enter" style="--i: 2;">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="h1 main-password__heading enter" style="--i: 3;">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="lead main-password__body enter" style="--i: 4;">{{ section.settings.body | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- form 'storefront_password', class: 'password-form main-password__form enter' -%}
        <h2 class="visually-hidden">{{ 'general.password_page.login_form_heading' | t }}</h2>
        <div class="inline-form">
          <div class="field{% if form.errors %} field--error{% endif %}">
            <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
            <input
              class="field__input"
              type="password"
              id="Password"
              name="password"
              autocomplete="current-password"
              placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="Password-error"
              {% endif %}
            >
          </div>
          <button type="submit" class="btn btn--primary">{{ 'general.password_page.login_form_submit' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="field__error main-password__error" id="Password-error" role="alert">
            {%- render 'icon', name: 'error', size: 16 -%}
            <span>{{ 'general.password_page.login_form_error' | t }}</span>
          </p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.show_newsletter -%}
        <div class="main-password__newsletter enter" style="--i: 6;">
          {%- form 'customer', class: 'main-password__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-status form-status--success" role="status" tabindex="-1" autofocus>
                {%- render 'icon', name: 'success', size: 20 -%}
                <span>{{ 'newsletter.success' | t }}</span>
              </p>
            {%- else -%}
              <p class="main-password__newsletter-label" id="PasswordNewsletter-label">{{ 'footer.newsletter_heading' | t }}</p>
              <div class="inline-form">
                <div class="field{% if form.errors %} field--error{% endif %}">
                  <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
                  <input
                    class="field__input"
                    type="email"
                    id="PasswordNewsletter-email"
                    name="contact[email]"
                    autocomplete="email"
                    spellcheck="false"
                    autocapitalize="off"
                    placeholder="{{ 'newsletter.placeholder' | t }}"
                    required
                    aria-describedby="PasswordNewsletter-label{% if form.errors %} PasswordNewsletter-error{% endif %}"
                    {% if form.errors %}aria-invalid="true"{% endif %}
                  >
                </div>
                <button type="submit" class="btn btn--secondary">{{ 'newsletter.button_label' | t }}</button>
              </div>
              {%- if form.errors -%}
                <p class="field__error main-password__error" id="PasswordNewsletter-error" role="alert">
                  {%- render 'icon', name: 'error', size: 16 -%}
                  <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
                </p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {%- render 'social-icons', class: 'main-password__social' -%}
      {%- endif -%}
    </div>

    <footer class="main-password__footer enter" style="--i: 7;">
      <p class="small">{{ 'general.password_page.admin_link_html' | t }}</p>
      <p class="caption">{{ 'general.password_page.powered_by_shopify_html' | t: shopify: shopify_link }}</p>
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Handcrafted biblical anointing oils"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We will open soon"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The shop is being prepared. If you have a password, enter it below. Otherwise leave your email and we will write when we open."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email sign-up",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Links come from Theme settings → Social media.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
