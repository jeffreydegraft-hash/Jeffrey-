{%- comment -%}
  Password page (layout/password.liquid), Apple "coming soon": a full
  height (100svh) centred column. The merchant's own logo (snippets/
  brand-logo.liquid, used intact; the store name as a 21px semibold
  wordmark only when no logo is set) at the top, then the eyebrow, a big .h1, a muted lead, the storefront
  password form as an inline 52px field + primary pill, and a compact
  email sign-up (quiet label, field + gray pill) for people without a
  password. Social icons hide when no links are set; the store-owner and
  "powered by Shopify" lines close the page. No dividers, no ornament.
  Text enters with .enter (@starting-style, no JS). On phones (≤480px)
  each field and its pill stack (base.css .inline-form). A body over 100
  characters is set a step smaller (--long) so the centred lead stays
  within three lines. The owner / Shopify links are accent text links.
{%- endcomment -%}
{%- liquid
  assign body_length = section.settings.body | size
  # Logo tone follows the scheme (as in the footer): a dark ground asks
  # brand-logo for the merchant's light version.
  assign logo_tone = 'light'
  assign scheme_bg = section.settings.color_scheme.settings.background
  if scheme_bg != blank
    assign scheme_brightness = scheme_bg | color_brightness
    if scheme_brightness < 128
      assign logo_tone = 'dark'
    endif
  else
    assign scheme_id = section.settings.color_scheme.id | default: section.settings.color_scheme
    if scheme_id == 'scheme-3' or scheme_id == 'scheme-4'
      assign logo_tone = 'dark'
    endif
  endif
  assign password_class = ''
  if body_length > 100
    assign password_class = ' main-password--long'
  endif
-%}
{%- capture shopify_link -%}
  <a href="https://www.shopify.com" class="link link--underline" target="_blank" rel="noopener nofollow">Shopify</a>
{%- endcapture -%}
<div class="color-{{ section.settings.color_scheme }} main-password{{ password_class }}" id="section-{{ section.id }}">
  <div class="main-password__inner">
    <div class="main-password__brand enter" style="--i: 0;">
      {%- render 'brand-logo', tone: logo_tone, class: 'main-password__logo', wordmark_class: 'main-password__wordmark', priority: true -%}
    </div>

    <div class="main-password__card">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--lg main-password__eyebrow enter" style="--i: 1;">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="h1 main-password__heading enter" style="--i: 2;">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="lead lead--muted main-password__body enter" style="--i: 3;">{{ section.settings.body | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- form 'storefront_password', class: 'password-form main-password__form enter' -%}
        <h2 class="visually-hidden">{{ 'general.password_page.login_form_heading' | t }}</h2>
        <div class="inline-form main-password__row">
          <div class="field{% if form.errors %} field--error{% endif %}">
            <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
            <input
              class="field__input"
              type="password"
              id="Password"
              name="password"
              autocomplete="current-password"
              placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="Password-error"
              {% endif %}
            >
          </div>
          <button type="submit" class="btn btn--primary btn--lg">{{ 'general.password_page.login_form_submit' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="field__error main-password__error" id="Password-error" role="alert">
            {%- render 'icon', name: 'error', size: 16 -%}
            <span>{{ 'general.password_page.login_form_error' | t }}</span>
          </p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.show_newsletter -%}
        <div class="main-password__newsletter enter" style="--i: 5;">
          {%- form 'customer', class: 'main-password__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-status form-status--success" role="status" tabindex="-1" autofocus>
                {%- render 'icon', name: 'success', size: 20 -%}
                <span>{{ 'newsletter.success' | t }}</span>
              </p>
            {%- else -%}
              <p class="main-password__newsletter-label" id="PasswordNewsletter-label">{{ 'footer.newsletter_heading' | t }}</p>
              <div class="inline-form main-password__row">
                <div class="field{% if form.errors %} field--error{% endif %}">
                  <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
                  <input
                    class="field__input"
                    type="email"
                    id="PasswordNewsletter-email"
                    name="contact[email]"
                    autocomplete="email"
                    spellcheck="false"
                    autocapitalize="off"
                    placeholder="{{ 'newsletter.placeholder' | t }}"
                    required
                    aria-describedby="PasswordNewsletter-label{% if form.errors %} PasswordNewsletter-error{% endif %}"
                    {% if form.errors %}aria-invalid="true"{% endif %}
                  >
                </div>
                <button type="submit" class="btn btn--surface btn--lg">{{ 'newsletter.button_label' | t }}</button>
              </div>
              {%- if form.errors -%}
                <p class="field__error main-password__error" id="PasswordNewsletter-error" role="alert">
                  {%- render 'icon', name: 'error', size: 16 -%}
                  <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
                </p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {%- render 'social-icons', class: 'main-password__social' -%}
      {%- endif -%}
    </div>

    <footer class="main-password__footer enter" style="--i: 6;">
      <p class="small">{{ 'general.password_page.admin_link_html' | t }}</p>
      <p class="caption">{{ 'general.password_page.powered_by_shopify_html' | t: shopify: shopify_link }}</p>
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Handcrafted biblical anointing oils"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We will open soon"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The shop is being prepared. If you have a password, enter it below. Otherwise leave your email and we will write when we open."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email sign-up",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Links come from Theme settings → Social media.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
