{%- comment -%}
  Blog index (Apple Newsroom): a centred .h1 (the blog title, "The
  Anointing Journal") and muted lead, then article tiles
  (snippets/card-article.liquid): 1-up on phones, 2-up ≥750px, 3-up
  ≥990px. On page one without a tag filter the newest post can be the
  "top story": a full-row tile with the image left and the text right
  (≥750px). Twelve posts per page with the shared pagination; a blog with
  no posts gets a designed, text-only empty state (no glyph). A post
  without an image becomes a text-only tile that also carries its excerpt,
  so it never reads as an empty gray card beside the image tiles. Short
  last rows centre. A long intro left-aligns the
  header on phones (never centre more than three lines). Tiles reveal on scroll with an --i
  stagger; the header stays put.
{%- endcomment -%}
{%- liquid
  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  assign header_class = ''
  assign intro_length = section.settings.intro | size
  if intro_length > 100
    assign header_class = ' main-blog__header--long'
  endif
-%}
{%- paginate blog.articles by 12 -%}
  <div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} main-blog" id="section-{{ section.id }}">
    <div class="page-width">
      <header class="section__header section__header--center main-blog__header{{ header_class }}">
        <h1 class="h1 main-blog__title enter">{{ blog.title | escape }}</h1>
        {%- if section.settings.intro != blank -%}
          <p class="lead lead--muted main-blog__intro enter" style="--i: 1;">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
        {%- if current_tags -%}
          {%- assign tag_list = current_tags | join: ', ' -%}
          <p class="main-blog__tagged enter" style="--i: 2;">
            <span class="badge main-blog__tag">{{ 'general.meta.tags' | t: tags: tag_list }}</span>
            <a href="{{ blog.url }}" class="link link--chevron">
              {{- 'blogs.general.all_posts' | t -}}
              {%- render 'icon', name: 'chevron-right', size: 16 -%}
            </a>
          </p>
        {%- endif -%}
      </header>

      {%- if blog.articles.size > 0 -%}
        <ul class="main-blog__grid" id="BlogArticles" role="list">
          {%- for article in blog.articles -%}
            {%- liquid
              assign featured = false
              if section.settings.show_featured and forloop.first and paginate.current_page == 1 and current_tags == blank
                assign featured = true
              endif
              assign show_excerpt = false
              if section.settings.show_excerpt
                if featured or article.image == blank
                  assign show_excerpt = true
                endif
              endif
            -%}
            {%- assign stagger = forloop.index0 | modulo: 8 -%}
            <li class="main-blog__item{% if featured %} main-blog__item--featured{% endif %}" data-reveal style="--i: {{ stagger }};">
              {%- render 'card-article',
                article: article,
                show_date: section.settings.show_date,
                show_author: section.settings.show_author,
                show_excerpt: show_excerpt,
                featured: featured
              -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- render 'pagination', paginate: paginate, anchor: '#BlogArticles' -%}
      {%- else -%}
        <div class="empty-state main-blog__empty">
          <h2 class="h3">{{ 'blogs.general.empty' | t }}</h2>
          <p class="muted text-pretty">{{ 'blogs.general.empty_body' | t }}</p>
          {%- if current_tags -%}
            <a href="{{ blog.url }}" class="btn btn--primary">{{ 'blogs.general.all_posts' | t }}</a>
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.shop_now' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "Notes on the botanicals of Scripture, a brief history of anointing oil in the church, and why not all olives are created equal."
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Feature the newest post",
      "info": "The first post on page one becomes a full-width top story.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpts",
      "info": "On the top story and on posts without an image. Other tiles stay title and date only, like Apple Newsroom.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
