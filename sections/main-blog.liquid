{%- paginate blog.articles by 12 -%}
<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="page-head" style="padding-top:2rem">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="h2">{{ blog.title }}</h1>
    </div>
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <article class="post-card">
          <a href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </a>
          <p class="post-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</p>
          <h3 class="h3"><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          <a class="link link--arrow" href="{{ article.url }}">Read</a>
        </article>
      {%- else -%}
        <div class="empty"><p class="lead">No posts yet. Check back soon.</p></div>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Blog",
  "settings": [ { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" } ]
}
{% endschema %}
