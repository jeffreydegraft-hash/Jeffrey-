{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="section" id="shop-oils" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a class="link-arrow" href="{{ col.url | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>
    <div class="oil-grid">
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'oil-card', product: product %}
      {%- else -%}
        <p class="muted">Add products to this collection to fill the grid.</p>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Oil grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Eight oils. Eight passages." },
    { "type": "text", "id": "text", "label": "Text", "default": "Every blend carries a verse on its label. 4 oz glass bottles." },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "Shop all" }
  ],
  "presets": [ { "name": "Oil grid" } ]
}
{% endschema %}
