{%- comment -%}
  Scripture quote: a short eyebrow between two gold hairlines, a large serif
  italic verse (30ch wide), and the reference in gold small caps. Centred by
  default, or set left to sit against the gutter.
  Motion: the whole figure reveals once on scroll (data-reveal).
{%- endcomment -%}
{%- liquid
  assign alignment = section.settings.alignment | default: 'center'

  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase
-%}
{%- if section.settings.quote != blank -%}
  <div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} scripture-quote scripture-quote--{{ alignment }}" id="section-{{ section.id }}">
    <div class="page-width">
      <figure class="scripture scripture-quote__figure" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <div class="ornament{% if alignment == 'left' %} ornament--left{% endif %} scripture-quote__ornament">
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          </div>
        {%- endif -%}
        <blockquote class="scripture-quote__blockquote">
          <p class="scripture__quote scripture-quote__text">{{ section.settings.quote | escape | newline_to_br }}</p>
        </blockquote>
        {%- if section.settings.reference != blank -%}
          <figcaption class="scripture__ref scripture-quote__ref">{{ section.settings.reference | escape }}</figcaption>
        {%- endif -%}
      </figure>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Scripture quote",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From Scripture"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "info": "Quotation marks are added for you.",
      "default": "Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over."
    },
    {
      "type": "text",
      "id": "reference",
      "label": "Reference",
      "default": "Psalm 23:5"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Scripture quote"
    }
  ]
}
{% endschema %}
