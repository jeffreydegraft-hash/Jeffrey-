{%- comment -%}
  Scripture quote as an Apple "statement": an optional eyebrow, the verse set
  as a headline (system font, semibold, upright, curly quotes added by
  .scripture__quote), and the reference below it as a quiet eyebrow. No
  ornament lines; the generous padding does the separating. Centred by
  default, or set left to sit against the gutter.
  Motion: the whole figure reveals once on scroll (data-reveal).
{%- endcomment -%}
{%- liquid
  assign alignment = section.settings.alignment | default: 'center'

  comment
    The curly quotes are added by .scripture__quote; drop any the merchant
    typed so the verse never shows two pairs.
  endcomment
  assign quote = section.settings.quote | strip
  assign first_char = quote | slice: 0
  if first_char == '"' or first_char == '“' or first_char == '‘' or first_char == "'"
    assign quote = quote | slice: 1, quote.size | strip
  endif
  assign last_char = quote | slice: -1
  if last_char == '"' or last_char == '”' or last_char == '’' or last_char == "'"
    assign quote_len = quote.size | minus: 1
    assign quote = quote | slice: 0, quote_len | strip
  endif

  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase
-%}
{%- if quote != blank -%}
  <div class="section{{ padding_class }} color-{{ section.settings.color_scheme }} scripture-quote scripture-quote--{{ alignment }}" id="section-{{ section.id }}">
    <div class="page-width">
      <figure class="scripture scripture-quote__figure" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow scripture-quote__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <blockquote class="scripture-quote__blockquote">
          <p class="scripture__quote scripture-quote__text">{{ quote | escape | newline_to_br }}</p>
        </blockquote>
        {%- if section.settings.reference != blank -%}
          <figcaption class="eyebrow eyebrow--ink scripture-quote__ref">{{ section.settings.reference | escape }}</figcaption>
        {%- endif -%}
      </figure>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Scripture quote",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional short label above the verse."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "info": "Quotation marks are added for you.",
      "default": "Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over."
    },
    {
      "type": "text",
      "id": "reference",
      "label": "Reference",
      "default": "Psalm 23:5"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Scripture quote"
    }
  ]
}
{% endschema %}
