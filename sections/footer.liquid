<footer class="footer" style="--footer-cols: {{ section.blocks.size | at_least: 1 }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        {%- if settings.logo != blank -%}
          <a href="{{ routes.root_url }}">{{ settings.logo | image_url: width: 400 | image_tag: width: settings.logo_width, alt: shop.name, loading: 'lazy' }}</a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="header__wordmark">{{ shop.name }}</a>
        {%- endif -%}
        {%- if settings.tagline != blank -%}
          <p class="footer__tagline">“{{ settings.tagline }}”</p>
          <p class="footer__tagline-ref">{{ settings.tagline_ref }}</p>
        {%- endif -%}
        {%- if section.settings.brand_text != blank -%}<div class="footer__text">{{ section.settings.brand_text }}</div>{%- endif -%}
        <div style="margin-top:1.25rem">{% render 'social-icons' %}</div>
      </div>
      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}<h3 class="footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}<h3 class="footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              <div class="footer__text">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}<h3 class="footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              <div class="footer__text footer__newsletter">
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
                {%- form 'customer', id: 'FooterNewsletter' -%}
                  {%- if form.posted_successfully? -%}
                    <p class="form-success">Thank you. You're on the list.</p>
                  {%- else -%}
                    {%- if form.errors -%}<p class="form-errors">{{ form.errors | default_errors }}</p>{%- endif -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div style="display:flex;gap:.5rem">
                      <input class="input" type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address">
                      <button type="submit" class="btn btn--primary btn--small">Join</button>
                    </div>
                  {%- endif -%}
                {%- endform -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="footer__bottom">
      <div>
        <p style="margin:0 0 .5rem">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
        {%- if shop.policies.size > 0 -%}
          <ul class="footer__policies">
            {%- for policy in shop.policies -%}
              {%- if policy.body != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if section.settings.show_payments -%}
        <div class="footer__payments" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "richtext", "id": "brand_text", "label": "Brand text", "default": "<p>Scripture-inspired anointing oils, hand-blended in small batches for prayer, worship, healing and consecration.</p>" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" }, { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" } ] },
    { "type": "text", "name": "Text column", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" }, { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an oil or an order? We'd love to hear from you.</p>" } ] },
    { "type": "newsletter", "name": "Newsletter", "limit": 1, "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Stay anointed" }, { "type": "text", "id": "text", "label": "Text", "default": "New blends, scripture reflections and member-only offers." } ] }
  ]
}
{% endschema %}
