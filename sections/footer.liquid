{%- comment -%}
  Footer. A brand column (logo or serif wordmark, tagline, social icons) plus
  up to four block columns, then a bottom bar: country/language selectors,
  payment icons, copyright, policy links and the brand disclaimer.
  Dark olive (scheme-3) by default; every colour comes from the scheme tokens.
{%- endcomment -%}
{%- liquid
  assign year = 'now' | date: '%Y'

  assign footer_logo = section.settings.logo
  if footer_logo == blank
    assign footer_logo = settings.logo
  endif
  assign logo_width = settings.logo_width | default: 140
  assign logo_width_2x = logo_width | times: 2

  comment
    One grid track per block. The newsletter column is weighted so the inline
    form has room; everything else shares equally.
  endcomment
  assign cols = ''
  for block in section.blocks
    if block.type == 'newsletter'
      assign cols = cols | append: ' minmax(0, 1.5fr)'
    else
      assign cols = cols | append: ' minmax(0, 1fr)'
    endif
  endfor
  assign cols = cols | strip

  assign show_localization = false
  if section.settings.show_localization
    if localization.available_countries.size > 1 or localization.available_languages.size > 1
      assign show_localization = true
    endif
  endif

  assign show_payment = false
  if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0
    assign show_payment = true
  endif

  assign policy_count = 0
  if section.settings.show_policies
    for policy in shop.policies
      if policy != blank
        assign policy_count = policy_count | plus: 1
      endif
    endfor
  endif
-%}

<footer class="footer color-{{ section.settings.color_scheme }} footer--padding-{{ section.settings.padding }}" id="footer-{{ section.id }}" role="contentinfo">
  <div class="page-width">
    <div class="footer__grid{% if section.blocks.size == 0 %} footer__grid--brand-only{% endif %}"{% if cols != blank %} style="--footer-cols: {{ cols }};"{% endif %}>

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="footer__brand">
        {%- if footer_logo != blank -%}
          <a href="{{ routes.root_url }}" class="footer__logo" style="--footer-logo-width: {{ logo_width }}px;" aria-label="{{ 'accessibility.logo' | t: shop: shop.name }}">
            {{ footer_logo | image_url: width: logo_width_2x | image_tag: class: 'footer__logo-img', width: logo_width, alt: shop.name, loading: 'lazy' }}
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="footer__wordmark" aria-label="{{ 'accessibility.logo' | t: shop: shop.name }}">{{ shop.name | escape }}</a>
        {%- endif -%}

        {%- if settings.brand_tagline != blank -%}
          <p class="footer__tagline">{{ settings.brand_tagline | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          {%- render 'social-icons', class: 'footer__social' -%}
        {%- endif -%}
      </div>

      {%- comment -%} Block columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="footer__col footer__col--{{ block.type | replace: '_', '-' }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- when 'link_list' -%}
              {%- liquid
                assign menu = block.settings.menu
                assign heading = block.settings.heading | default: menu.title
              -%}
              {%- if heading != blank -%}
                <h2 class="footer__heading eyebrow">{{ heading | escape }}</h2>
              {%- endif -%}
              {%- if menu.links.size > 0 -%}
                <ul class="footer__links" role="list">
                  {%- for link in menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="link footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif request.design_mode -%}
                <p class="footer__hint caption">{{ 'footer.menu_hint' | t }}</p>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading eyebrow">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer__text">{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'contact' -%}
              {%- liquid
                assign phone_href = settings.brand_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
              -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading eyebrow">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if settings.brand_email != blank or settings.brand_phone != blank or settings.brand_address != blank -%}
                <address class="footer__contact">
                  {%- if settings.brand_email != blank -%}
                    <a href="mailto:{{ settings.brand_email | escape }}" class="link footer__link footer__contact-line">{{ settings.brand_email | escape }}</a>
                  {%- endif -%}
                  {%- if settings.brand_phone != blank -%}
                    <a href="tel:{{ phone_href | escape }}" class="link footer__link footer__contact-line">{{ settings.brand_phone | escape }}</a>
                  {%- endif -%}
                  {%- if settings.brand_address != blank -%}
                    <p class="footer__address footer__contact-line">{{ settings.brand_address | escape | newline_to_br }}</p>
                  {%- endif -%}
                </address>
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- liquid
                assign form_id = 'FooterNewsletter-' | append: section.id | append: '-' | append: block.id
                assign input_id = form_id | append: '-email'
                assign button_label = block.settings.button_label
                if button_label == blank
                  assign button_label = 'newsletter.button_label' | t
                endif
              -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading eyebrow" id="{{ form_id }}-heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- form 'customer', id: form_id, class: 'footer__newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-status form-status--success enter" id="{{ form_id }}-success" role="status" tabindex="-1" autofocus>
                    {%- render 'icon', name: 'success', size: 18 -%}
                    <span>{{ 'newsletter.success' | t }}</span>
                  </p>
                {%- else -%}
                  <div class="inline-form">
                    <div class="field">
                      <label class="field__label visually-hidden" for="{{ input_id }}">{{ 'newsletter.label' | t }}</label>
                      <input
                        id="{{ input_id }}"
                        type="email"
                        name="contact[email]"
                        class="field__input"
                        value="{{ form.email | escape }}"
                        placeholder="{{ 'newsletter.placeholder' | t }}"
                        autocomplete="email"
                        autocorrect="off"
                        autocapitalize="off"
                        spellcheck="false"
                        inputmode="email"
                        required
                        aria-required="true"
                        {% if form.errors %}
                          aria-invalid="true"
                          aria-describedby="{{ form_id }}-error"
                          autofocus
                        {% endif %}
                      >
                    </div>
                    <button type="submit" class="btn btn--gold footer__newsletter-button" name="commit">{{ button_label | escape }}</button>
                  </div>
                  {%- if form.errors -%}
                    <p class="form-status form-status--error enter" id="{{ form_id }}-error" role="alert">
                      {%- render 'icon', name: 'error', size: 18 -%}
                      <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
                    </p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="footer__bottom">
      {%- if show_localization or show_payment -%}
        <div class="footer__bottom-row footer__tools">
          {%- if show_localization -%}
            <div class="footer__localization">
              {%- render 'localization-form', id: 'FooterLocalization' -%}
            </div>
          {%- endif -%}
          {%- if show_payment -%}
            <div class="footer__payment">
              <h2 class="visually-hidden">{{ 'footer.payment_methods' | t }}</h2>
              <ul class="footer__payment-list" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="footer__bottom-row footer__legal">
        <p class="footer__copyright">{{ 'footer.copyright' | t: year: year, shop: shop.name }}</p>
        {%- if policy_count > 0 -%}
          <nav class="footer__policies-nav" aria-label="{{ 'footer.policies' | t }}">
            <ul class="footer__policies" role="list">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a href="{{ policy.url }}" class="link footer__policy-link">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>

      {%- if settings.brand_disclaimer != blank -%}
        <p class="footer__disclaimer caption">{{ settings.brand_disclaimer | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "max_blocks": 4,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Brand column"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo",
      "info": "Optional. Use a light version of the logo for dark color schemes. Falls back to the theme logo, then to the store name as a serif wordmark."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Links are set in Theme settings → Social media. Networks without a link are hidden.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "The tagline, contact details and disclaimer are set in Theme settings → Brand."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country and language selectors",
      "info": "Appears only when more than one country or language is enabled in Markets.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "info": "Policies are managed in Settings → Policies.",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Top padding",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "default", "label": "Default" },
        { "value": "airy", "label": "Airy" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave empty to use the menu's title."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Handcrafted biblical anointing oils. Made in Richmond, Texas.</p>"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "paragraph",
          "content": "Email, phone and address come from Theme settings → Brand."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Letters from the studio"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>New blends, notes from the Anointing Journal, and a word of encouragement now and then. We write only when we have something worth saying.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Subscribe"
        },
        {
          "type": "paragraph",
          "content": "Subscribers are added as customers tagged “newsletter”."
        }
      ]
    }
  ]
}
{% endschema %}
