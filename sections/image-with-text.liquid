{%- comment -%}
  Image with text: big rounded media (--r-tile) beside a short text column:
  eyebrow, h2, 17px muted body, "Learn more ›" link (or a pill button).
  12 columns at 990px and up (media 7/12, text 5/12 inset from the media),
  stacked below. The media can lead or follow; the text can sit at the top,
  middle or bottom of the media's height.
  Placeholder: a neutral olive-oil bottle drawn in tokens on the tile surface.
  Motion: media and text reveal on scroll (data-reveal), text one step later.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'image_first'
  assign layout_class = layout | replace: '_', '-'
  assign ratio = section.settings.image_ratio | default: '4 / 5'
  assign vertical_align = section.settings.vertical_align | default: 'center'
  assign button_style = section.settings.button_style | default: 'link'

  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  assign show_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_button = true
  endif
-%}
<div
  class="section{{ padding_class }} color-{{ section.settings.color_scheme }} image-with-text image-with-text--{{ layout_class }} image-with-text--align-{{ vertical_align }}"
  id="section-{{ section.id }}"
>
  <div class="page-width">
    <div class="image-with-text__grid">
      <div class="image-with-text__media media{% if section.settings.image == blank %} image-with-text__media--illustration{% endif %}" data-reveal style="--ratio: {{ ratio }}; --i: 0;">
        {%- if section.settings.image != blank -%}
          {%- render 'image', image: section.settings.image, sizes: '(min-width: 990px) 58vw, 100vw', widths: '400, 600, 800, 1200, 1600, 2000', loading: 'lazy', class: 'image-with-text__img' -%}
        {%- else -%}
          {%- comment -%} Designed fallback until a photo is chosen: a neutral bottle in theme tokens {%- endcomment -%}
          <svg class="bottle bottle--neutral image-with-text__bottle" viewBox="0 0 240 520" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
            <ellipse class="bottle__shadow" cx="120" cy="508" rx="92" ry="9"/>
            <path class="bottle__glass" d="M96 96h48v14c0 22 64 30 64 70v290c0 20-14 32-34 32H66c-20 0-34-12-34-32V180c0-40 64-48 64-70V96Z"/>
            <path class="bottle__oil" d="M40 214c26 8 54 10 80 10s54-2 80-10v256c0 15-10 24-26 24H66c-16 0-26-9-26-24V214Z"/>
            <rect class="bottle__shine" x="46" y="196" width="10" height="276" rx="5"/>
            <rect class="bottle__label" x="52" y="262" width="136" height="164" rx="6"/>
            <path class="bottle__mark" d="M120 286c-8 6-11 14-9 22 8-2 13-9 9-22Zm0 0c8 6 11 14 9 22-8-2-13-9-9-22Z"/>
            <rect class="bottle__line bottle__line--strong" x="82" y="326" width="76" height="7" rx="3.5"/>
            <rect class="bottle__line" x="94" y="344" width="52" height="5" rx="2.5"/>
            <rect class="bottle__rule" x="72" y="370" width="96" height="1.5"/>
            <rect class="bottle__line" x="100" y="388" width="40" height="5" rx="2.5"/>
            <rect class="bottle__neck" x="96" y="78" width="48" height="22" rx="3"/>
            <rect class="bottle__cap" x="86" y="12" width="68" height="70" rx="10"/>
            <rect class="bottle__cap-shine" x="96" y="20" width="6" height="54" rx="3"/>
          </svg>
        {%- endif -%}
      </div>
      <div class="image-with-text__content" data-reveal style="--i: 1;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow image-with-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if show_button -%}
          <div class="image-with-text__cta">
            {%- if button_style == 'button' -%}
              <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
            {%- else -%}
              <a href="{{ section.settings.button_link }}" class="link link--chevron image-with-text__link">
                {{- section.settings.button_label | escape -}}
                {%- render 'icon', name: 'chevron-right', size: 16 -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 2",
          "label": "Landscape (3:2)"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in Scripture. Made in Texas."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Anointing oil runs through Scripture, from the tabernacle in Exodus to the house at Bethany. We make oils faithful to that tradition, from the botanicals the Bible names.</p><p>Each blend is carefully blended, tested, and bottled in Richmond, Texas, on a base of olive-derived squalane. Natural, paraben-free, and vegan, made for prayer and made for skin.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "link",
          "label": "Text link with chevron"
        },
        {
          "value": "button",
          "label": "Pill button"
        }
      ],
      "default": "link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
