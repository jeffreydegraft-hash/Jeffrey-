{%- comment -%}
  Image with text: big rounded media (--r-tile) beside a short text column:
  eyebrow, h2, 17px muted body, "Learn more ›" link (or a pill button).
  12 columns from 990px (an even split; from 1200px media 7/12, text 5/12),
  stacked below. The media can lead or follow; the text can sit at the top,
  middle or bottom of the media's height.
  Placeholder: a neutral olive-oil bottle drawn in tokens on the tile surface.
  Motion: media and text reveal on scroll (data-reveal), text one step later.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'image_first'
  assign layout_class = layout | replace: '_', '-'
  assign ratio = section.settings.image_ratio | default: '4 / 5'
  assign vertical_align = section.settings.vertical_align | default: 'center'
  assign button_style = section.settings.button_style | default: 'link'

  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  assign show_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_button = true
  endif
-%}
<div
  class="section{{ padding_class }} color-{{ section.settings.color_scheme }} image-with-text image-with-text--{{ layout_class }} image-with-text--align-{{ vertical_align }}"
  id="section-{{ section.id }}"
>
  <div class="page-width">
    <div class="image-with-text__grid">
      <div class="image-with-text__media media{% if section.settings.image == blank %} image-with-text__media--illustration{% endif %}" data-reveal style="--ratio: {{ ratio }}; --i: 0;">
        {%- if section.settings.image != blank -%}
          {%- render 'image', image: section.settings.image, sizes: '(min-width: 990px) 58vw, 100vw', widths: '400, 600, 800, 1200, 1600, 2000', loading: 'lazy', class: 'image-with-text__img' -%}
        {%- else -%}
          {%- comment -%} Designed fallback until a photo is chosen: a neutral bottle in theme tokens {%- endcomment -%}
          <svg class="bottle bottle--neutral image-with-text__bottle" viewBox="0 0 240 560" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="BottleGlass-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
                <stop class="bottle__stop bottle__stop--glass-edge" offset="0"/>
                <stop class="bottle__stop bottle__stop--glass-mid" offset="0.32"/>
                <stop class="bottle__stop bottle__stop--glass-mid" offset="0.68"/>
                <stop class="bottle__stop bottle__stop--glass-edge" offset="1"/>
              </linearGradient>
              <linearGradient id="BottleOil-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
                <stop class="bottle__stop bottle__stop--oil-edge" offset="0"/>
                <stop class="bottle__stop bottle__stop--oil-mid" offset="0.4"/>
                <stop class="bottle__stop bottle__stop--oil-edge" offset="1"/>
              </linearGradient>
            </defs>
            <ellipse class="bottle__shadow" cx="120" cy="540" rx="96" ry="10"/>
            <path class="bottle__glass" fill="url(#BottleGlass-{{ section.id }})" d="M94 112h52v36c0 18 58 18 58 62v292c0 18-12 30-30 30H66c-18 0-30-12-30-30V210c0-44 58-44 58-62v-36Z"/>
            <path class="bottle__oil" fill="url(#BottleOil-{{ section.id }})" d="M44 244c24 7 50 10 76 10s52-3 76-10v256c0 14-9 23-24 23H68c-15 0-24-9-24-23V244Z"/>
            <rect class="bottle__shine" x="50" y="222" width="9" height="282" rx="4.5"/>
            <rect class="bottle__shine bottle__shine--soft" x="185" y="232" width="4" height="262" rx="2"/>
            <rect class="bottle__label" x="56" y="300" width="128" height="156" rx="6"/>
            <path class="bottle__mark" d="M119 322c-9 5-13 13-11 22 9-2 14-10 11-22Zm2 0c9 5 13 13 11 22-9-2-14-10-11-22Z"/>
            <rect class="bottle__line bottle__line--strong" x="84" y="360" width="72" height="7" rx="3.5"/>
            <rect class="bottle__line" x="96" y="377" width="48" height="5" rx="2.5"/>
            <rect class="bottle__rule" x="76" y="402" width="88" height="1.5"/>
            <rect class="bottle__line" x="102" y="420" width="36" height="5" rx="2.5"/>
            <rect class="bottle__collar" x="90" y="100" width="60" height="16" rx="4"/>
            <rect class="bottle__cap" x="84" y="22" width="72" height="82" rx="10"/>
            <rect class="bottle__cap-shine" x="94" y="30" width="6" height="66" rx="3"/>
          </svg>
        {%- endif -%}
      </div>
      <div class="image-with-text__content" data-reveal style="--i: 1;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow image-with-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if show_button -%}
          <div class="image-with-text__cta">
            {%- if button_style == 'button' -%}
              <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
            {%- else -%}
              <a href="{{ section.settings.button_link }}" class="link link--chevron image-with-text__link">
                {{- section.settings.button_label | escape -}}
                {%- render 'icon', name: 'chevron-right', size: 16 -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 2",
          "label": "Landscape (3:2)"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in Scripture. Made in Texas."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Anointing oil runs through Scripture, from the tabernacle in Exodus to the house at Bethany. We make oils faithful to that tradition, from the botanicals the Bible names.</p><p>Each blend is carefully blended, tested, and bottled in Richmond, Texas, on a base of olive-derived squalane. Natural, paraben-free, and vegan, made for prayer and made for skin.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "link",
          "label": "Text link with chevron"
        },
        {
          "value": "button",
          "label": "Pill button"
        }
      ],
      "default": "link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
