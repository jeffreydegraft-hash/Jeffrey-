{%- comment -%}
  Image with text: big rounded media (--r-tile) beside a short text column:
  eyebrow, h2, 17px muted body, "Learn more ›" link (or a pill button).
  12 columns from 750px (an even split; from 1200px media 7/12, text 5/12),
  stacked on phones. The media can lead or follow; the text can sit at the
  top, middle or bottom of the media's height.
  Media, in order: the chosen image, else the chosen product's own photo,
  shown whole on the white ground it was shot on (APPLE-SPEC §0). With
  neither, the storefront shows the text alone in a centred reading column;
  the theme editor shows Shopify's neutral placeholder. Nothing is drawn.
  Motion: media and text reveal on scroll (data-reveal), text one step later.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'image_first'
  assign layout_class = layout | replace: '_', '-'
  assign ratio = section.settings.image_ratio | default: '4 / 5'
  assign vertical_align = section.settings.vertical_align | default: 'center'
  assign button_style = section.settings.button_style | default: 'link'
  assign iwt_product = section.settings.product

  assign media_image = section.settings.image
  assign media_kind = 'photo'
  assign media_alt = ''
  if media_image == blank and iwt_product != blank and iwt_product.featured_media != blank
    assign media_image = iwt_product.featured_media.preview_image
    assign media_kind = 'product'
    assign media_alt = iwt_product.featured_media.alt | default: iwt_product.title
  endif

  comment
    "auto" keeps the image's own shape, so nothing is ever cropped.
  endcomment
  if ratio == 'auto'
    if media_image != blank
      assign ratio = media_image.aspect_ratio | append: ' / 1'
    else
      assign ratio = '4 / 5'
    endif
  endif

  assign show_media = true
  if media_image == blank and request.design_mode == false
    assign show_media = false
  endif

  assign padding_class = ''
  case section.settings.padding
    when 'tight'
      assign padding_class = ' section--tight'
    when 'none'
      assign padding_class = ' section--none'
  endcase

  assign show_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_button = true
  endif
-%}
<div
  class="section{{ padding_class }} color-{{ section.settings.color_scheme }} image-with-text image-with-text--{{ layout_class }} image-with-text--align-{{ vertical_align }}{% unless show_media %} image-with-text--text-only{% endunless %}"
  id="section-{{ section.id }}"
>
  <div class="page-width">
    <div class="image-with-text__grid">
      {%- if show_media -%}
        <div class="image-with-text__media media image-with-text__media--{{ media_kind }}" data-reveal style="--ratio: {{ ratio }}; --i: 0;">
          {%- if media_image != blank -%}
            {%- render 'image', image: media_image, alt: media_alt, sizes: '(min-width: 1200px) 58vw, (min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200, 1600, 2000', loading: 'lazy', class: 'image-with-text__img' -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg image-with-text__placeholder' }}
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="image-with-text__content" data-reveal style="--i: 1;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow image-with-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if show_button -%}
          <div class="image-with-text__cta">
            {%- if button_style == 'button' -%}
              <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
            {%- else -%}
              <a href="{{ section.settings.button_link }}" class="link link--chevron image-with-text__link">
                {{- section.settings.button_label | escape -}}
                {%- render 'icon', name: 'chevron-right', size: 16 -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Used when no image is chosen: shows this product's own photo, whole, on white. With neither, the text shows on its own."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "auto",
          "label": "Image's own shape (never cropped)"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in Scripture. Made in Texas."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Anointing oil runs through Scripture, from the tabernacle in Exodus to the house at Bethany. We make oils faithful to that tradition, from the botanicals the Bible names.</p><p>Each blend is carefully blended, tested, and bottled in Richmond, Texas, on a base of olive-derived squalane. Natural, paraben-free, and vegan, made for prayer and made for skin.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "link",
          "label": "Text link with chevron"
        },
        {
          "value": "button",
          "label": "Pill button"
        }
      ],
      "default": "link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
