{%- comment -%}
  Cart page: the Apple bag page. A centred headline and one-line lead, line
  items as roomy rows, and the order summary as a flat surface tile with the
  Check Out pill. Everything that re-renders lives inside #MainCart-Inner,
  which carries the section id so cart.js can request it from the Section
  Rendering API and swap it in place. #MainCart-Title is the focus fallback
  after a line is removed, so it exists in both the filled and empty states.
{%- endcomment -%}
{%- liquid
  assign show_shipping_bar = false
  assign shipping_reached = false
  assign has_threshold = false
  if settings.cart_show_free_shipping and settings.cart_free_shipping_threshold > 0
    assign has_threshold = true
    assign shipping_threshold = settings.cart_free_shipping_threshold | times: 100
    assign shipping_threshold_money = shipping_threshold | money_without_trailing_zeros
    if cart.item_count > 0
      assign show_shipping_bar = true
      assign shipping_remaining = shipping_threshold | minus: cart.total_price
      assign shipping_remaining_money = shipping_remaining | money
      assign shipping_progress = cart.total_price | times: 1.0 | divided_by: shipping_threshold | at_most: 1.0
      assign shipping_percent = shipping_progress | times: 100 | round
      if shipping_remaining <= 0
        assign shipping_reached = true
      endif
    endif
  endif
-%}
<div class="section color-{{ section.settings.color_scheme }} main-cart" id="section-{{ section.id }}">
  <div class="page-width">
    <div id="MainCart-Inner" class="main-cart__inner{% if cart.item_count == 0 %} is-empty{% endif %}" data-section-id="{{ section.id }}">
      {%- if cart.item_count > 0 -%}
        <header class="main-cart__header">
          <h1 class="h1 main-cart__title" id="MainCart-Title" tabindex="-1">{{ 'cart.page_title' | t }}</h1>
          {%- if has_threshold -%}
            <p class="lead main-cart__lead">{{ 'cart.free_shipping.lead' | t: amount: shipping_threshold_money }}</p>
          {%- else -%}
            <p class="lead lead--muted main-cart__lead">{{ 'cart.general.item_count' | t: count: cart.item_count }}</p>
          {%- endif -%}
          {%- if section.settings.show_continue_shopping -%}
            <a href="{{ routes.all_products_collection_url }}" class="link link--chevron main-cart__continue">
              {{- 'cart.continue_shopping' | t -}}
              {%- render 'icon', name: 'chevron-right', size: 11 -%}
            </a>
          {%- endif -%}
        </header>

        <div class="main-cart__layout">
          <div class="main-cart__items">
            {%- render 'cart-line-items', context: 'page' -%}

            {%- if settings.cart_show_note -%}
              <olivet-accordion class="accordion cart-note main-cart__note">
                <details{% if cart.note != blank %} open{% endif %}>
                  <summary class="accordion__summary cart-note__summary">
                    <span>{{ 'cart.general.note' | t }}</span>
                    {%- render 'icon', name: 'chevron-down', size: 16 -%}
                  </summary>
                  <div class="accordion__content" data-accordion-content>
                    <div class="accordion__inner">
                      <cart-note class="cart-note__field" data-saved-text="{{ 'cart.general.note_saved' | t }}" data-error-text="{{ 'cart.general.error' | t }}">
                        <label class="visually-hidden" for="MainCart-Note">{{ 'cart.general.note' | t }}</label>
                        <textarea
                          class="field__textarea cart-note__textarea"
                          id="MainCart-Note"
                          name="note"
                          form="Cart"
                          rows="3"
                          placeholder="{{ 'cart.general.note_placeholder' | t }}"
                        >{{ cart.note }}</textarea>
                        <p class="cart-note__status caption" aria-live="polite"></p>
                      </cart-note>
                    </div>
                  </div>
                </details>
              </olivet-accordion>
            {%- endif -%}
          </div>

          <aside class="main-cart__summary" aria-labelledby="MainCart-SummaryTitle">
            <div class="tile main-cart__card">
              <h2 class="main-cart__summary-title" id="MainCart-SummaryTitle">{{ 'cart.general.summary' | t }}</h2>

              {%- comment -%} Once reached, the Shipping row says "Free (US)"; the line would repeat it. {%- endcomment -%}
              {%- if show_shipping_bar and shipping_reached == false -%}
                <free-shipping-bar
                  class="free-shipping-bar main-cart__shipping{% if shipping_reached %} is-reached{% endif %}"
                  data-total="{{ cart.total_price }}"
                  data-threshold="{{ shipping_threshold }}"
                  style="--progress: {{ shipping_progress }};"
                >
                  <p class="free-shipping-bar__text" aria-live="polite">
                    {%- if shipping_reached -%}
                      {%- render 'icon', name: 'check', size: 14, class: 'free-shipping-bar__check' -%}
                      <span>{{ 'cart.free_shipping.reached' | t }}</span>
                    {%- else -%}
                      <span>{{ 'cart.free_shipping.away_liquid_html' | t: amount: shipping_remaining_money }}</span>
                    {%- endif -%}
                  </p>
                  <div class="free-shipping-bar__track" role="progressbar" aria-label="{{ 'cart.free_shipping.label' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipping_percent }}">
                    <div class="free-shipping-bar__fill"></div>
                  </div>
                </free-shipping-bar>
              {%- endif -%}

              <div class="cart-totals cart-totals--summary">
                <div class="cart-totals__row">
                  <span class="cart-totals__label">{{ 'cart.general.subtotal' | t }}</span>
                  <span class="cart-totals__value money">{{ cart.items_subtotal_price | money }}</span>
                </div>

                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="cart-totals__discounts" role="list" aria-label="{{ 'cart.general.discounts' | t }}">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li class="cart-totals__row cart-totals__row--discount">
                        <span class="cart-totals__label">
                          {%- render 'icon', name: 'check', size: 14 -%}
                          {{ discount.title | escape }}
                        </span>
                        <span class="cart-totals__value money">−{{ discount.total_allocated_amount | money }}</span>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="cart-totals__row">
                  <span class="cart-totals__label">
                    {%- if shop.shipping_policy.body != blank -%}
                      <a href="{{ shop.shipping_policy.url }}" class="link link--underline">{{ 'cart.general.shipping' | t }}</a>
                    {%- else -%}
                      {{ 'cart.general.shipping' | t }}
                    {%- endif -%}
                  </span>
                  <span class="cart-totals__value">
                    {%- if shipping_reached -%}
                      {{ 'cart.general.shipping_free' | t }}
                    {%- else -%}
                      {{ 'cart.general.shipping_at_checkout' | t }}
                    {%- endif -%}
                  </span>
                </div>

                <div class="cart-totals__row cart-totals__row--total">
                  <span class="cart-totals__label">{{ 'cart.headings.total' | t }}</span>
                  <span class="cart-totals__value money">{{ cart.total_price | money }}</span>
                </div>

                <p class="cart-totals__note">
                  {%- if cart.taxes_included -%}
                    {{ 'cart.general.taxes_included' | t }}
                  {%- else -%}
                    {{ 'cart.general.taxes_at_checkout' | t }}
                  {%- endif -%}
                </p>
              </div>

              <form action="{{ routes.cart_url }}" method="post" id="Cart" class="main-cart__form">
                <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg main-cart__checkout">
                  {{- 'cart.general.checkout' | t -}}
                </button>
              </form>

              {%- if additional_checkout_buttons -%}
                <div class="main-cart__dynamic-checkout additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="main-cart__login">
                  {{ 'cart.login.title' | t }}
                  {{ 'cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </aside>
        </div>
      {%- else -%}
        <h1 class="visually-hidden">{{ 'cart.title' | t }}</h1>
        <div class="main-cart__empty">
          <h2 class="h2 main-cart__empty-title" id="MainCart-Title" tabindex="-1">{{ 'cart.empty' | t }}</h2>
          <p class="lead lead--muted main-cart__empty-body">{{ 'cart.empty_body' | t }}</p>
          <div class="cta-row main-cart__empty-actions">
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ 'cart.continue_shopping' | t }}</a>
          </div>
          {%- if shop.customer_accounts_enabled and customer == null -%}
            <p class="main-cart__login">
              {{ 'cart.login.title' | t }}
              {{ 'cart.login.paragraph_html' | t: link: routes.account_login_url }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_continue_shopping",
      "label": "Show “Continue shopping” link",
      "default": true
    }
  ]
}
{% endschema %}
