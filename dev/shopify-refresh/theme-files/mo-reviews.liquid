{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
MOUNT OF OLIVES REVIEWS
----------------------------------------------------------------------------------------------------------------------
The reviews the rating badge counts, under the product: the average, where the reviews come from, and the newest
Etsy reviews that the ReputonEtsyReviews app has imported (first names only), with a link to read the rest on Etsy.
Customers write their own review with the form at the end. It is posted as a comment on this product's article in the
hidden "reviews" blog (Online Store > Blog posts > Customer Reviews), which publishes comments automatically after
Shopify's spam check, so it shows here and counts toward the stars at once. The form writes the stars as a first line
"Rating: N/5". The owner can hide or delete a review under Blog posts > Manage comments. customer_review metaobject
entries still show too.
{%- endcomment -%}

{%- liquid
  assign etsy_count = 0
  assign etsy_url = ''
  assign etsy_reviews = ''
  for field in product.metafields['ReputonEtsyReviews::ProductReviews']
    assign etsy = field.last.value
    assign etsy_count = etsy_count | plus: etsy.reviewsNumber
    if etsy.url != blank
      assign etsy_url = etsy.url
    endif
    assign etsy_reviews = etsy.reviews
  endfor

  assign junip_count = product.metafields.custom.earlier_site_reviews.value.count | default: 0 | plus: 0
  assign amazon_count = product.metafields.custom.amazon_reviews.value.reviews.size | default: 0
  if product.metafields.custom.on_amazon_listing.value == true
    assign amazon_count = amazon_count | plus: shop.metafields.custom.amazon_rating.value.count
  endif

  assign review_key = 'reviews/' | append: product.handle
  assign review_article = articles[review_key]
  assign comment_count = 0
  for comment in review_article.comments
    assign review_head = comment.content | strip_html | strip | slice: 0, 8
    if review_head == 'Rating: '
      assign comment_count = comment_count | plus: 1
    endif
  endfor
  assign ebay_count = product.metafields.custom.ebay_reviews.value.reviews.size | default: 0
  assign total_count = etsy_count | plus: junip_count | plus: amazon_count | plus: ebay_count
  assign store_reviews = ''
  for entry in shop.metaobjects.customer_review.values
    if entry.product.value.id == product.id
      assign store_reviews = store_reviews | append: entry.system.handle | append: ','
    endif
  endfor
  assign store_handles = store_reviews | split: ','
  assign store_count = store_handles.size
  assign site_count = junip_count | plus: store_count | plus: comment_count

  assign shown = 0
  assign listable = store_count | plus: comment_count
  for review in etsy_reviews
    unless review.hide or review.text == blank
      assign listable = listable | plus: 1
    endunless
  endfor

  assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5
-%}

{%- if product != blank -%}
  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}">
    <div class="container">
      <div id="reviews" class="mo-reviews">
        <div class="mo-reviews__header">
          <h2 class="h3">{{ section.settings.title | escape }}</h2>
          {%- render 'product-rating', product: product, full: true, link: false -%}
          {%- if total_count > 0 or site_count > 0 -%}
          <p class="mo-reviews__sources text-sm text-subdued">
            {%- if etsy_count > 0 -%}{{ etsy_count }} on Etsy{%- endif -%}
            {%- if amazon_count > 0 -%}{% if etsy_count > 0 %} · {% endif %}{{ amazon_count }} on Amazon{%- endif -%}
            {%- if ebay_count > 0 -%}{% if etsy_count > 0 or amazon_count > 0 %} · {% endif %}{{ ebay_count }} on eBay{%- endif -%}
            {%- if site_count > 0 -%}{% if etsy_count > 0 or amazon_count > 0 or ebay_count > 0 %} · {% endif %}{{ site_count }} on mountofolives.co{%- endif -%}
          </p>
          {%- else -%}
          <p class="mo-reviews__sources text-sm text-subdued">Be the first to review this oil.</p>
          {%- endif -%}
        </div>

        {%- if listable > 0 -%}
          <ul class="mo-reviews__list unstyled-list" role="list">
            {%- for comment in review_article.comments -%}
              {%- liquid
                assign review_text = comment.content | strip_html | strip
                assign review_head = review_text | slice: 0, 8
                if review_head != 'Rating: ' or shown >= section.settings.reviews_shown
                  continue
                endif
                assign review_stars = review_text | slice: 8 | plus: 0
                if review_stars < 1 or review_stars > 5
                  continue
                endif
                assign review_body = review_text | slice: 11, 5000 | strip
                assign shown = shown | plus: 1
              -%}
              <li class="mo-reviews__item">
                <div class="rating-badge__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: review_stars, rating_max: 5 }}">
                  {%- for i in (1..5) -%}
                    {%- if i <= review_stars -%}{%- render 'icon' with 'star-rating' -%}{%- else -%}{%- render 'icon' with 'star-rating-empty' -%}{%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if review_body != blank -%}<p class="mo-reviews__text">{{ review_body | escape | newline_to_br }}</p>{%- endif -%}
                <p class="mo-reviews__meta text-xs text-subdued">{{ comment.author | strip | split: ' ' | first | escape }} · mountofolives.co review · {{ comment.created_at | date: '%b %-d, %Y' }}</p>
              </li>
            {%- endfor -%}

            {%- for entry in shop.metaobjects.customer_review.values -%}
              {%- unless store_handles contains entry.system.handle -%}{%- continue -%}{%- endunless -%}
              {%- if shown >= section.settings.reviews_shown -%}{%- break -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              <li class="mo-reviews__item">
                <div class="rating-badge__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: entry.rating.value, rating_max: 5 }}">
                  {%- for i in (1..5) -%}
                    {%- if i <= entry.rating.value -%}{%- render 'icon' with 'star-rating' -%}{%- else -%}{%- render 'icon' with 'star-rating-empty' -%}{%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="mo-reviews__text">{{ entry.review.value | escape | strip | newline_to_br }}</p>
                <p class="mo-reviews__meta text-xs text-subdued">{{ entry.name.value | split: ' ' | first | escape }} · mountofolives.co review · {{ entry.date.value | date: '%b %-d, %Y' }}</p>
              </li>
            {%- endfor -%}

            {%- for review in etsy_reviews -%}
              {%- if review.hide or review.text == blank or shown >= section.settings.reviews_shown -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- liquid
                # a first word that starts in lower case or has a digit is an Etsy login, not a name, so it is left out
                assign first_name = review.authorName | strip | split: ' ' | first | default: ''
                assign initial = first_name | slice: 0
                assign initial_up = initial | upcase
                assign no_digits = first_name | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
                if initial != initial_up or no_digits.size != first_name.size
                  assign first_name = ''
                endif
              -%}
              <li class="mo-reviews__item">
                <div class="rating-badge__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: review.rating, rating_max: 5 }}">
                  {%- for i in (1..5) -%}
                    {%- if i <= review.rating -%}{%- render 'icon' with 'star-rating' -%}{%- else -%}{%- render 'icon' with 'star-rating-empty' -%}{%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="mo-reviews__text">{{ review.text | replace: '&#39;', "’" | replace: '&quot;', '"' | replace: '&amp;', '&' | escape | strip | newline_to_br }}</p>
                <p class="mo-reviews__meta text-xs text-subdued">{% if first_name != blank %}{{ first_name | escape }} · {% endif %}Etsy review · {{ review.relativeTimeDescription | date: '%b %-d, %Y' | escape }}</p>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if etsy_url != blank and etsy_count > shown -%}
          <a href="{{ etsy_url }}" class="link mo-reviews__more" target="_blank" rel="noopener">Read all {{ etsy_count }} Etsy reviews</a>
        {%- endif -%}

        {%- if review_article != blank -%}
        {%- comment -%}
          The stars and the review are joined into the comment body by the script below ("Rating: 5/5", a blank line,
          the review). Shopify sends the visitor to the article page after posting; the "review" article template
          thanks them and brings them back here.
        {%- endcomment -%}
        <details class="mo-reviews__write" id="write-review">
          <summary class="button">Write a review</summary>
          {%- form 'new_comment', review_article, class: 'form mo-reviews__form', id: 'mo-review-form' -%}
            <fieldset class="mo-stars-input">
              <legend class="text-sm">Your rating</legend>
              <div class="mo-stars-input__row">
                {%- for i in (1..5) reversed -%}
                  <input type="radio" id="mo-star-{{ section.id }}-{{ i }}" name="mo_rating" value="{{ i }}" required{% if i == 5 %} checked{% endif %}>
                  <label for="mo-star-{{ section.id }}-{{ i }}" title="{{ i }} of 5 stars"><span class="sr-only">{{ i }} of 5 stars</span>{%- render 'icon' with 'star-rating' -%}</label>
                {%- endfor -%}
              </div>
            </fieldset>

            <div class="fieldset">
              <div class="fieldset-row">
                {%- render 'input', type: 'text', name: 'comment[author]', label: 'First name', value: customer.first_name, required: true, autocomplete: 'given-name', maxlength: 40 -%}
                {%- render 'input', type: 'email', name: 'comment[email]', label: 'Email (not shown)', value: customer.email, required: true, autocomplete: 'email' -%}
              </div>
              {%- render 'input', name: 'mo_review_text', label: 'Your review', multiline: 4, required: true, maxlength: 2000 -%}
            </div>
            <input type="hidden" name="comment[body]" value="">

            <p class="text-xs text-subdued">Your review appears on this page right away. Only your first name and stars are shown.</p>
            {%- render 'button', content: 'Post review', type: 'submit' -%}
          {%- endform -%}
        </details>
        <script>
          (() => {
            const form = document.getElementById('mo-review-form');
            if (!form) return;
            form.addEventListener('submit', () => {
              const stars = form.querySelector('input[name="mo_rating"]:checked');
              const text = form.querySelector('[name="mo_review_text"]');
              form.querySelector('input[name="comment[body]"]').value = 'Rating: ' + (stars ? stars.value : '5') + '/5\n\n' + (text ? text.value.trim() : '');
              if (text) text.disabled = true;
            });
            const openForm = () => { if (location.hash === '#write-review') form.closest('details').open = true; };
            openForm();
            window.addEventListener('hashchange', openForm);
          })();
        </script>
        {%- endif -%}

        {%- comment -%}App blocks such as Junip's review form, so customers can leave their own stars here{%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="mo-reviews__app" {{ block.shopify_attributes }}>{%- render block -%}</div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "class": "shopify-section--mo-reviews",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "range",
      "id": "reviews_shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Reviews shown",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
