        "mo-size-value": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- comment -%}Mount of Olives: compare sizes by price per ounce. Reads the ounces from size names such as \"4 ounce (118 ml)\".{%- endcomment -%}\n{%- liquid\n  assign size_count = 0\n  assign best_per_oz = 0\n  assign first_per_oz = 0\n  for variant in product.variants\n    assign ounces = variant.title | split: ' ' | first | times: 1.0\n    if ounces > 0\n      assign size_count = size_count | plus: 1\n      assign per_oz = variant.price | divided_by: ounces\n      if first_per_oz == 0\n        assign first_per_oz = per_oz\n      endif\n      if best_per_oz == 0 or per_oz < best_per_oz\n        assign best_per_oz = per_oz\n      endif\n    endif\n  endfor\n-%}\n{%- if size_count > 1 -%}\n  <div class=\"mo-sizes\">\n    <p class=\"mo-sizes__title\">Compare sizes</p>\n    <ul class=\"mo-sizes__list unstyled-list\">\n      {%- for variant in product.variants -%}\n        {%- assign ounces = variant.title | split: ' ' | first | times: 1.0 -%}\n        {%- if ounces > 0 -%}\n          {%- assign per_oz = variant.price | divided_by: ounces -%}\n          <li class=\"mo-sizes__row{% if per_oz == best_per_oz %} is-best{% endif %}\">\n            <span class=\"mo-sizes__size\">{{ variant.title | split: ' (' | first }}</span>\n            <span class=\"mo-sizes__price\">{{ variant.price | money }}</span>\n            <span class=\"mo-sizes__per\">{{ per_oz | round | money }} per oz</span>\n            {%- if per_oz == best_per_oz and first_per_oz > per_oz -%}\n              {%- assign saving = per_oz | times: 100.0 | divided_by: first_per_oz | minus: 100 | times: -1 | floor -%}\n              <span class=\"mo-sizes__badge\">Best value · save {{ saving }}%</span>\n            {%- endif -%}\n          </li>\n        {%- endif -%}\n      {%- endfor -%}\n    </ul>\n  </div>\n{%- endif -%}"
          }
        },
