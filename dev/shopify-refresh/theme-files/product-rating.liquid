{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PRODUCT RATING BADGE
----------------------------------------------------------------------------------------------------------------------

This component generates a review badge from the product metafields information.

********************************************
Supported variables
********************************************

* product: the product from which ratings are extracted
* show_empty: if set to true, the theme shows a 0.0 if there are no rating yet
* show_placeholder: if set to true, show random value (useful for the product card placeholder)
* show_single_star: if set to true, only one star is shown (otherwise, the number of scale)
* display_mode: either "rating" (e.g.: 3.5) or "count" (e.g.: 4 reviews). Default to "rating" if none is passed
* full: if set to true, shows the average and the review count after the stars ("4.9 (124 reviews)"), linked to the
  reviews section on the product page when that section has reviews to show
* store: set to true to always show the whole store's rating (used on the homepage)
* link: set to false to show the average and the count without the link (used inside the reviews section itself)

Mount of Olives: the average and the count combine every real review a product has: its Etsy listing's total (the
ReputonEtsyReviews metafield; when the app has imported all of them their own stars are averaged, otherwise the
listing's average is used), Amazon and eBay reviews pasted into custom.amazon_reviews and custom.ebay_reviews (same shape: {"reviews": [{"rating": 5}]}), reviews customers post with the form on the product page (comments on
the product's article in the "reviews" blog, published automatically), the Junip reviews kept as numbers in
custom.earlier_site_reviews, and customer_review metaobject entries.
A product with none of these falls back to the standard reviews metafields.
A product flagged custom.on_amazon_listing also carries the shared Amazon listing's rating (custom.amazon_rating).
With full, a product with fewer than 10 reviews (none included) shows the whole store's rating instead, labelled as such ("4.9 (209
reviews of our oils)"), counted the same way across the all-products collection plus Amazon and eBay reviews on the shop and the
Amazon star rating of the whole listing family (shop metafield custom.amazon_rating: count, average).
Product cards leave the count out below 10.
{%- endcomment -%}

{%- liquid
  assign rating_count = 0
  assign rating_points = 0.0

  if product != blank
    for field in product.metafields['ReputonEtsyReviews::ProductReviews']
      assign etsy = field.last.value
      assign etsy_count = etsy.reviewsNumber | default: 0
      for review in etsy.reviews
        unless review.hide or review.text == blank
          assign reviews_listed = true
          break
        endunless
      endfor
      if etsy_count > 0
        if etsy.reviews.size == etsy_count
          for review in etsy.reviews
            assign rating_points = rating_points | plus: review.rating
          endfor
        else
          assign etsy_points = etsy.rating | times: etsy_count
          assign rating_points = rating_points | plus: etsy_points
        endif
        assign rating_count = rating_count | plus: etsy_count
      endif
    endfor

    # a scent sold under the shared Amazon listing carries that listing's rating, as Amazon shows it on every scent
    if product.metafields.custom.on_amazon_listing.value == true
      assign amazon = shop.metafields.custom.amazon_rating.value
      if amazon.count > 0
        assign amazon_points = amazon.average | times: amazon.count
        assign rating_points = rating_points | plus: amazon_points
        assign rating_count = rating_count | plus: amazon.count
      endif
    endif

    for review in product.metafields.custom.amazon_reviews.value.reviews
      assign rating_points = rating_points | plus: review.rating
      assign rating_count = rating_count | plus: 1
    endfor

    for review in product.metafields.custom.ebay_reviews.value.reviews
      assign rating_points = rating_points | plus: review.rating
      assign rating_count = rating_count | plus: 1
    endfor

    for entry in shop.metaobjects.customer_review.values
      if entry.product.value.id == product.id
        assign rating_points = rating_points | plus: entry.rating.value
        assign rating_count = rating_count | plus: 1
        assign reviews_listed = true
      endif
    endfor

    # reviews customers post on the site: comments on this product's article in the hidden "reviews" blog, each
    # opening with the "Rating: N/5" line the review form writes
    assign review_key = 'reviews/' | append: product.handle
    for comment in articles[review_key].comments
      assign review_text = comment.content | strip_html | strip
      assign review_head = review_text | slice: 0, 8
      if review_head == 'Rating: '
        assign review_stars = review_text | slice: 8 | plus: 0
        if review_stars >= 1 and review_stars <= 5
          assign rating_points = rating_points | plus: review_stars
          assign rating_count = rating_count | plus: 1
          assign reviews_listed = true
        endif
      endif
    endfor

    # site reviews the Junip app collected before it was removed, kept as numbers
    assign earlier = product.metafields.custom.earlier_site_reviews.value
    if earlier.count > 0
      assign earlier_points = earlier.average | times: earlier.count
      assign rating_points = rating_points | plus: earlier_points
      assign rating_count = rating_count | plus: earlier.count
    endif
  endif

  assign use_store = false
  if full and product != blank and rating_count < 10
    assign use_store = true
  endif
  if full and store
    assign use_store = true
  endif

  if use_store
    assign store_count = 0
    assign store_points = 0.0
    for counted in collections['all-products'].products
      for field in counted.metafields['ReputonEtsyReviews::ProductReviews']
        assign etsy = field.last.value
        assign etsy_count = etsy.reviewsNumber | default: 0
        if etsy_count > 0
          if etsy.reviews.size == etsy_count
            for review in etsy.reviews
              assign store_points = store_points | plus: review.rating
            endfor
          else
            assign etsy_points = etsy.rating | times: etsy_count
            assign store_points = store_points | plus: etsy_points
          endif
          assign store_count = store_count | plus: etsy_count
        endif
      endfor
      for review in counted.metafields.custom.amazon_reviews.value.reviews
        assign store_points = store_points | plus: review.rating
        assign store_count = store_count | plus: 1
      endfor
      for review in counted.metafields.custom.ebay_reviews.value.reviews
        assign store_points = store_points | plus: review.rating
        assign store_count = store_count | plus: 1
      endfor
      assign review_key = 'reviews/' | append: counted.handle
      for comment in articles[review_key].comments
        assign review_text = comment.content | strip_html | strip
        assign review_head = review_text | slice: 0, 8
        if review_head == 'Rating: '
          assign review_stars = review_text | slice: 8 | plus: 0
          if review_stars >= 1 and review_stars <= 5
            assign store_points = store_points | plus: review_stars
            assign store_count = store_count | plus: 1
          endif
        endif
      endfor
      assign earlier = counted.metafields.custom.earlier_site_reviews.value
      if earlier.count > 0
        assign earlier_points = earlier.average | times: earlier.count
        assign store_points = store_points | plus: earlier_points
        assign store_count = store_count | plus: earlier.count
      endif
    endfor
    for review in shop.metafields.custom.amazon_reviews.value.reviews
      assign store_points = store_points | plus: review.rating
      assign store_count = store_count | plus: 1
    endfor
    for review in shop.metafields.custom.ebay_reviews.value.reviews
      assign store_points = store_points | plus: review.rating
      assign store_count = store_count | plus: 1
    endfor
    for entry in shop.metaobjects.customer_review.values
      assign store_points = store_points | plus: entry.rating.value
      assign store_count = store_count | plus: 1
    endfor
    # the Amazon rating covers the whole listing family (every scent), so it only ever counts toward the store total
    assign amazon = shop.metafields.custom.amazon_rating.value
    if amazon.count > 0
      assign amazon_points = amazon.average | times: amazon.count
      assign store_points = store_points | plus: amazon_points
      assign store_count = store_count | plus: amazon.count
    endif

    if store_count > rating_count or store
      assign rating_count = store_count
      assign rating_points = store_points
      assign store_wide = true
    endif
  endif

  if rating_count > 0
    assign rating_value = rating_points | divided_by: rating_count | round: 1
    assign rating_max = 5
  elsif product.metafields.reviews.rating.value != blank
    assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
    assign rating_count = product.metafields.reviews.rating_count.value
    assign rating_max = product.metafields.reviews.rating.value.scale_max
  elsif show_empty
    assign rating_value = 0.0
    assign rating_count = 0
    assign rating_max = 5
  elsif show_placeholder
    assign rating_value = 4.5
    assign rating_count = 2
    assign rating_max = 5
  else
    assign hide_rating = true
  endif

  # Mount of Olives: the owner asked for no stars anywhere on the site (Oct 22); the counting above is kept
  assign hide_rating = true

  assign rating_decimal = 0
  assign decimal = rating_value | modulo: 1 | round: 2

  if decimal >= 0.3 and decimal <= 0.7
    assign rating_decimal = 0.5
  elsif decimal > 0.7
    assign rating_decimal = 1
  endif
-%}

{%- unless hide_rating -%}
  <span class="rating-badge" title="{{ 'product.rating_count' | t: count: rating_count }}">
    <div class="rating-badge__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: rating_value, rating_max: rating_max }}">
      {%- liquid
        if show_single_star
          if rating_count == 0
            render 'icon' with 'star-rating-empty'
          else
            render 'icon' with 'star-rating'
          endif
        else
          for i in (1..rating_max)
            if rating_count == 0
              render 'icon' with 'star-rating-empty'
            else
              if i <= rating_value
                render 'icon' with 'star-rating'
              else
                if rating_decimal == 0.5
                  render 'icon' with 'star-rating-half'
                elsif rating_decimal == 1
                  render 'icon' with 'star-rating'
                else
                  render 'icon' with 'star-rating-empty'
                endif

                assign rating_decimal = false
              endif
            endif
          endfor
        endif
      -%}
    </div>

    {%- if full -%}
      {%- liquid
        assign rating_text = rating_value | append: ''
        unless rating_text contains '.'
          assign rating_text = rating_text | append: '.0'
        endunless
        assign count_text = rating_count | append: ''
        if rating_count >= 1000
          assign count_thousands = rating_count | divided_by: 1000
          assign count_rest = rating_count | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
          assign count_text = count_thousands | append: ',' | append: count_rest
        endif
      -%}
      {%- if reviews_listed and link != false -%}<a href="#reviews" class="rating-badge__summary">{%- else -%}<span class="rating-badge__summary">{%- endif -%}
        <span class="rating-badge__value">{{ rating_text }}</span>
        <span class="rating-badge__count">({% if store_wide %}{{ count_text }} ratings of our oils{% else %}{{ 'product.rating_count' | t: count: rating_count | replace: rating_count, count_text }}{% endif %})</span>
      {%- if reviews_listed and link != false -%}</a>{%- else -%}</span>{%- endif -%}
    {%- elsif display_mode == 'count' -%}
      {%- if rating_count >= 10 -%}<span class="smallcaps text-xxs text-subdued">({{ rating_count }})</span>{%- endif -%}
    {%- else -%}
      <span class="smallcaps text-xxs text-subdued">({{ rating_value }})</span>
    {%- endif -%}
  </span>
{%- endunless -%}