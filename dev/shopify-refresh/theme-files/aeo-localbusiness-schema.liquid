{% if request.page_type == 'index' or page.handle == 'about' or page.handle == 'contact' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "{{ shop.url }}/#localbusiness",
  "name": "Mount of Olives LLC",
  "description": "Faith-based body care company specializing in handcrafted anointing oils made with biblical botanicals. Parent company of Mount of Olives and My Cup Runneth Over brands.",
  "url": "{{ shop.url }}",
  "email": "info@mountofolives.co",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "TX",
    "addressCountry": "US"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "00:00",
    "closes": "23:59",
    "description": "Online store open 24/7"
  },
  "priceRange": "$$",
  "brand": [
    { "@type": "Brand", "name": "Mount of Olives", "url": "https://mountofolives.co" },
    { "@type": "Brand", "name": "My Cup Runneth Over", "url": "https://mycuprunnethoverinc.com" }
  ],
  "sameAs": [
    "https://mountofolives.co",
    "https://mycuprunnethoverinc.com"
  ]
}
</script>
{% endif %}