{%- comment -%} Renders a product card. Accepts: product (required), lazy (boolean) {%- endcomment -%}
{%- liquid
  assign card_product = product
  assign media = card_product.featured_media
  assign hover_media = nil
  if settings.card_hover_image and card_product.media.size > 1
    assign hover_media = card_product.media[1]
  endif
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_alt = media.alt | default: card_product.title
-%}
<article class="product-card">
  <a class="product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
    {%- if media != blank -%}
      {{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'product-card__img', alt: card_alt }}
      {%- if hover_media != blank -%}
        {{ hover_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'product-card__img product-card__img--hover', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
    {%- endif -%}
    {%- if card_product.compare_at_price > card_product.price -%}
      <span class="badge badge--sale">Sale</span>
    {%- elsif card_product.available == false -%}
      <span class="badge badge--soldout">Sold out</span>
    {%- elsif card_product.tags contains 'Bestseller' or card_product.tags contains 'bestseller' -%}
      <span class="badge">Bestseller</span>
    {%- elsif card_product.tags contains 'New' or card_product.tags contains 'new' -%}
      <span class="badge">New</span>
    {%- endif -%}
  </a>
  <div class="product-card__info">
    {%- if settings.card_show_vendor -%}<p class="product-card__vendor">{{ card_product.vendor }}</p>{%- endif -%}
    <h3 class="product-card__title"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
    {%- if settings.card_show_sizes and card_product.variants.size > 1 -%}
      <p class="product-card__meta">{{ card_product.variants.size }} sizes</p>
    {%- elsif card_product.metafields.custom.purpose != blank -%}
      <p class="product-card__meta">{{ card_product.metafields.custom.purpose }}</p>
    {%- endif -%}
    <div class="product-card__price">{% render 'price', product: card_product, use_from: true %}</div>
    {%- if settings.card_quick_add -%}
      {%- if card_product.variants.size == 1 and card_product.available -%}
        <form action="{{ routes.cart_add_url }}" method="post" data-ajax-cart class="product-card__form">
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="btn btn--secondary btn--small product-card__add">Add to cart</button>
        </form>
      {%- elsif card_product.available -%}
        <a href="{{ card_product.url }}" class="btn btn--secondary btn--small product-card__add">Choose size</a>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
