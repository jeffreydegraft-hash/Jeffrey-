{%- comment -%}
  Search drawer (top panel). Rendered by sections/header.liquid, so
  section.settings.popular_* are the header section's settings.
  Contract: <search-drawer id="SearchDrawer" data-drawer> from theme.js;
  <predictive-search> from assets/predictive-search.js when enabled.
{%- endcomment -%}
{%- liquid
  assign predictive = settings.predictive_search_enabled
  assign has_popular = false
  if section.settings.popular_1_label != blank and section.settings.popular_1_url != blank
    assign has_popular = true
  endif
  if section.settings.popular_2_label != blank and section.settings.popular_2_url != blank
    assign has_popular = true
  endif
  if section.settings.popular_3_label != blank and section.settings.popular_3_url != blank
    assign has_popular = true
  endif
-%}
<search-drawer id="SearchDrawer" data-drawer class="search-drawer" aria-hidden="true" inert>
  <div class="drawer__backdrop" data-drawer-backdrop></div>
  <div
    class="drawer__panel drawer__panel--top search-drawer__panel"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'search.title' | t }}"
  >
    <div class="search-drawer__inner page-width">
      <div class="search-drawer__top">
        {%- if predictive -%}
          <predictive-search class="search-drawer__predictive" data-loading-text="{{ 'search.loading' | t | escape }}" data-error-text="{{ 'search.error' | t | escape }}">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form">
          <label for="SearchDrawer-Input" class="visually-hidden">{{ 'search.search' | t }}</label>
          <div class="search-drawer__field">
            <button type="submit" class="search-drawer__submit" aria-label="{{ 'search.search' | t }}">
              {%- render 'icon', name: 'search', size: 22 -%}
            </button>
            <input
              id="SearchDrawer-Input"
              class="search-drawer__input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              data-drawer-focus
              {%- if predictive %}
                role="combobox"
                aria-expanded="false"
                aria-controls="predictive-search-results"
                aria-autocomplete="list"
                aria-haspopup="listbox"
              {%- endif %}
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="button" class="search-drawer__reset" data-search-reset aria-label="{{ 'search.clear' | t }}">
              {%- render 'icon', name: 'close', size: 20 -%}
            </button>
          </div>

          {%- if predictive -%}
            <div class="search-drawer__skeleton" aria-hidden="true">
              <div class="search-drawer__skeleton-row">
                <span class="skeleton search-drawer__skeleton-media"></span>
                <span class="search-drawer__skeleton-lines">
                  <span class="skeleton search-drawer__skeleton-line"></span>
                  <span class="skeleton search-drawer__skeleton-line search-drawer__skeleton-line--short"></span>
                </span>
              </div>
              <div class="search-drawer__skeleton-row">
                <span class="skeleton search-drawer__skeleton-media"></span>
                <span class="search-drawer__skeleton-lines">
                  <span class="skeleton search-drawer__skeleton-line"></span>
                  <span class="skeleton search-drawer__skeleton-line search-drawer__skeleton-line--short"></span>
                </span>
              </div>
            </div>
            <div id="predictive-search-results" class="search-drawer__results" aria-live="polite"></div>
            <span class="search-drawer__status visually-hidden" role="status" aria-live="polite" data-predictive-search-status></span>
          {%- endif -%}
        </form>
        {%- if predictive -%}
          </predictive-search>
        {%- endif -%}

        <button type="button" class="drawer__close search-drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'icon', name: 'close', size: 22 -%}
        </button>
      </div>

      {%- if has_popular -%}
        <div class="search-drawer__popular" data-search-popular>
          <p class="eyebrow eyebrow--ink">{{ 'search.popular' | t }}</p>
          <ul class="search-drawer__popular-list" role="list">
            {%- if section.settings.popular_1_label != blank and section.settings.popular_1_url != blank -%}
              <li><a href="{{ section.settings.popular_1_url }}" class="chip">{{ section.settings.popular_1_label | escape }}</a></li>
            {%- endif -%}
            {%- if section.settings.popular_2_label != blank and section.settings.popular_2_url != blank -%}
              <li><a href="{{ section.settings.popular_2_url }}" class="chip">{{ section.settings.popular_2_label | escape }}</a></li>
            {%- endif -%}
            {%- if section.settings.popular_3_label != blank and section.settings.popular_3_url != blank -%}
              <li><a href="{{ section.settings.popular_3_url }}" class="chip">{{ section.settings.popular_3_label | escape }}</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</search-drawer>
