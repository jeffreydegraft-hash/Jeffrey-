{%- comment -%}
  Collection card: a flat rounded tile with the collection image and a
  centred title and product count. The title link covers the whole tile.
  Accepts:
  - collection: {Object} collection (optional; renders a placeholder card when blank)
  - index: {Number} position in the grid, used for the reveal stagger (optional)
  - sizes: {String} sizes attribute for the image (optional)
  - placeholder: {String} placeholder_svg_tag name used when there is no image, default 'collection-1'
  - reveal: {Boolean} add data-reveal, default true
  Usage: {% render 'card-collection', collection: collection, index: forloop.index0, sizes: '(min-width: 990px) 33vw, 50vw' %}
{%- endcomment -%}
{%- liquid
  assign stagger = index | default: 0 | modulo: 8
  assign sizes = sizes | default: '(min-width: 990px) 33vw, 50vw'
  assign placeholder = placeholder | default: 'collection-1'
-%}
{%- if collection != blank -%}
  {%- liquid
    assign card_image = collection.featured_image
    assign image_alt = card_image.alt | default: collection.title
  -%}
  <article class="card card--collection" {% if reveal != false %}data-reveal style="--i: {{ stagger }}"{% endif %}>
    <a href="{{ collection.url }}" class="card__media-link" aria-label="{{ collection.title | escape }}" tabindex="-1">
      <div class="card__media media">
        {%- if card_image -%}
          {%- render 'image', image: card_image, sizes: sizes, loading: 'lazy', class: 'card__img card__img--primary', widths: '300, 400, 500, 600, 800, 1000', alt: image_alt -%}
        {%- else -%}
          {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </a>
    <div class="card__body">
      <h3 class="card__title card-collection__title h5">
        <a href="{{ collection.url }}" class="card__link">{{ collection.title | escape }}</a>
      </h3>
      <p class="card-collection__count tnum">{{ 'products.facets.product_count_simple' | t: count: collection.all_products_count }}</p>
    </div>
  </article>
{%- else -%}
  <article class="card card--collection card--placeholder" {% if reveal != false %}data-reveal style="--i: {{ stagger }}"{% endif %}>
    <div class="card__media media">
      {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    <div class="card__body">
      <h3 class="card__title card-collection__title h5">{{ 'collections.list.title' | t }}</h3>
      <p class="card-collection__count tnum">{{ 'products.facets.product_count_simple' | t: count: 0 }}</p>
    </div>
  </article>
{%- endif -%}
