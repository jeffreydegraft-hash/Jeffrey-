{%- liquid
  assign heading_font = settings.font_heading
  assign body_font = settings.font_body
  assign heading_italic = heading_font | font_modify: 'style', 'italic'
  assign body_bold = body_font | font_modify: 'weight', 'bold'
  assign body_medium = body_font | font_modify: 'weight', '500'
  assign scripture_font = settings.font_scripture | default: heading_font
  assign scripture_italic = scripture_font | font_modify: 'style', 'italic' | default: scripture_font
-%}
<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_italic | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_medium | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}
  {{ scripture_italic | font_face: font_display: 'swap' }}
  :root {
    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-scripture: {{ scripture_italic.family }}, {{ scripture_italic.fallback_families }};
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --color-bg: {{ settings.color_background }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-muted: {{ settings.color_muted }};
    --color-border: {{ settings.color_border }};
    --color-primary: {{ settings.color_primary }};
    --color-primary-text: {{ settings.color_primary_text }};
    --color-accent: {{ settings.color_accent }};
    --color-highlight: {{ settings.color_highlight }};
    --color-dark: {{ settings.color_dark }};
    --color-dark-text: {{ settings.color_dark_text }};
    --page-width: {{ settings.page_width }}px;
    --section-space: {{ settings.section_spacing }}px;
    --radius: {{ settings.radius }}px;
    --btn-radius: {{ settings.button_radius }}px;
    --gutter: clamp(1rem, 4vw, 2.5rem);
    {%- case settings.card_ratio -%}
      {%- when 'square' -%}--card-ratio: 1 / 1;
      {%- when 'natural' -%}--card-ratio: auto;
      {%- else -%}--card-ratio: 4 / 5;
    {%- endcase -%}
  }
</style>
