{%- comment -%}
  Social icon list. Renders only the networks whose Theme settings → Social
  media link is filled in. Renders nothing at all when no link is set.
  Accepts:
  - class: {String} extra classes for the <ul> (optional)
  Usage: {% render 'social-icons', class: 'footer__social' %}
{%- endcomment -%}
{%- liquid
  assign networks = 'instagram,facebook,tiktok,youtube,pinterest,x' | split: ','
  assign has_social = false
  for network in networks
    assign setting_key = 'social_' | append: network | append: '_link'
    if settings[setting_key] != blank
      assign has_social = true
    endif
  endfor
-%}
{%- if has_social -%}
  <ul class="social{% if class != blank %} {{ class }}{% endif %}" role="list" aria-label="{{ 'general.social.label' | t: shop: shop.name | escape }}">
    {%- for network in networks -%}
      {%- liquid
        assign setting_key = 'social_' | append: network | append: '_link'
        assign label_key = 'general.social.links.' | append: network
      -%}
      {%- if settings[setting_key] != blank -%}
        <li>
          <a
            href="{{ settings[setting_key] | escape }}"
            class="social__link"
            target="_blank"
            rel="noopener"
            aria-label="{{ label_key | t }}"
            aria-describedby="a11y-new-window-message"
          >
            {%- render 'icon', name: network, size: 20 -%}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
