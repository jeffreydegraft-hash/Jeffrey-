{%- if paginate.pages > 1 -%}
<nav aria-label="Pagination">
  <ul class="pagination">
    {%- if paginate.previous -%}<li><a href="{{ paginate.previous.url }}" aria-label="Previous page">&lsaquo;</a></li>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <li><a href="{{ part.url }}">{{ part.title }}</a></li>
      {%- elsif part.title == paginate.current_page -%}
        <li><span class="is-current" aria-current="page">{{ part.title }}</span></li>
      {%- else -%}
        <li><span>{{ part.title }}</span></li>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<li><a href="{{ paginate.next.url }}" aria-label="Next page">&rsaquo;</a></li>{%- endif -%}
  </ul>
</nav>
{%- endif -%}
