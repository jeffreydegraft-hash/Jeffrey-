{%- comment -%}
  Mobile navigation: a full-screen, opaque overlay that opens from under the
  bar (also used ≥ 990px when the links do not fit the bar on one line).
  Accepts:
  - menu: {Object} linklist (required)
  - color_scheme: {String} the header's colour scheme (optional)
  - contact_url: {String} contact link for the foot of the menu (optional;
    falls back to the store email)
  Contract: <menu-drawer id="MenuDrawer" data-drawer> from theme.js. The panel
  moves on the Drawer base spring (--sheet-closed: translateY(-12px), set in
  section-header.css) and fades; links stagger in 40ms apart. The bar's menu
  button morphs to × and closes it; an in-panel close button serves keyboard
  and screen-reader users (it shows on focus). Submenus are panels that slide
  in from the right: data-submenu-open / data-submenu / data-submenu-back.
{%- endcomment -%}
{%- liquid
  assign account_url = routes.account_login_url
  if customer
    assign account_url = routes.account_url
  endif

  assign contact_href = contact_url
  if contact_href == blank and settings.brand_email != blank
    assign contact_href = 'mailto:' | append: settings.brand_email
  endif

  assign link_count = 0
  if menu != blank
    assign link_count = menu.links.size
  endif

  # The foot repeats Contact only when the menu itself does not already link there
  if contact_href != blank and link_count > 0
    for link in menu.links
      if link.url == contact_href
        assign contact_href = ''
        break
      endif
    endfor
  endif
-%}
<menu-drawer id="MenuDrawer" data-drawer class="menu-drawer" aria-hidden="true" inert>
  <div class="drawer__backdrop menu-drawer__backdrop" data-drawer-backdrop></div>
  <div
    class="drawer__panel menu-drawer__panel{% if color_scheme != blank %} color-{{ color_scheme }}{% endif %}"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'header.menu' | t }}"
  >
    <button type="button" class="drawer__close menu-drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'icon', name: 'close', size: 16 -%}
    </button>

    <div class="menu-drawer__main">
      <nav class="menu-drawer__nav" aria-label="{{ 'accessibility.menu' | t }}">
        {%- if link_count > 0 -%}
          <ul class="menu-drawer__list" role="list">
            {%- for link in menu.links -%}
              <li class="menu-drawer__item" style="--i: {{ forloop.index0 }};">
                {%- if link.links != blank -%}
                  <button
                    type="button"
                    class="menu-drawer__link menu-drawer__link--button{% if link.child_active %} is-current{% endif %}"
                    data-submenu-open="#Submenu-{{ forloop.index }}"
                    aria-controls="Submenu-{{ forloop.index }}"
                    aria-expanded="false"
                  >
                    <span class="menu-drawer__link-text">{{ link.title | escape }}</span>
                    {%- render 'icon', name: 'chevron-right', size: 18 -%}
                  </button>
                {%- else -%}
                  <a
                    href="{{ link.url }}"
                    class="menu-drawer__link{% if link.current %} is-current{% endif %}"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    <span class="menu-drawer__link-text">{{ link.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="empty-state menu-drawer__empty">
            <p class="small muted">{{ 'header.menu_empty' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--secondary btn--sm">{{ 'general.shop_now' | t }}</a>
          </div>
        {%- endif -%}
      </nav>

      {%- if shop.customer_accounts_enabled or contact_href != blank -%}
        <ul class="menu-drawer__footer" role="list" style="--i: {{ link_count }};">
          {%- if shop.customer_accounts_enabled -%}
            <li>
              <a href="{{ account_url }}" class="menu-drawer__footer-link">
                {%- render 'icon', name: 'user', size: 18 -%}
                <span>
                  {%- if customer -%}
                    {{ 'header.account' | t }}
                  {%- else -%}
                    {{ 'header.log_in' | t }}
                  {%- endif -%}
                </span>
              </a>
            </li>
          {%- endif -%}
          {%- if contact_href != blank -%}
            <li>
              <a href="{{ contact_href }}" class="menu-drawer__footer-link">
                {%- render 'icon', name: 'mail', size: 18 -%}
                <span>{{ 'footer.contact_heading' | t }}</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Submenu panels: siblings of the main list so they can cover the whole overlay. {%- endcomment -%}
    {%- if link_count > 0 -%}
      {%- for link in menu.links -%}
        {%- if link.links != blank -%}
          {%- liquid
            assign parent_listed = false
            for childlink in link.links
              if childlink.url == link.url
                assign parent_listed = true
              endif
            endfor
          -%}
          <div id="Submenu-{{ forloop.index }}" class="menu-drawer__submenu" data-submenu inert>
            <div class="menu-drawer__submenu-inner">
              <button type="button" class="menu-drawer__back" data-submenu-back>
                {%- render 'icon', name: 'chevron-left', size: 20 -%}
                <span>{{ 'general.back' | t }}</span>
              </button>
              <h2 class="menu-drawer__submenu-heading">{{ link.title | escape }}</h2>
              <ul class="menu-drawer__sublist" role="list">
                {%- for childlink in link.links -%}
                  <li style="--i: {{ forloop.index0 }};">
                    <a
                      href="{{ childlink.url }}"
                      class="menu-drawer__sublink{% if childlink.current %} is-current{% endif %}"
                      {% if childlink.current %}aria-current="page"{% endif %}
                    >{{ childlink.title | escape }}</a>
                    {%- if childlink.links != blank -%}
                      <ul class="menu-drawer__sublist menu-drawer__sublist--nested" role="list">
                        {%- for grandchildlink in childlink.links -%}
                          <li>
                            <a
                              href="{{ grandchildlink.url }}"
                              class="menu-drawer__sublink menu-drawer__sublink--nested{% if grandchildlink.current %} is-current{% endif %}"
                              {% if grandchildlink.current %}aria-current="page"{% endif %}
                            >{{ grandchildlink.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
              {%- if parent_listed == false and link.url != blank and link.url != '#' -%}
                <a
                  href="{{ link.url }}"
                  class="link link--chevron menu-drawer__view-all{% if link.current %} is-current{% endif %}"
                  style="--i: {{ link.links.size }};"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  <span>{{ 'header.submenu_view_all' | t: title: link.title }}</span>
                  {%- render 'icon', name: 'chevron-right', size: 10 -%}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</menu-drawer>
