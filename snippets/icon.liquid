{%- comment -%}
  Inline SVG icon. Stroke-based, 1.5px, inherits currentColor.
  Usage: {% render 'icon', name: 'cart', size: 20, class: 'extra' %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 20
  assign class = class | default: ''
-%}
<svg class="icon icon--{{ name }} {{ class }}" style="--icon-size: {{ size }}px" viewBox="0 0 24 24" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {%- case name -%}
    {%- when 'cart' or 'bag' -%}
      <path d="M6 8h12l1 12H5L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.3-4.3"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16"/><path d="m13 5 7 7-7 7"/>
    {%- when 'arrow-left' -%}
      <path d="M20 12H4"/><path d="m11 5-7 7 7 7"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17 17 7"/><path d="M8 7h9v9"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="m5 12 4.5 4.5L19 7"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'leaf' -%}
      <path d="M4 20c0-9 5-15 16-16-1 11-7 16-16 16Z"/><path d="M4 20c4-5 8-8 12-11"/>
    {%- when 'drop' -%}
      <path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/>
    {%- when 'flask' -%}
      <path d="M9 3h6"/><path d="M10 3v6l-5.2 9A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7.5 15h9"/>
    {%- when 'olive' -%}
      <ellipse cx="12" cy="13" rx="6" ry="7.5"/><path d="M12 5.5V3"/><path d="M12 3c2 0 3.5-.8 4.5-2"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
    {%- when 'phone' -%}
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/>
    {%- when 'shield' -%}
      <path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m12 7 1.6 3.4L17 12l-3.4 1.6L12 17l-1.6-3.4L7 12l3.4-1.6L12 7Z"/>
    {%- when 'star' -%}
      <path d="m12 3 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.4l-5.7 3.1 1.2-6.4L2.8 9.7l6.4-.8L12 3Z"/>
    {%- when 'info' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
    {%- when 'error' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>
    {%- when 'success' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 5-5"/>
    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'external' -%}
      <path d="M14 4h6v6"/><path d="m20 4-9 9"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>
    {%- when 'share' -%}
      <path d="M12 3v12"/><path d="m8 7 4-4 4 4"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/>
    {%- when 'quote' -%}
      <path d="M8 6c-2.5 1-4 3-4 6v6h6v-6H7c0-2 1-3 3-4V6Zm10 0c-2.5 1-4 3-4 6v6h6v-6h-3c0-2 1-3 3-4V6Z"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/>
    {%- when 'calendar' -%}
      <rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'zoom' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.3-4.3M11 8v6M8 11h6"/>
    {%- when 'play' -%}
      <path d="M8 5v14l11-7L8 5Z"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><path d="M17.3 6.7h.01"/>
    {%- when 'facebook' -%}
      <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5A.5.5 0 0 1 14 8Z"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 2.8 2.3 4.6 5 5"/>
    {%- when 'youtube' -%}
      <path d="M3.5 8.5c.2-1.4 1.1-2.3 2.5-2.5C8 5.8 10 5.7 12 5.7s4 .1 6 .3c1.4.2 2.3 1.1 2.5 2.5.2 1.2.3 2.3.3 3.5s-.1 2.3-.3 3.5c-.2 1.4-1.1 2.3-2.5 2.5-2 .2-4 .3-6 .3s-4-.1-6-.3c-1.4-.2-2.3-1.1-2.5-2.5C3.3 14.3 3.2 13.2 3.2 12s.1-2.3.3-3.5Z"/><path d="m10 9 5 3-5 3V9Z"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9"/><path d="M9.5 20.5c.5-2 1-4.5 1.5-6.5-.5-.7-.7-1.8-.3-2.8.5-1.1 1.9-1.5 2.6-.6.8 1-.3 2.7-.3 3.9 0 .8.7 1.3 1.5 1.3 2 0 3-2.3 3-4.5 0-2.4-1.8-4-4.3-4-2.9 0-4.7 2-4.7 4.4 0 1 .3 1.6.8 2.2"/>
    {%- when 'x' -%}
      <path d="m4 4 16 16M20 4 4 20"/>
    {%- when 'spinner' -%}
      <path d="M12 3a9 9 0 1 0 9 9"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
