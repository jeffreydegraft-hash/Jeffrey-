{%- comment -%}
  Article tile (Apple Newsroom): the image across the top of a flat,
  rounded --c-surface tile (radius --r-tile), then a .tag (first tag,
  else the blog title), an .h4 title (three lines at most) and a 14px
  muted date pinned to the tile's bottom so a row of tiles lines up. The
  title link's ::after covers the whole tile (.card__link, components.css).
  Featured: the "top story" — at ≥750px the image takes the left 56% of a
  full-row tile and the text sits beside it with an .h3 title.
  Accepts:
  - article: {Object} article (required)
  - index: {Number} position in the grid, for the reveal stagger (optional)
  - show_date: {Boolean} show the published date
  - show_author: {Boolean} show the author
  - show_excerpt: {Boolean} show a short excerpt (main-blog passes it for the top story only)
  - featured: {Boolean} top-story layout
  A post without an image becomes a text-only tile (no drawn placeholder,
  APPLE-SPEC §0.2) with a larger title. Motion: tile press (scale .985), a 3% image zoom on a real
  pointer's hover (components.css .card), scroll reveal.
  Usage: {% render 'card-article', article: article, index: forloop.index0, show_date: true %}
{%- endcomment -%}
{%- liquid
  assign stagger = index | default: 0 | modulo: 8

  assign tag = article.tags | first
  if tag == blank
    assign blog_handle = article.url | split: '/blogs/' | last | split: '/' | first
    assign tag = blogs[blog_handle].title
  endif

  if featured
    assign sizes = '(min-width: 1260px) 700px, (min-width: 750px) 58vw, 100vw'
    assign title_class = 'h3'
  else
    assign sizes = '(min-width: 1260px) 400px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
    assign title_class = 'h4'
  endif

  assign show_meta = false
  if show_date or show_author and article.author != blank
    assign show_meta = true
  endif
-%}
<article class="card card--article card-article{% if featured %} card-article--featured{% endif %}{% unless article.image %} card-article--text{% endunless %}" data-reveal style="--i: {{ stagger }};">
  {%- if article.image -%}
    <div class="card__media media card-article__media">
      {%- render 'image', image: article.image, sizes: sizes, loading: 'lazy', class: 'card__img card__img--primary', widths: '400, 600, 800, 1000, 1200, 1600' -%}
    </div>
  {%- endif -%}
  <div class="card-article__body">
    {%- if tag != blank -%}
      <p class="tag card-article__tag">{{ tag | escape }}</p>
    {%- endif -%}
    <h3 class="{{ title_class }} card-article__title">
      <a href="{{ article.url }}" class="card__link">{{ article.title | escape }}</a>
    </h3>
    {%- if show_excerpt -%}
      {%- assign excerpt = article.excerpt_or_content | replace: '</', ' </' | strip_html | strip_newlines | truncatewords: 30 -%}
      {%- if excerpt != blank -%}
        <p class="card-article__excerpt">{{ excerpt }}</p>
      {%- endif -%}
    {%- endif -%}
    {%- if show_meta -%}
      <p class="small card-article__meta">
        {%- if show_date -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
        {%- endif -%}
        {%- if show_author and article.author != blank -%}
          <span>{{ 'blogs.article.by' | t: author: article.author }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</article>
