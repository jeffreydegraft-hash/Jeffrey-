{%- comment -%}
  Address fields shared by the "add" and "edit" forms on the addresses page.
  Render inside {% form 'customer_address' %}.
  Accepts:
  - form: {Object} the customer_address form object (required)
  - suffix: {String} unique id suffix for this form: 'New' or '_<address id>'
  Field ids follow AddressForm<suffix>-<field>, which is also the anchor the
  error summary links to. customer.js wires the country → province selects
  through Shopify.CountryProvinceSelector using data-suffix.
{%- endcomment -%}
{%- liquid
  assign prefix = 'AddressForm' | append: suffix
-%}
<div class="customer-form__row customer-form__row--names">
  <div class="field">
    <label class="field__label" for="{{ prefix }}-first_name">{{ 'customer.addresses.first_name' | t }}</label>
    <input
      class="field__input"
      type="text"
      id="{{ prefix }}-first_name"
      name="address[first_name]"
      value="{{ form.first_name | escape }}"
      autocomplete="given-name"
      {% if form.errors contains 'first_name' %}aria-invalid="true"{% endif %}
    >
  </div>
  <div class="field">
    <label class="field__label" for="{{ prefix }}-last_name">{{ 'customer.addresses.last_name' | t }}</label>
    <input
      class="field__input"
      type="text"
      id="{{ prefix }}-last_name"
      name="address[last_name]"
      value="{{ form.last_name | escape }}"
      autocomplete="family-name"
      {% if form.errors contains 'last_name' %}aria-invalid="true"{% endif %}
    >
  </div>
</div>

<div class="field">
  <label class="field__label" for="{{ prefix }}-company">
    {{ 'customer.addresses.company' | t }}
    <span class="optional">({{ 'general.optional' | t }})</span>
  </label>
  <input
    class="field__input"
    type="text"
    id="{{ prefix }}-company"
    name="address[company]"
    value="{{ form.company | escape }}"
    autocomplete="organization"
  >
</div>

<div class="field">
  <label class="field__label" for="{{ prefix }}-address1">{{ 'customer.addresses.address1' | t }}</label>
  <input
    class="field__input"
    type="text"
    id="{{ prefix }}-address1"
    name="address[address1]"
    value="{{ form.address1 | escape }}"
    autocomplete="address-line1"
    {% if form.errors contains 'address1' %}aria-invalid="true"{% endif %}
  >
</div>

<div class="field">
  <label class="field__label" for="{{ prefix }}-address2">
    {{ 'customer.addresses.address2' | t }}
    <span class="optional">({{ 'general.optional' | t }})</span>
  </label>
  <input
    class="field__input"
    type="text"
    id="{{ prefix }}-address2"
    name="address[address2]"
    value="{{ form.address2 | escape }}"
    autocomplete="address-line2"
  >
</div>

<div class="field">
  <label class="field__label" for="{{ prefix }}-city">{{ 'customer.addresses.city' | t }}</label>
  <input
    class="field__input"
    type="text"
    id="{{ prefix }}-city"
    name="address[city]"
    value="{{ form.city | escape }}"
    autocomplete="address-level2"
    {% if form.errors contains 'city' %}aria-invalid="true"{% endif %}
  >
</div>

<div class="customer-form__row">
  <div class="field">
    <label class="field__label" for="{{ prefix }}-country">{{ 'customer.addresses.country' | t }}</label>
    <div class="select">
      <select
        class="field__select"
        id="{{ prefix }}-country"
        name="address[country]"
        data-default="{{ form.country | escape }}"
        data-address-country-select
        data-suffix="{{ suffix }}"
        autocomplete="country"
        {% if form.errors contains 'country' %}aria-invalid="true"{% endif %}
      >
        {{ all_country_option_tags }}
      </select>
      {%- render 'icon', name: 'chevron-down', size: 18 -%}
    </div>
  </div>
  <div class="field" id="{{ prefix }}-province-container" style="display: none;">
    <label class="field__label" for="{{ prefix }}-province">{{ 'customer.addresses.province' | t }}</label>
    <div class="select">
      <select
        class="field__select"
        id="{{ prefix }}-province"
        name="address[province]"
        data-default="{{ form.province | escape }}"
        autocomplete="address-level1"
        {% if form.errors contains 'province' %}aria-invalid="true"{% endif %}
      ></select>
      {%- render 'icon', name: 'chevron-down', size: 18 -%}
    </div>
  </div>
</div>

<div class="customer-form__row">
  <div class="field">
    <label class="field__label" for="{{ prefix }}-zip">{{ 'customer.addresses.zip' | t }}</label>
    <input
      class="field__input"
      type="text"
      id="{{ prefix }}-zip"
      name="address[zip]"
      value="{{ form.zip | escape }}"
      autocapitalize="characters"
      autocomplete="postal-code"
      {% if form.errors contains 'zip' %}aria-invalid="true"{% endif %}
    >
  </div>
  <div class="field">
    <label class="field__label" for="{{ prefix }}-phone">
      {{ 'customer.addresses.phone' | t }}
      <span class="optional">({{ 'general.optional' | t }})</span>
    </label>
    <input
      class="field__input"
      type="tel"
      id="{{ prefix }}-phone"
      name="address[phone]"
      value="{{ form.phone | escape }}"
      autocomplete="tel"
      inputmode="tel"
      {% if form.errors contains 'phone' %}aria-invalid="true"{% endif %}
    >
  </div>
</div>

{%- if form.set_as_default_checkbox != blank -%}
  <label class="checkbox customer-form__checkbox">
    {{ form.set_as_default_checkbox }}
    <span>{{ 'customer.addresses.set_default' | t }}</span>
  </label>
{%- endif -%}
