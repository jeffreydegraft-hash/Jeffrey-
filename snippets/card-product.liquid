{%- comment -%}
  Product card (APPLE-SPEC §3 product tile): tag line, title, price, then the
  photo below the text, then a CTA row ("Buy" pill + "Learn more ›").
  Accepts:
  - product: {Object} product (optional; renders a placeholder card when blank)
  - index: {Number} position in the grid (optional, unused: theme.js sets the reveal stagger --i per batch)
  - sizes: {String} sizes attribute for the image (optional)
  - show_secondary_image: {Boolean} default from settings
  - show_vendor: {Boolean} default from settings
  - lazy: {Boolean} lazy-load the image, default true
  - reveal: {Boolean} add data-reveal, default true
  Usage: {% render 'card-product', product: product, index: forloop.index0, sizes: '(min-width: 990px) 25vw, 50vw' %}

  Tag line: "Sale" (accent detail) or "Sold out" (muted) sits in the .tag
  position before the theme word, never as a pill over the photo.
  Buy: a product with nothing to choose (only the default variant) adds
  straight to the bag through the <product-form> contract (assets/cart.js:
  {% form 'product' %}, name="id", a submit button whose first plain label
  span swaps to "Added", .product-form__error). A product with options links
  to its page, where the size is chosen. Sold out: no pill, "Learn more" only.
  The photo is the merchant's own media, whole (object-fit: contain) on the
  white it was shot on; nothing is drawn, blended or filtered. A product with
  no media is a text-only tile (.card--text) on the live store; only the
  editor shows Shopify's neutral placeholder (APPLE-SPEC §0.2).
{%- endcomment -%}
{%- liquid
  if show_secondary_image == nil
    assign show_secondary_image = settings.card_show_secondary_image
  endif
  if show_vendor == nil
    assign show_vendor = settings.card_show_vendor
  endif
  if lazy == nil
    assign lazy = true
  endif
  if lazy
    assign loading = 'lazy'
  else
    assign loading = 'eager'
  endif
  assign sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign theme_word = blank
  if settings.card_show_theme_word and product != blank
    assign theme_word = product.metafields.custom.theme_word.value
  endif
-%}
{%- if settings.card_show_theme_word and product != blank and theme_word == blank -%}
  {%- comment -%} Built-in theme word for launch products, then the product type {%- endcomment -%}
  {%- capture theme_word -%}{%- render 'product-defaults', product: product, field: 'theme_word' -%}{%- endcapture -%}
  {%- assign theme_word = theme_word | strip | default: product.type -%}
{%- endif -%}

{%- if product != blank -%}
  {%- liquid
    assign status = blank
    if product.available == false
      assign status = 'sold-out'
    elsif product.compare_at_price > product.price
      assign status = 'sale'
    endif
    assign eyebrow = blank
    if theme_word != blank
      assign eyebrow = theme_word
    elsif show_vendor and product.vendor != blank
      assign eyebrow = product.vendor
    endif
    assign variant = product.selected_or_first_available_variant
    assign form_id = 'CardProductForm-' | append: product.id | append: '-' | append: index
    assign show_media = true
    if product.featured_media == blank and request.design_mode == false
      assign show_media = false
    endif
  -%}
  <article class="card card--product{% unless show_media %} card--text{% endunless %}" {% if reveal != false %}data-reveal{% endif %}>
    <div class="card__body">
      {%- if status != blank or eyebrow != blank -%}
        <p class="card__tags">
          {%- if status == 'sold-out' -%}
            <span class="card__tag card__tag--sold-out">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif status == 'sale' -%}
            <span class="card__tag card__tag--sale">{{ 'products.product.on_sale' | t }}</span>
          {%- endif -%}
          {%- if eyebrow != blank -%}
            <span class="card__eyebrow">{{ eyebrow | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
      <h3 class="card__title h5">
        <a href="{{ product.url }}" class="card__link">{{ product.title | escape }}</a>
      </h3>
      {%- render 'price', product: product, price_class: 'price--card' -%}
    </div>
    {%- if show_media -%}
      <a href="{{ product.url }}" class="card__media-link" aria-label="{{ product.title | escape }}" tabindex="-1">
        <div class="card__media media" style="--ratio: {{ settings.card_image_ratio }};">
          {%- if product.featured_media -%}
            {%- render 'image', image: product.featured_media, sizes: sizes, loading: loading, class: 'card__img card__img--primary', widths: '300, 400, 500, 600, 800, 1000' -%}
            {%- if show_secondary_image and product.media.size > 1 -%}
              {%- assign second = product.media[1] -%}
              {%- render 'image', image: second, sizes: sizes, loading: 'lazy', class: 'card__img card__img--secondary', widths: '300, 400, 500, 600, 800, 1000' -%}
            {%- endif -%}
          {%- elsif request.design_mode -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </a>
    {%- endif -%}
    <div class="card__actions">
      {%- if product.available -%}
        {%- if product.has_only_default_variant -%}
          <product-form class="product-form card__form">
            <p class="product-form__error form-status form-status--error" role="alert" hidden></p>
            {%- form 'product', product, id: form_id, class: 'card__buy-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button
                type="submit"
                name="add"
                class="btn btn--primary btn--sm card__buy"
                {% if settings.cart_type == 'drawer' %}aria-haspopup="dialog"{% endif %}
              >
                <span class="btn__content"><span data-add-label>{{ 'sections.featured_product.buy' | t }}</span><span class="visually-hidden"> {{ product.title | escape }}</span></span>
                {%- render 'loading-spinner' -%}
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <a href="{{ product.url }}" class="btn btn--primary btn--sm card__buy">
            {{- 'sections.featured_product.buy' | t -}}
            <span class="visually-hidden"> {{ product.title | escape }}</span></a>
        {%- endif -%}
      {%- endif -%}
      <a href="{{ product.url }}" class="link link--chevron card__more">
        {{- 'general.learn_more' | t -}}
        <span class="visually-hidden">: {{ product.title | escape }}</span>
        {%- render 'icon', name: 'chevron-right', size: 12 -%}
      </a>
    </div>
  </article>
{%- else -%}
  <article class="card card--product card--placeholder" {% if reveal != false %}data-reveal{% endif %}>
    <div class="card__body">
      <p class="card__tags"><span class="card__eyebrow">Restore</span></p>
      <h3 class="card__title h5">Example product title</h3>
      <div class="price"><div class="price__container"><div class="price__regular"><span class="price__item price__item--regular money">{{ 1998 | money }}</span></div></div></div>
    </div>
    <div class="card__media media" style="--ratio: {{ settings.card_image_ratio }};">
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    <div class="card__actions" aria-hidden="true">
      <span class="btn btn--primary btn--sm card__buy">{{ 'sections.featured_product.buy' | t }}</span>
      <span class="link link--chevron card__more">
        {{- 'general.learn_more' | t -}}
        {%- render 'icon', name: 'chevron-right', size: 12 -%}
      </span>
    </div>
  </article>
{%- endif -%}
