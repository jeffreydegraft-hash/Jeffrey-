{%- comment -%}
  Variant picker: one fieldset per product option, each value a large
  selectable card (Apple Store style): the value name on the left, the
  price of the variant it leads to on the right. The radios stay real
  inputs (visually hidden) so keyboard, form posting and no-JS all work.

  product.js (<variant-picker>) listens for changes, finds the matching
  variant in the embedded [data-variants] JSON, updates the form, URL,
  price, button state and gallery, keeps every card's price and
  availability in step with the other selections, and publishes
  Olivet.EVENTS.variantChanged.

  Accepts:
  - product: {Object} product
  - product_form_id: {String} id of the product form the inputs belong to (their form attribute)
  Usage: {% render 'product-variant-picker', product: product, product_form_id: product_form_id %}
{%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  <variant-picker
    class="variant-picker"
    id="VariantPicker-{{ section.id }}"
    data-section="{{ section.id }}"
    data-url="{{ product.url }}"
    data-update-url="true"
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_index = forloop.index0
        assign option_name = option.name | escape
      -%}
      <fieldset class="variant-picker__group" data-option-index="{{ option_index }}">
        <legend class="variant-picker__legend">
          <span class="variant-picker__name">{{ option_name }}</span>
          <span class="visually-hidden">: <span class="variant-picker__value" data-selected-value>{{ option.selected_value }}</span></span>
        </legend>
        <div class="variant-picker__options{% if option.values.size > 4 %} variant-picker__options--grid{% endif %}">
          {%- for value in option.values -%}
            {%- liquid
              assign input_id = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
              assign value_name = value | escape
            -%}
            <input
              type="radio"
              class="visually-hidden variant-picker__input"
              id="{{ input_id }}"
              name="options[{{ option_name }}]"
              value="{{ value_name }}"
              form="{{ product_form_id }}"
              data-option-position="{{ option.position }}"
              {% if value.selected %}checked{% endif %}
            >
            <label
              class="variant-picker__pill variant-card{% if value.selected %} is-selected{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
              for="{{ input_id }}"
            >
              <span class="variant-card__name">{{ value_name }}</span>
              <span class="variant-card__price money" data-option-price {% if value.variant == blank %}hidden{% endif %}>
                {%- if value.variant != blank -%}
                  {%- if settings.currency_code_enabled -%}
                    {{ value.variant.price | money_with_currency }}
                  {%- else -%}
                    {{ value.variant.price | money }}
                  {%- endif -%}
                {%- endif -%}
              </span>
              <span class="visually-hidden" data-option-unavailable {% if value.available %}hidden{% endif %}>
                {{- 'products.product.value_unavailable' | t: option_value: value_name -}}
              </span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
    <script type="application/json" data-variants>
      {{ product.variants | json }}
    </script>
  </variant-picker>
{%- endunless -%}
