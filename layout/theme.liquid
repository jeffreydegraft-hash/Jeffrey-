<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
    {%- liquid
      assign scheme_light = settings.color_schemes | first
      assign theme_color = scheme_light.settings.background
    -%}
    <meta name="theme-color" content="{{ theme_color }}">
    <meta name="color-scheme" content="light">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- render 'brand-icons' -%}

    {%- unless settings.use_system_font or settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title -}}
      {%- if current_tags %}{% assign tag_list = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: tag_list }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      assign heading_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
    -%}

    {%- unless settings.use_system_font or settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}
    {%- unless settings.use_system_font or settings.type_header_font.system? -%}
      {{ settings.type_header_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {% style %}
      {%- unless settings.use_system_font %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ heading_font_italic | font_face: font_display: 'swap' }}
      {%- endunless %}

      {%- for scheme in settings.color_schemes -%}
        {%- if forloop.first %}:root,{% endif %}
        .color-{{ scheme.id }} {
          --c-bg: {{ scheme.settings.background.red }}, {{ scheme.settings.background.green }}, {{ scheme.settings.background.blue }};
          {%- if scheme.settings.background_gradient != empty %}
          --c-bg-gradient: {{ scheme.settings.background_gradient }};
          {%- else %}
          --c-bg-gradient: none;
          {%- endif %}
          --c-surface: {{ scheme.settings.surface.red }}, {{ scheme.settings.surface.green }}, {{ scheme.settings.surface.blue }};
          --c-ink: {{ scheme.settings.text.red }}, {{ scheme.settings.text.green }}, {{ scheme.settings.text.blue }};
          --c-ink-2: {{ scheme.settings.text_muted.red }}, {{ scheme.settings.text_muted.green }}, {{ scheme.settings.text_muted.blue }};
          --c-line: {{ scheme.settings.line.red }}, {{ scheme.settings.line.green }}, {{ scheme.settings.line.blue }};
          --c-accent: {{ scheme.settings.accent.red }}, {{ scheme.settings.accent.green }}, {{ scheme.settings.accent.blue }};
          --c-accent-ink: {{ scheme.settings.accent_text.red }}, {{ scheme.settings.accent_text.green }}, {{ scheme.settings.accent_text.blue }};
          --c-gold: {{ scheme.settings.gold.red }}, {{ scheme.settings.gold.green }}, {{ scheme.settings.gold.blue }};
          --c-gold-ink: color-mix(in oklab, rgb(var(--c-gold)) 60%, rgb(var(--c-ink)));
        }
      {%- endfor %}

      :root {
        {%- if settings.use_system_font %}
        --font-heading: var(--font-system);
        --font-heading-weight: 600;
        --font-heading-style: normal;
        --font-body: var(--font-system);
        --font-body-weight: 400;
        --font-body-weight-bold: 600;
        --font-body-style: normal;
        {%- else %}
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 800 }};
        --font-body-style: {{ settings.type_body_font.style }};
        {%- endif %}
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --page-max: {{ settings.page_width }}px;
        --r-btn: {{ settings.button_radius }}px;
        --r-input: {{ settings.input_radius }}px;
        --r-card: {{ settings.card_radius }}px;
        --r-tile: {{ settings.card_radius | plus: 10 }}px;
        --r-media: {{ settings.card_radius }}px;
        --card-ratio: {{ settings.card_image_ratio }};
        {%- case settings.section_spacing %}
          {%- when 'compact' %}
        --section-y: clamp(48px, 7vw, 96px);
          {%- when 'airy' %}
        --section-y: clamp(96px, 12vw, 180px);
          {%- else %}
        --section-y: clamp(72px, 10vw, 140px);
        {%- endcase %}
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'section-header.css' | asset_url | stylesheet_tag }}
    {{ 'section-footer.css' | asset_url | stylesheet_tag }}
    {{ 'section-cart.css' | asset_url | stylesheet_tag }}
    {{ 'section-product.css' | asset_url | stylesheet_tag }}
    {{ 'section-collection.css' | asset_url | stylesheet_tag }}
    {{ 'section-home-a.css' | asset_url | stylesheet_tag }}
    {{ 'section-home-b.css' | asset_url | stylesheet_tag }}
    {{ 'section-pages.css' | asset_url | stylesheet_tag }}
    {{ 'section-customers.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <script>
      window.Olivet = window.Olivet || {};
      window.Olivet.config = {
        routes: {
          root_url: {{ routes.root_url | json }},
          cart_url: {{ routes.cart_url | json }},
          cart_add_url: {{ routes.cart_add_url | json }},
          cart_change_url: {{ routes.cart_change_url | json }},
          cart_update_url: {{ routes.cart_update_url | json }},
          predictive_search_url: {{ routes.predictive_search_url | json }},
          search_url: {{ routes.search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        currencyCodeEnabled: {{ settings.currency_code_enabled | json }},
        cartType: {{ settings.cart_type | json }},
        freeShippingThreshold: {{ settings.cart_free_shipping_threshold | default: 0 | times: 100 }},
        revealOnScroll: {{ settings.reveal_on_scroll | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          quantityError: {{ 'cart.general.quantity_error_html' | t: quantity: '[quantity]' | json }},
          freeShippingAway: {{ 'cart.free_shipping.away_html' | t: amount: '[amount]' | json }},
          freeShippingReached: {{ 'cart.free_shipping.reached' | t | json }},
          searchLoading: {{ 'search.loading' | t | json }},
          searchNoResults: {{ 'search.no_results_short' | t | json }},
          closeDialog: {{ 'accessibility.close' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}

    <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </head>

  <body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ request.page_type | handle }}--{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link btn btn--primary btn--sm" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1" data-template="{{ template.name }}">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.new_window' | t }}</li>
    </ul>
  </body>
</html>
