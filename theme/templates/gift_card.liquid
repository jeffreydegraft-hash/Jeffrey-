{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Gift card – {{ shop.name }}</title>
  <meta name="robots" content="noindex, nofollow">
  {% render 'css-variables' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'vendor/qrcode.js' | shopify_asset_url | script_tag }}
</head>
<body class="template-gift-card">
  <main class="password" style="min-height:100vh">
    <div class="password__box">
      <span class="header__wordmark">{{ shop.name }}</span>
      <p class="eyebrow" style="margin:0">Gift card</p>
      <h1 class="h2" style="margin:0">{{ gift_card.initial_value | money }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p class="form-errors">This gift card is no longer valid.</p>{%- endif -%}
      {%- if gift_card.balance != gift_card.initial_value -%}<p class="muted">Remaining balance: {{ gift_card.balance | money }}</p>{%- endif -%}
      <p style="font-family:monospace;font-size:1.4rem;letter-spacing:.1em;background:#fff;padding:1rem 1.5rem;border:1px dashed var(--color-border);border-radius:var(--radius)">{{ gift_card.code | format_code }}</p>
      <div id="QrCode"></div>
      <p class="muted">Use this code at checkout to redeem your gift card.</p>
      <a class="btn btn--primary" href="{{ shop.url }}">Start shopping</a>
      <button class="btn btn--secondary" onclick="window.print()">Print</button>
    </div>
  </main>
  <script>
    new QRCode(document.getElementById('QrCode'), { text: {{ gift_card.qr_identifier | json }}, width: 120, height: 120 });
  </script>
</body>
</html>
