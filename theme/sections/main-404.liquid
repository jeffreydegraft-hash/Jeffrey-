<section class="section" {{ section.shopify_attributes }}>
  <div class="container not-found">
    <h1>404</h1>
    <p class="h3">{{ section.settings.heading }}</p>
    <p class="lead" style="margin:0 auto 1.5rem">{{ section.settings.text }}</p>
    <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Shop anointing oils</a>
  </div>
</section>
{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has wandered off." },
    { "type": "text", "id": "text", "label": "Text", "default": "The page you're looking for doesn't exist, but the oils do. Let us lead you back." }
  ]
}
{% endschema %}
