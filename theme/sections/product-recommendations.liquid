<div class="recommendations" data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}" {{ section.shopify_attributes }}>
  <div data-recommendations-inner>
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <section class="section section--surface">
        <div class="container">
          <div class="section__head">
            <div>
              <p class="eyebrow">{{ section.settings.eyebrow }}</p>
              <h2>{{ section.settings.heading }}</h2>
            </div>
            <a class="link link--arrow" href="{{ routes.all_products_collection_url }}">View all oils</a>
          </div>
          <div class="product-grid product-grid--4">
            {%- for product in recommendations.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pairs well with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Often anointed together" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ]
}
{% endschema %}
