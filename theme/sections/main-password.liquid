<div class="password" {{ section.shopify_attributes }}>
  <div class="password__box">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 400 | image_tag: width: settings.logo_width, alt: shop.name }}
    {%- else -%}
      <span class="header__wordmark">{{ shop.name }}</span>
    {%- endif -%}
    <p class="eyebrow" style="margin:0">{{ section.settings.eyebrow }}</p>
    <h1 class="h2" style="margin:0">{{ section.settings.heading }}</h1>
    <p class="lead" style="margin:0 auto">{{ shop.password_message | default: section.settings.text }}</p>
    {%- form 'customer', id: 'PasswordNewsletter' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" style="width:100%">Thank you. We'll let you know when the doors open.</p>
      {%- else -%}
        {%- if form.errors -%}<p class="form-errors" style="width:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
        <input class="input" type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address">
        <button type="submit" class="btn btn--primary">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <p class="scripture-small" style="font-family:var(--font-heading);font-style:italic;color:var(--color-primary);margin:1rem 0 0">“{{ settings.tagline }}”</p>
    <p class="password__ref">{{ settings.tagline_ref }}</p>
    <details style="margin-top:1rem">
      <summary class="link" style="cursor:pointer">Enter using password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-errors" style="width:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input class="input" type="password" name="password" placeholder="Password" aria-label="Password">
        <button type="submit" class="btn btn--secondary">Enter</button>
      {%- endform -%}
    </details>
  </div>
</div>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The table is being set." },
    { "type": "text", "id": "text", "label": "Text", "default": "Our new store opens soon. Leave your email and be first to know." }
  ]
}
{% endschema %}
