<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="newsletter">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div>{{ section.settings.text }}</div>
      </div>
      <div>
        {%- form 'customer', id: 'NewsletterForm-' | append: section.id -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success">Welcome to the table. Check your inbox for your code.</p>
          {%- else -%}
            {%- if form.errors -%}<p class="form-errors">{{ form.errors | default_errors }}</p>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter__form">
              <input type="email" name="contact[email]" placeholder="Your email address" required aria-label="Email address" autocomplete="email">
              <button type="submit" class="btn btn--gold">{{ section.settings.button_label }}</button>
            </div>
            {%- if section.settings.fine_print != blank -%}<p class="newsletter__fine">{{ section.settings.fine_print }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the table" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Scripture reflections, new blends and member-only offers. No noise, just what fills the cup.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Claim 10% off" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "By subscribing you agree to receive emails from us. Unsubscribe anytime." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
