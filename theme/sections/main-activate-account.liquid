<section class="section" {{ section.shopify_attributes }}>
  <div class="container auth">
    <h1 class="h2">Activate account</h1>
    <p class="muted center">Create your password to activate your account.</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ActivatePassword">Password</label><input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ActivatePasswordConfirm">Confirm password</label><input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary btn--large">Activate account</button>
      <button type="submit" name="decline" class="btn btn--secondary" style="margin-top:.5rem">Decline invitation</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
