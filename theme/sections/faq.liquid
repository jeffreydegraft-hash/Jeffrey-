<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}{% render 'icon', icon: 'plus' %}</summary>
          <div class="faq__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.contact_text != blank -%}
      <p class="center muted" style="margin-top:2rem">{{ section.settings.contact_text }} <a class="link" href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_label }}</a></p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you want to know" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question by default", "default": true },
    { "type": "text", "id": "contact_text", "label": "Contact text", "default": "Still have a question?" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Send us a message" },
    { "type": "url", "id": "contact_link", "label": "Contact link" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [ { "type": "text", "id": "question", "label": "Question", "default": "What is anointing oil used for?" }, { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Throughout Scripture, oil is used to set apart people, places and moments for God: prayer, blessing homes, anointing the sick (James 5:14), and worship. Our oils are made to accompany those moments.</p>" } ] }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What is anointing oil used for?", "answer": "<p>Throughout Scripture, oil is used to set apart people, places and moments for God: prayer, blessing a home, anointing the sick (James 5:14), consecration and worship. Our oils are made to accompany those moments.</p>" } },
        { "type": "qa", "settings": { "question": "What is in your oils?", "answer": "<p>A pure olive oil base and the botanicals named in the Bible — frankincense, myrrh, hyssop, spikenard, pomegranate, rose of Sharon and more. No synthetic fragrance oils, no fillers.</p>" } },
        { "type": "qa", "settings": { "question": "How do I use it?", "answer": "<p>Place a small drop on your fingertip and apply to the forehead, hands, or doorposts as you pray. A little goes a long way. Always patch-test first if you have sensitive skin.</p>" } },
        { "type": "qa", "settings": { "question": "Is the oil blessed or prayed over?", "answer": "<p>Yes. Every batch is prayed over before it is bottled and again before it ships. The power is not in the oil itself but in the faith and the One we pray to.</p>" } },
        { "type": "qa", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders ship within 1–2 business days from Texas. Most U.S. orders arrive in 3–5 business days. Free U.S. shipping on orders over $50.</p>" } },
        { "type": "qa", "settings": { "question": "Can I order for my church or ministry?", "answer": "<p>Absolutely. Our 4 oz bottles are ideal for congregational use, and we offer ministry pricing on bulk orders. Reach out through the contact page.</p>" } }
      ]
    }
  ]
}
{% endschema %}
