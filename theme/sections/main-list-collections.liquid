<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="page-head">
      <p class="eyebrow">Browse</p>
      <h1 class="h2">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="collections-grid">
      {%- for collection in collections -%}
        {%- if collection.handle == 'frontpage' or collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign img = collection.image | default: collection.products.first.featured_image -%}
        <a class="tile" href="{{ collection.url }}">
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', alt: collection.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="tile__body">
            <h2 class="tile__title">{{ collection.title }}</h2>
            <p class="tile__text">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</p>
            <span class="tile__cta">Explore →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" },
    { "type": "text", "id": "text", "label": "Text", "default": "Every oil, by name and by purpose." }
  ]
}
{% endschema %}
