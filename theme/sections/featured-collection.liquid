{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
  assign limit = section.settings.limit
-%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}" id="featured-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | default: collection.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <a class="link link--arrow" href="{{ collection.url | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>
    <div class="product-grid product-grid--{{ section.settings.columns }}">
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'product-card__placeholder' }}</div>
            <div class="product-card__info"><h3 class="product-card__title">Anointing oil</h3><p class="product-card__meta">Add products to this collection</p><div class="product-card__price">$16.98</div></div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Oils for every season of faith" },
    { "type": "text", "id": "text", "label": "Text", "default": "Each blend is named for a passage of Scripture and crafted for a purpose: protection, healing, worship, renewal." },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all oils" },
    { "type": "checkbox", "id": "surface", "label": "Use tinted background", "default": false }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
