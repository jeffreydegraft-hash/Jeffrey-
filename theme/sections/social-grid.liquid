<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.handle != blank -%}
        <a class="link link--arrow" href="{{ section.settings.link | default: settings.social_instagram }}" target="_blank" rel="noopener">{{ section.settings.handle }}</a>
      {%- endif -%}
    </div>
    <div class="social-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{%- else -%}<div {{ block.shopify_attributes }}>{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 16vw, 33vw', alt: block.settings.caption }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<span class="social-grid__caption">{{ block.settings.caption }}</span>{%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Social grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Anointed and shared" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@mycuprunnethover" },
    { "type": "url", "id": "link", "label": "Profile link" }
  ],
  "blocks": [
    { "type": "post", "name": "Post", "settings": [ { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "url", "id": "link", "label": "Link" }, { "type": "text", "id": "caption", "label": "Caption" } ] }
  ],
  "presets": [ { "name": "Social grid", "blocks": [ { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" } ] } ]
}
{% endschema %}
